@model Prosegin.Web.ViewModels.Cotizaciones.CotizacionBandejaViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Cotizaciones";
    var peruCulture = CultureInfo.GetCultureInfo("es-PE");
    var filters = new[]
    {
        new { Key = "Todas", Label = "Todas", Count = Model.ResultadosTodas },
        new { Key = "Enviada", Label = "Enviada", Count = Model.ResultadosEnviadas },
        new { Key = "Vencida", Label = "Vencida", Count = Model.ResultadosVencidas },
        new { Key = "Aprobada", Label = "Aprobada", Count = Model.ResultadosAprobadas }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/cotizaciones.css" asp-append-version="true" />
}

<div class="container-fluid px-0 quote-inbox-page">
    <header class="quote-inbox-header">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h1 class="quote-header-title">Cotizaciones</h1>
                <span class="badge-b2b-core">B2B Core</span>
            </div>
            <p class="quote-header-subtitle">Bandeja de seguimiento y control de vigencia de cotizaciones emitidas.</p>
        </div>
        <div class="quote-brand-pill">
            <i class="bi bi-square-fill"></i>
            <strong>PROSEGIN</strong>
            <span>PREVENCIÓN INTEGRAL</span>
        </div>
    </header>

    <section class="quote-inbox-toolbar">
        <form asp-controller="Cotizaciones" asp-action="Index" method="get" class="quote-inbox-search">
            <label class="visually-hidden" for="buscarCotizacion">Buscar por código o cliente</label>
            <i class="bi bi-search"></i>
            <input id="buscarCotizacion" type="search" name="busqueda" value="@Model.Busqueda"
                   placeholder="Buscar por código correlativo o client..." />
            <input type="hidden" name="estado" value="@Model.EstadoFiltro" />
            <button type="submit" class="btn-prosegin-primary">Buscar</button>
        </form>

        <nav class="quote-inbox-filters" aria-label="Filtrar cotizaciones por estado">
            @foreach (var filter in filters)
            {
                var badgeClass = filter.Key switch
                {
                    "Todas" => "badge-count-all",
                    "Enviada" => "badge-count-enviada",
                    "Vencida" => "badge-count-vencida",
                    "Aprobada" => "badge-count-aprobada",
                    _ => ""
                };
                <a asp-controller="Cotizaciones" asp-action="Index"
                   asp-route-estado="@filter.Key"
                   asp-route-busqueda="@Model.Busqueda"
                   class="quote-inbox-filter @(Model.EstadoFiltro == filter.Key ? "active" : "")"
                   aria-current="@(Model.EstadoFiltro == filter.Key ? "page" : null)">
                    @filter.Label <span class="quote-tab-badge @badgeClass">@filter.Count</span>
                </a>
            }
        </nav>
    </section>

    <div class="quote-inbox-scroll-wrapper">
        <div class="quote-inbox-inner-container">
            <!-- Encabezados de Columna -->
            <div class="quote-columns-header">
                <div>CÓDIGO</div>
                <div>CLIENTE / RUC</div>
                <div>EMISIÓN</div>
                <div>VIGENCIA (48 H)</div>
                <div>MONTO<br />TOTAL</div>
                <div>ESTADO</div>
                <div class="text-end">ACCIONES</div>
            </div>

            @if (Model.Cotizaciones.Count == 0)
            {
                <div class="quote-inbox-empty-card">
                    <i class="bi bi-inbox"></i>
                    <strong>No se encontraron cotizaciones.</strong>
                    <span>Prueba otro código, cliente o filtro de estado.</span>
                </div>
            }
            else
            {
                var rowIndex = 0;
                @foreach (var cotizacion in Model.Cotizaciones)
                {
                    rowIndex++;
                    var vigenciaRestante = cotizacion.FechaVencimiento - DateTime.UtcNow;
                    var isAprobada = cotizacion.Estado == "Aprobada";
                    var isEnviada = cotizacion.Estado == "Enviada";
                    var isVencida = cotizacion.Estado == "Vencida";

                    var iconClass = isAprobada ? "icon-aprobada" : isVencida ? "icon-vencida" : "icon-enviada";
                    var iconName = isAprobada ? "bi-check-circle" : isVencida ? "bi-exclamation-circle" : "bi-file-earmark";

                    // En la captura de referencia, el segundo registro (PED-2026-0851) se muestra con el acordeón expandido
                    var isAccordionOpen = rowIndex == 2 || cotizacion.Correlativo.Contains("0851");

                    <div class="quote-card-item">
                        <div class="quote-card-main-row">
                            <!-- 1. Código con Avatar Dinámico del Cliente -->
                            <div class="quote-col-code">
                                <div class="client-avatar-container" title="@cotizacion.Cliente">
                                    @if (!string.IsNullOrEmpty(cotizacion.AvatarLogoUrl))
                                    {
                                        <img src="@cotizacion.AvatarLogoUrl"
                                             alt="@cotizacion.Cliente"
                                             class="client-avatar-logo"
                                             loading="lazy"
                                             onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                        <div class="client-avatar-monogram @cotizacion.AvatarColorSchemeClass" style="display: none;">
                                            @cotizacion.AvatarInitials
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="client-avatar-monogram @cotizacion.AvatarColorSchemeClass">
                                            @cotizacion.AvatarInitials
                                        </div>
                                    }
                                </div>
                                <div class="quote-code-info">
                                    <span class="quote-code-text">@cotizacion.Correlativo</span>
                                    @if (isAprobada && rowIndex > 2)
                                    {
                                        <span class="quote-code-sub">Cotización Oficial</span>
                                    }
                                </div>
                            </div>

                            <!-- 2. Cliente / RUC -->
                            <div class="quote-col-client">
                                <span class="quote-client-name">@cotizacion.Cliente</span>
                                <div class="d-flex align-items-center">
                                    <span class="quote-client-ruc">RUC @cotizacion.Ruc</span>
                                    @if (cotizacion.Cliente.Contains("DELOSI", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="quote-client-tag">
                                            <i class="bi bi-asterisk"></i> Retail / Franquicias
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- 3. Emisión -->
                            <div class="quote-col-emission">
                                <i class="bi bi-calendar3"></i>
                                <span>@cotizacion.FechaEmision.ToLocalTime().ToString("dd/MM/yyyy HH:mm", peruCulture)</span>
                            </div>

                            <!-- 4. Vigencia -->
                            <div class="quote-col-validity">
                                <span class="quote-validity-date">@cotizacion.FechaVencimiento.ToLocalTime().ToString("dd/MM/yyyy HH:mm", peruCulture)</span>
                                @if (isEnviada)
                                {
                                    <span class="quote-badge-expiry-active">
                                        <i class="bi bi-clock"></i> Vence en @Math.Max(0, (int)Math.Ceiling(vigenciaRestante.TotalHours)) h
                                    </span>
                                }
                                else if (isVencida)
                                {
                                    <span class="quote-badge-expiry-expired">
                                        <i class="bi bi-exclamation-circle-fill"></i> Expiró hace @Math.Max(0, (int)Math.Ceiling(-vigenciaRestante.TotalHours)) h
                                    </span>
                                }
                                else
                                {
                                    <span class="quote-badge-accepted">
                                        <i class="bi bi-check2"></i> Cerrada por aceptación
                                    </span>
                                }
                            </div>

                            <!-- 5. Monto Total -->
                            <div class="quote-col-total">
                                S/ @cotizacion.Total.ToString("N2", peruCulture)
                            </div>

                            <!-- 6. Estado -->
                            <div class="quote-col-status">
                                <span class="quote-status-pill status-@cotizacion.Estado.ToLowerInvariant()">
                                    <span class="status-dot"></span> @cotizacion.Estado
                                </span>
                                @if (isAprobada)
                                {
                                    <span class="quote-readonly-sub">Solo lectura</span>
                                    @if (!string.IsNullOrWhiteSpace(cotizacion.NombreArchivoOrdenCompraCliente))
                                    {
                                        <div class="quote-oc-file-link">
                                            <i class="bi bi-file-earmark-pdf-fill"></i>
                                            <a asp-action="VerOrdenCompra" asp-route-id="@cotizacion.Id" target="_blank"
                                               class="quote-oc-name" title="@cotizacion.NombreArchivoOrdenCompraCliente">@cotizacion.NombreArchivoOrdenCompraCliente</a>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- 7. Acciones -->
                            <div class="quote-col-actions">
                                <div class="dropdown">
                                    <button type="button" class="quote-btn-menu" data-bs-toggle="dropdown"
                                            aria-expanded="false" data-quote-row-menu
                                            aria-label="Acciones para @cotizacion.Correlativo">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a asp-controller="Cotizaciones" asp-action="VerPdf" asp-route-id="@cotizacion.Id"
                                               target="_blank" rel="noopener noreferrer" class="dropdown-item">
                                                <i class="bi bi-file-earmark-pdf me-2"></i>Ver PDF
                                            </a>
                                        </li>
                                        @if (cotizacion.Estado == "Enviada")
                                        {
                                            <li>
                                                <button type="button" class="dropdown-item" data-toggle-quote-panel="@cotizacion.Id">
                                                    <i class="bi bi-arrow-left-right me-2"></i>Convertir a Venta
                                                </button>
                                            </li>
                                        }
                                        else if (cotizacion.Estado == "Vencida")
                                        {
                                            <li>
                                                @if (cotizacion.FueActualizada)
                                                {
                                                    <span class="dropdown-item-text text-muted">
                                                        <i class="bi bi-check2 me-2"></i>Ya fue actualizada
                                                    </span>
                                                }
                                                else
                                                {
                                                    <form asp-controller="Cotizaciones" asp-action="Actualizar" asp-route-id="@cotizacion.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="bi bi-arrow-repeat me-2"></i>Actualizar cotización
                                                        </button>
                                                    </form>
                                                }
                                            </li>
                                        }
                                        else if (cotizacion.Estado == "Aprobada")
                                        {
                                            <li>
                                                <a asp-controller="Cotizaciones" asp-action="VerOrdenCompra" asp-route-id="@cotizacion.Id"
                                                   target="_blank" rel="noopener noreferrer" class="dropdown-item">
                                                    <i class="bi bi-file-earmark-check me-2"></i>Ver OC
                                                </a>
                                            </li>
                                            @if (cotizacion.PuedeReemplazarOrdenCompra)
                                            {
                                                <li>
                                                    <button type="button" class="dropdown-item" data-toggle-quote-panel="@cotizacion.Id">
                                                        <i class="bi bi-arrow-repeat me-2"></i>Reemplazar Orden de Compra
                                                    </button>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Acordeón de Productos, Cantidades y Precios -->
                        @if (cotizacion.Detalles.Count > 0)
                        {
                            <div class="quote-card-accordion-section">
                                <div class="quote-accordion-toggle" data-accordion-toggle="@cotizacion.Id" role="button" tabindex="0">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-chevron-down accordion-chevron @(isAccordionOpen ? "" : "chevron-rotated")" id="chevron-@cotizacion.Id"></i>
                                        <span class="accordion-title">Productos, cantidades y precios</span>
                                        <span class="accordion-badge-readonly">Solo lectura</span>
                                    </div>
                                    <span class="accordion-count">@cotizacion.Detalles.Count artículos incluidos</span>
                                </div>
                                <div class="quote-accordion-body" id="accordion-body-@cotizacion.Id" style="@(isAccordionOpen ? "" : "display: none;")">
                                    <div class="table-responsive">
                                        <table class="quote-nested-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">SKU</th>
                                                    <th scope="col">PRODUCTO</th>
                                                    <th scope="col" class="text-end">CANTIDAD</th>
                                                    <th scope="col" class="text-end">PRECIO UNITARIO</th>
                                                    <th scope="col" class="text-end">SUBTOTAL</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var detalle in cotizacion.Detalles)
                                                {
                                                    <tr>
                                                        <td class="nested-sku">@detalle.Sku</td>
                                                        <td class="nested-product">@detalle.Producto</td>
                                                        <td class="nested-quantity text-end">@detalle.Cantidad</td>
                                                        <td class="nested-unit-price text-end">S/ @detalle.PrecioUnitario.ToString("N2", peruCulture)</td>
                                                        <td class="nested-subtotal text-end">S/ @detalle.Subtotal.ToString("N2", peruCulture)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Panel de Subida de OC / Reemplazo -->
                        @if (cotizacion.Estado == "Enviada")
                        {
                            <div class="quote-upload-drawer" data-quote-upload-row="@cotizacion.Id"
                                 hidden="@(Model.PanelAbiertoId == cotizacion.Id ? null : "hidden")">
                                <form asp-controller="Cotizaciones" asp-action="ConvertirAVenta"
                                      method="post" enctype="multipart/form-data" class="quote-upload-panel"
                                      data-quote-upload-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@cotizacion.Id" />
                                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                    <input type="hidden" name="estado" value="@Model.EstadoFiltro" />
                                    <input type="hidden" name="pagina" value="@Model.Pagina" />

                                    <!-- Cabecera del panel -->
                                    <div class="quote-upload-card-header">
                                        <div class="quote-upload-title-wrap">
                                            <span class="quote-upload-title-icon"><i class="bi bi-file-earmark-text"></i></span>
                                            <span class="quote-upload-title-text">Adjuntar Orden de Compra (OC) del Cliente</span>
                                        </div>
                                        <span class="badge-step-billing">
                                            <span class="step-dot"></span> Paso previo a facturación
                                        </span>
                                    </div>

                                    <!-- Grid de 2 columnas -->
                                    <div class="quote-upload-grid">
                                        <!-- Columna 1: Cargar Archivo PDF -->
                                        <div class="quote-upload-col">
                                            <label class="quote-field-label">
                                                CARGAR ARCHIVO PDF DE OC <span class="text-danger">*</span>
                                            </label>
                                            <div class="quote-dropzone-box" data-file-trigger>
                                                <div class="quote-dropzone-icon">
                                                    <i class="bi bi-cloud-arrow-up"></i>
                                                </div>
                                                <div class="quote-dropzone-main-text">
                                                    Arrastra el archivo PDF o <span class="quote-dropzone-link">selecciona desde tu equipo</span>
                                                </div>
                                                <div class="quote-dropzone-subtext">
                                                    Exclusivamente formato PDF (máx. 10 MB)
                                                </div>
                                            </div>
                                            <input class="quote-file-input" type="file" name="archivoOrdenCompra"
                                                   accept=".pdf,application/pdf" required data-pdf-input />
                                            <div class="quote-selected-file" data-file-name aria-live="polite">Ningún archivo seleccionado</div>
                                        </div>

                                        <!-- Columna 2: N° OC y Acciones -->
                                        <div class="quote-upload-col quote-col-right">
                                            <div>
                                                <label class="quote-field-label" for="numeroOrdenCompraCliente-@cotizacion.Id">
                                                    N° DE ORDEN DE COMPRA DE REFERENCIA <span class="text-danger">*</span>
                                                </label>
                                                <div class="quote-input-wrapper">
                                                    <i class="bi bi-list quote-input-icon"></i>
                                                    <input type="text" id="numeroOrdenCompraCliente-@cotizacion.Id"
                                                           name="numeroOrdenCompraCliente" maxlength="100" required
                                                           placeholder="Ej. OC-2026-90412" class="quote-ref-input" />
                                                </div>
                                            </div>
                                            <div class="quote-form-actions-inline">
                                                <button type="button" class="quote-btn-cancel" data-cancel-quote-panel>Cancelar</button>
                                                <button type="submit" class="quote-btn-confirm">
                                                    <span>Confirmar Conversión</span>
                                                    <i class="bi bi-arrow-right"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        }
                        else if (cotizacion.PuedeReemplazarOrdenCompra)
                        {
                            <div class="quote-upload-drawer" data-quote-upload-row="@cotizacion.Id"
                                 hidden="@(Model.PanelAbiertoId == cotizacion.Id ? null : "hidden")">
                                <form asp-controller="Cotizaciones" asp-action="ReemplazarOrdenCompra"
                                      method="post" enctype="multipart/form-data" class="quote-upload-panel"
                                      data-quote-upload-form>
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@cotizacion.Id" />
                                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                    <input type="hidden" name="estado" value="@Model.EstadoFiltro" />
                                    <input type="hidden" name="pagina" value="@Model.Pagina" />

                                    <!-- Cabecera del panel -->
                                    <div class="quote-upload-card-header">
                                        <div class="quote-upload-title-wrap">
                                            <span class="quote-upload-title-icon"><i class="bi bi-arrow-repeat"></i></span>
                                            <span class="quote-upload-title-text">Reemplazar Orden de Compra (OC) del Cliente</span>
                                        </div>
                                        <span class="badge-step-billing">
                                            <span class="step-dot"></span> Conserva estado Aprobada
                                        </span>
                                    </div>

                                    <p class="quote-current-file">
                                        Documento actual:
                                        <a asp-controller="Cotizaciones" asp-action="VerOrdenCompra" asp-route-id="@cotizacion.Id"
                                           target="_blank" rel="noopener noreferrer">@cotizacion.NombreArchivoOrdenCompraCliente</a>
                                        <span>N° @cotizacion.NumeroOrdenCompraCliente</span>
                                    </p>

                                    <!-- Grid de 2 columnas -->
                                    <div class="quote-upload-grid">
                                        <!-- Columna 1: Cargar Archivo PDF -->
                                        <div class="quote-upload-col">
                                            <label class="quote-field-label">
                                                CARGAR ARCHIVO PDF DE OC <span class="text-danger">*</span>
                                            </label>
                                            <div class="quote-dropzone-box" data-file-trigger>
                                                <div class="quote-dropzone-icon">
                                                    <i class="bi bi-cloud-arrow-up"></i>
                                                </div>
                                                <div class="quote-dropzone-main-text">
                                                    Arrastra el nuevo PDF o <span class="quote-dropzone-link">selecciona desde tu equipo</span>
                                                </div>
                                                <div class="quote-dropzone-subtext">
                                                    Exclusivamente formato PDF (máx. 10 MB)
                                                </div>
                                            </div>
                                            <input class="quote-file-input" type="file" name="archivoOrdenCompra"
                                                   accept=".pdf,application/pdf" required data-pdf-input />
                                            <div class="quote-selected-file" data-file-name aria-live="polite">Ningún archivo seleccionado</div>
                                        </div>

                                        <!-- Columna 2: N° OC y Acciones -->
                                        <div class="quote-upload-col quote-col-right">
                                            <div>
                                                <label class="quote-field-label" for="numeroOrdenCompraCliente-@cotizacion.Id">
                                                    N° DE ORDEN DE COMPRA DE REFERENCIA
                                                </label>
                                                <div class="quote-input-wrapper">
                                                    <i class="bi bi-list quote-input-icon"></i>
                                                    <input type="text" id="numeroOrdenCompraCliente-@cotizacion.Id"
                                                           name="numeroOrdenCompraCliente" maxlength="100"
                                                           value="@cotizacion.NumeroOrdenCompraCliente" class="quote-ref-input" />
                                                </div>
                                            </div>
                                            <div class="quote-form-actions-inline">
                                                <button type="button" class="quote-btn-cancel" data-cancel-quote-panel>Cancelar</button>
                                                <button type="submit" class="quote-btn-confirm">
                                                    <span>Confirmar reemplazo</span>
                                                    <i class="bi bi-arrow-right"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <footer class="quote-inbox-footer">
        <span>Mostrando @Model.Cotizaciones.Count de @Model.TotalResultados cotizaciones emitidas</span>
        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación de cotizaciones" class="quote-inbox-pagination">
                <a asp-action="Index" asp-route-estado="@Model.EstadoFiltro" asp-route-busqueda="@Model.Busqueda"
                   asp-route-pagina="@(Model.Pagina - 1)" class="@(Model.Pagina == 1 ? "disabled" : "")"
                   aria-disabled="@(Model.Pagina == 1)">Anterior</a>
                <span>Página @Model.Pagina de @Model.TotalPaginas</span>
                <a asp-action="Index" asp-route-estado="@Model.EstadoFiltro" asp-route-busqueda="@Model.Busqueda"
                   asp-route-pagina="@(Model.Pagina + 1)" class="@(Model.Pagina == Model.TotalPaginas ? "disabled" : "")"
                   aria-disabled="@(Model.Pagina == Model.TotalPaginas)">Siguiente</a>
            </nav>
        }
    </footer>
</div>

@section Scripts {
    <script src="~/js/cotizaciones.js" asp-append-version="true"></script>
}
