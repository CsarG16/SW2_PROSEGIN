@model Prosegin.Web.ViewModels.Cotizaciones.CotizacionClienteViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Nueva Cotización";
    var noPuedeVender = !string.Equals(Model.EstadoSunat, "ACTIVO", StringComparison.OrdinalIgnoreCase)
        || !string.Equals(Model.CondicionSunat, "HABIDO", StringComparison.OrdinalIgnoreCase);
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-file-earmark-text text-warning me-2"></i>NUEVA COTIZACIÓN</h4>
            <p class="text-muted small mb-0">La validación fiscal y crediticia se ejecuta nuevamente al guardar.</p>
        </div>
        <a asp-controller="Clientes" asp-action="Index" class="btn-prosegin-secondary"><i class="bi bi-arrow-left me-1"></i>VOLVER A CLIENTES</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (Model.DatosSunatDesactualizados)
    {
        <div class="alert alert-warning border-warning shadow-sm">
            <i class="bi bi-arrow-repeat me-2"></i>
            <strong>ACTUALIZACIÓN OBLIGATORIA:</strong> la dirección o el representante legal difiere de SUNAT.
            <form asp-action="ActualizarDesdeSunat" method="post" class="d-inline ms-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                <button type="submit" class="btn btn-sm btn-warning"><i class="bi bi-cloud-download me-1"></i>ACTUALIZAR DATOS</button>
            </form>
        </div>
    }
    else if (noPuedeVender)
    {
        <div class="alert alert-danger border-danger shadow-sm">
            <i class="bi bi-shield-slash-fill me-2"></i>
            <strong>VENTA RESTRINGIDA:</strong> el cliente debe figurar ACTIVO y HABIDO en SUNAT.
        </div>
    }
    else if (Model.ClienteBloqueado)
    {
        <div class="alert alert-danger border-danger shadow-sm">
            <i class="bi bi-lock-fill me-2"></i>
            <strong>CLIENTE BLOQUEADO POR MORA:</strong> @Model.MotivoBloqueo
            <div class="small mt-1">Las cotizaciones a crédito están deshabilitadas.</div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="prosegin-card">
                <div class="prosegin-card-header"><h5 class="prosegin-card-title mb-0">Cliente seleccionado</h5></div>
                <div class="prosegin-card-body p-4">
                    <input asp-for="ClienteId" type="hidden" />
                    <div class="row g-3">
                        <div class="col-md-4"><span class="text-muted small d-block">RUC</span><strong class="font-monospace">@Model.Ruc</strong></div>
                        <div class="col-md-8"><span class="text-muted small d-block">Razón social</span><strong>@Model.RazonSocial</strong></div>
                        <div class="col-md-6"><span class="text-muted small d-block">Estado SUNAT</span><span class="badge @(noPuedeVender ? "bg-danger" : "bg-success")">@Model.EstadoSunat</span></div>
                        <div class="col-md-6"><span class="text-muted small d-block">Condición SUNAT</span><span class="badge @(noPuedeVender ? "bg-danger" : "bg-success")">@Model.CondicionSunat</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="prosegin-card">
                <div class="prosegin-card-header"><h5 class="prosegin-card-title mb-0">Condiciones comerciales</h5></div>
                <div class="prosegin-card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="ClienteId" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="CondicionPago" class="form-label-prosegin">Condición de pago</label>
                            <select asp-for="CondicionPago" class="form-select form-control-prosegin">
                                <option value="Contado">Contado</option>
                                <option value="7 días">Crédito a 7 días</option>
                                <option value="15 días">Crédito a 15 días</option>
                                <option value="30 días">Crédito a 30 días</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Total" class="form-label-prosegin">Total de cotización</label>
                            <input asp-for="Total" class="form-control form-control-prosegin" type="number" min="0.01" step="0.01" />
                            <span asp-validation-for="Total" class="text-danger small"></span>
                        </div>
                        <div class="small text-muted mb-3">
                            Límite: @Model.LimiteCredito.ToString("C", new CultureInfo("es-PE"))<br />
                            Saldo pendiente: @Model.SaldoPendiente.ToString("C", new CultureInfo("es-PE"))
                        </div>
                        <button type="submit" class="btn-prosegin-primary w-100" @(noPuedeVender || Model.DatosSunatDesactualizados ? "disabled" : null)>
                            <i class="bi bi-check2-circle me-1"></i>GENERAR COTIZACIÓN
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
