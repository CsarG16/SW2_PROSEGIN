@model Prosegin.Web.ViewModels.Cotizaciones.CotizacionClienteViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Nueva Cotización";
    var cotizacionGuardada = TempData["SuccessMessage"] != null;
    var noPuedeVender = !string.Equals(Model.EstadoSunat, "ACTIVO", StringComparison.OrdinalIgnoreCase)
        || !string.Equals(Model.CondicionSunat, "HABIDO", StringComparison.OrdinalIgnoreCase);
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1"><i class="bi bi-file-earmark-text text-warning me-2"></i>NUEVA COTIZACIÓN</h4>
            <p class="text-muted small mb-0">La validación fiscal y crediticia se ejecuta nuevamente al guardar.</p>
        </div>
        <a asp-controller="Clientes" asp-action="Index" class="btn-prosegin-secondary"><i class="bi bi-arrow-left me-1"></i>VOLVER A CLIENTES</a>
    </div>

    @if (cotizacionGuardada)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (Model.DatosSunatDesactualizados)
    {
        <div class="alert alert-warning border-warning shadow-sm">
            <i class="bi bi-arrow-repeat me-2"></i>
            <strong>ACTUALIZACIÓN OBLIGATORIA:</strong> la dirección o el representante legal difiere de SUNAT.
            <form asp-action="ActualizarDesdeSunat" method="post" class="d-inline ms-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                <button type="submit" class="btn btn-sm btn-warning"><i class="bi bi-cloud-download me-1"></i>ACTUALIZAR DATOS</button>
            </form>
        </div>
    }
    else if (noPuedeVender)
    {
        <div class="alert alert-danger border-danger shadow-sm">
            <i class="bi bi-shield-slash-fill me-2"></i>
            <strong>VENTA RESTRINGIDA:</strong> el cliente debe figurar ACTIVO y HABIDO en SUNAT.
        </div>
    }
    else if (Model.ClienteBloqueado)
    {
        <div class="alert alert-danger border-danger shadow-sm">
            <i class="bi bi-lock-fill me-2"></i>
            <strong>CLIENTE BLOQUEADO POR MORA:</strong> @Model.MotivoBloqueo
            <div class="small mt-1">Las cotizaciones a crédito están deshabilitadas.</div>
        </div>
    }

    <form asp-action="Create" method="post" id="formCotizacion" data-cotizacion-guardada="@(cotizacionGuardada ? "true" : "false")">
        @Html.AntiForgeryToken()
        <input asp-for="ClienteId" type="hidden" />

        <nav class="quote-tabs" role="tablist" aria-label="Secciones de la cotización">
            <button type="button" role="tab" aria-selected="false" data-quote-tab="cliente"><i class="bi bi-person me-1"></i>Cliente</button>
            <button type="button" role="tab" aria-selected="false" data-quote-tab="cabecera"><i class="bi bi-file-earmark-text me-1"></i>Cabecera</button>
            <button type="button" role="tab" aria-selected="true" data-quote-tab="productos"><i class="bi bi-box-seam me-1"></i>Productos</button>
            <button type="button" role="tab" aria-selected="false" data-quote-tab="condiciones"><i class="bi bi-credit-card me-1"></i>Condiciones</button>
            <button type="button" role="tab" aria-selected="false" data-quote-tab="observaciones"><i class="bi bi-chat-left-text me-1"></i>Observaciones</button>
        </nav>

        <section class="quote-panel" data-quote-panel="cliente" hidden>
            <div class="quote-panel-heading"><div><span>CLIENTE</span><h2>Datos del cliente</h2></div><span class="quote-status @(noPuedeVender ? "is-danger" : "is-ok")">@(noPuedeVender ? "VENTA RESTRINGIDA" : "HABILITADO")</span></div>
            <div class="quote-client-grid">
                <div><span>RUC</span><strong class="font-monospace">@Model.Ruc</strong></div>
                <div class="quote-client-name"><span>Razón social</span><strong>@Model.RazonSocial</strong></div>
                <div><span>Estado SUNAT</span><strong>@Model.EstadoSunat</strong></div>
                <div><span>Condición SUNAT</span><strong>@Model.CondicionSunat</strong></div>
                <div class="quote-client-name"><span>Dirección fiscal</span><strong>@Model.DireccionFiscal</strong></div>
            </div>
        </section>

        <section class="quote-panel" data-quote-panel="cabecera" hidden>
            <div class="quote-panel-heading"><div><span>CABECERA</span><h2>Resumen de cotización</h2></div><span class="quote-status">BORRADOR</span></div>
            <div class="quote-header-grid">
                <div><span>Cliente</span><strong>@Model.RazonSocial</strong></div>
                <div><span>RUC</span><strong class="font-monospace">@Model.Ruc</strong></div>
                <div><span>Emisión</span><strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong></div>
                <div><span>Correlativo</span><strong>Se asignará al guardar</strong></div>
            </div>
        </section>

                <div class="quote-workspace" data-quote-panel="productos">
                    <section class="quote-panel quote-products-panel">
                        <div class="quote-product-entry">
                <label class="quote-field quote-search-field" for="filtroProductos">Búsqueda
                    <input id="filtroProductos" type="search" placeholder="Buscar por código, descripción o categoría" autocomplete="off" aria-label="Buscar productos del catálogo" />
                    <div class="quote-search-results" id="resultadosBusqueda" role="listbox" aria-label="Productos encontrados" hidden></div>
                    <span class="quote-search-feedback" id="estadoBusqueda" aria-live="polite"></span>
                </label>
                <label class="quote-field quote-product-field" for="selectorProducto">Producto
                    <select id="selectorProducto" aria-label="Selecciona un producto">
                        <option value="">Selecciona un producto del catálogo</option>
                        @foreach (var producto in Model.ProductosDisponibles)
                        {
                            <option value="@producto.ProductoId" data-search="@($"{producto.Sku} {producto.Nombre} {producto.Categoria}".ToLowerInvariant())">@producto.Sku · @producto.Nombre</option>
                        }
                    </select>
                </label>
                <label class="quote-field quote-quantity-field" for="cantidadAgregar">Cantidad
                    <input id="cantidadAgregar" type="number" min="1" value="1" inputmode="numeric" />
                </label>
                <label class="quote-field quote-price-field" for="precioSeleccionado">Precio estimado
                    <input id="precioSeleccionado" type="text" value="S/ 0.00" readonly />
                </label>
                <label class="quote-field quote-stock-field" for="stockSeleccionado">Stock
                    <input id="stockSeleccionado" type="text" value="-" readonly />
                </label>
                <button type="button" class="quote-add-button" id="agregarProducto" disabled><i class="bi bi-plus-lg"></i>Agregar</button>
            </div>

            @if (Model.ProductosDisponibles.Count == 0)
            {
                <div class="alert alert-warning mb-0">No hay productos activos en el catálogo.</div>
            }
            else
            {
                <div class="quote-table-wrap">
                    <table class="quote-product-table">
                        <thead>
                            <tr><th>#</th><th>Código</th><th>Descripción</th><th>UM</th><th>Cantidad</th><th class="text-end">P. bruto</th><th class="text-center">%</th><th class="text-end">P. final</th><th class="text-end">Total</th><th class="text-center">Opciones</th></tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.ProductosDisponibles.Count; i++)
                            {
                                var producto = Model.ProductosDisponibles[i];
                                <tr class="quote-product-row @(producto.Seleccionado ? "is-selected" : "")" data-product-row data-product-id="@producto.ProductoId" data-cost="@producto.CostoReferencial.ToString(CultureInfo.InvariantCulture)" data-stock="@producto.StockDisponible" data-unit="@producto.UnidadMedida" data-search="@($"{producto.Sku} {producto.Nombre} {producto.Categoria}".ToLowerInvariant())">
                                    <td class="quote-row-number">@(i + 1)</td>
                                    <td class="font-monospace fw-semibold"><input asp-for="ProductosDisponibles[i].ProductoId" type="hidden" />@producto.Sku</td>
                                    <td><span class="quote-row-description">@producto.Nombre</span><span class="quote-row-category">@producto.Categoria</span></td>
                                    <td>@producto.UnidadMedida</td>
                                    <td><input asp-for="ProductosDisponibles[i].Cantidad" class="quote-line-input" type="number" min="1" aria-label="Cantidad de @producto.Nombre" /></td>
                                    <td class="text-end font-monospace">@producto.CostoReferencial.ToString("N2", new CultureInfo("es-PE"))</td>
                                    <td><input asp-for="ProductosDisponibles[i].MargenPorcentaje" class="quote-line-input quote-margin-input" type="number" min="0" max="100" step="0.01" aria-label="Margen de @producto.Nombre en porcentaje" /></td>
                                    <td class="text-end font-monospace" data-unit-price>S/ 0.00</td>
                                    <td class="text-end font-monospace fw-semibold" data-line-subtotal>—</td>
                                    <td class="text-center">
                                        <input asp-for="ProductosDisponibles[i].Seleccionado" class="quote-selection-input" aria-label="Incluir @producto.Nombre en la cotización" />
                                        <button type="button" class="quote-remove-button" data-remove-product aria-label="Quitar @producto.Nombre" title="Quitar producto"><i class="bi bi-trash3"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="quote-empty-lines" id="productosVacios" @(Model.ProductosDisponibles.Any(producto => producto.Seleccionado) ? "hidden" : null)>
                        <i class="bi bi-cart3"></i><span>Agrega productos para preparar la cotización.</span>
                    </div>
                </div>
            }
            <div class="quote-table-footer"><span><strong id="cantidadProductos">0</strong> productos seleccionados</span><span>Moneda: <strong>PEN · S/</strong></span></div>
          </section>
          <aside class="quote-side-summary" aria-label="Resumen de importes">
              <h2><i class="bi bi-calculator me-2"></i>Resumen</h2>
              <div class="quote-totals" aria-live="polite">
                  <div><span>Exonerada</span><strong>S/ 0.00</strong></div>
                  <div><span>Subtotal</span><strong id="subtotalCotizacion">S/ 0.00</strong></div>
                  <div><span>IGV (18 %)</span><strong id="igvCotizacion">S/ 0.00</strong></div>
                  <div class="quote-grand-total"><span>Total general</span><strong id="totalCotizacion">S/ 0.00</strong></div>
              </div>
          </aside>
        </div>

        <section class="quote-panel" data-quote-panel="condiciones" hidden>
            <div class="quote-panel-heading"><div><span>CONDICIONES</span><h2>Condiciones comerciales</h2></div></div>
            <div class="quote-conditions-grid">
                <label asp-for="CondicionPago" class="quote-field">Condición de pago
                    <select asp-for="CondicionPago">
                        <option value="Contado">Contado</option>
                        <option value="7 días">Crédito a 7 días</option>
                        <option value="15 días">Crédito a 15 días</option>
                        <option value="30 días">Crédito a 30 días</option>
                    </select>
                </label>
                <div><span>Límite de crédito</span><strong>@Model.LimiteCredito.ToString("C", new CultureInfo("es-PE"))</strong></div>
                <div><span>Saldo pendiente</span><strong>@Model.SaldoPendiente.ToString("C", new CultureInfo("es-PE"))</strong></div>
                <div><span>Saldo vencido</span><strong>@Model.SaldoVencido.ToString("C", new CultureInfo("es-PE"))</strong></div>
            </div>
        </section>

        <section class="quote-panel" data-quote-panel="observaciones" hidden>
            <div class="quote-panel-heading"><div><span>OBSERVACIONES</span><h2>Validaciones de la cotización</h2></div></div>
            <div class="quote-observation-note @(noPuedeVender || Model.DatosSunatDesactualizados ? "is-warning" : "")">
                <i class="bi @(noPuedeVender || Model.DatosSunatDesactualizados ? "bi-exclamation-triangle" : "bi-info-circle")"></i>
                <p>@(Model.DatosSunatDesactualizados ? "Actualiza los datos fiscales del cliente desde SUNAT antes de emitir la cotización." : noPuedeVender ? "La cotización no se puede emitir hasta que el cliente figure ACTIVO y HABIDO en SUNAT." : "La información fiscal y crediticia se vuelve a validar al guardar. Las observaciones libres aún no forman parte del registro de cotizaciones.")</p>
            </div>
        </section>

        <div class="quote-bottom-bar">
            <div class="quote-actions">
                <a asp-controller="Clientes" asp-action="Index" class="btn-prosegin-secondary"><i class="bi bi-arrow-left"></i>Atrás</a>
                <button type="button" class="quote-clear-button" id="limpiarProductos"><i class="bi bi-dash-square"></i>Limpiar</button>
                <button type="submit" class="btn-prosegin-primary" @(noPuedeVender || Model.DatosSunatDesactualizados ? "disabled" : null)><i class="bi bi-save"></i>Grabar cotización</button>
            </div>
        </div>
    </form>
</div>

<script>
    (() => {
        const storageKey = "prosegin.quote.cart.v1";
        const rows = Array.from(document.querySelectorAll("[data-product-row]"));
        const productSelector = document.getElementById("selectorProducto");
        const productSearch = document.getElementById("filtroProductos");
        const searchResults = document.getElementById("resultadosBusqueda");
        const searchFeedback = document.getElementById("estadoBusqueda");
        const addButton = document.getElementById("agregarProducto");
        const emptyLines = document.getElementById("productosVacios");
        const currency = new Intl.NumberFormat("es-PE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const formatAmount = (amount) => `S/ ${currency.format(amount)}`;
        const hasServerSelection = rows.some(row => row.querySelector('input[name$=".Seleccionado"]').checked);

        document.querySelectorAll("[data-quote-tab]").forEach((tab) => {
            tab.addEventListener("click", () => {
                const selectedTab = tab.dataset.quoteTab;
                document.querySelectorAll("[data-quote-tab]").forEach((item) => {
                    item.setAttribute("aria-selected", String(item === tab));
                });
                document.querySelectorAll("[data-quote-panel]").forEach((panel) => {
                    panel.hidden = panel.dataset.quotePanel !== selectedTab;
                });
            });
        });

        if (!hasServerSelection) {
            try {
                const cart = JSON.parse(sessionStorage.getItem(storageKey) || "[]");
                cart.forEach(item => {
                    const row = rows.find(candidate => Number(candidate.dataset.productId) === Number(item.id));
                    if (!row) return;
                    row.querySelector('input[name$=".Seleccionado"]').checked = true;
                    row.querySelector('input[name$=".Cantidad"]').value = Math.max(1, Number(item.quantity) || 1);
                });
            } catch {
                sessionStorage.removeItem(storageKey);
            }
        }

        const getSelection = row => row.querySelector('input[name$=".Seleccionado"]');
        const getQuantity = row => row.querySelector('input[name$=".Cantidad"]');
        const getMargin = row => row.querySelector('input[name$=".MargenPorcentaje"]');

        const updateSelectedProduct = () => {
            const option = productSelector?.selectedOptions[0];
            const row = option?.value ? rows.find(candidate => Number(candidate.dataset.productId) === Number(option.value)) : null;
            addButton.disabled = !row;
            document.getElementById("stockSeleccionado").value = row
                ? `${row.dataset.stock} ${row.dataset.unit}`
                : "-";
            if (row) {
                const margin = Number(getMargin(row).value) || 0;
                const price = Number(row.dataset.cost) * (1 + margin / 100);
                document.getElementById("precioSeleccionado").value = formatAmount(Math.round((price + Number.EPSILON) * 100) / 100);
            } else {
                document.getElementById("precioSeleccionado").value = "S/ 0.00";
            }
        };

        const chooseProduct = row => {
            productSelector.value = row.dataset.productId;
            searchResults.hidden = true;
            searchFeedback.textContent = `${row.querySelector(".quote-row-description").textContent} seleccionado. Pulsa Agregar.`;
            updateSelectedProduct();
        };

        productSearch?.addEventListener("input", () => {
            const term = productSearch.value.trim().toLocaleLowerCase();
            const matches = term ? rows.filter(row => row.dataset.search.includes(term)) : [];
            Array.from(productSelector.options).forEach((option, index) => {
                if (index === 0) return;
                option.hidden = term.length > 0 && !option.dataset.search.includes(term);
            });

            searchResults.replaceChildren();
            searchResults.hidden = term.length === 0;
            searchFeedback.textContent = "";

            if (term.length > 0 && matches.length === 0) {
                const emptyResult = document.createElement("span");
                emptyResult.className = "quote-search-empty";
                emptyResult.textContent = "No se encontraron productos.";
                searchResults.append(emptyResult);
                productSelector.value = "";
            } else if (matches.length > 0) {
                matches.slice(0, 8).forEach(row => {
                    const result = document.createElement("button");
                    result.type = "button";
                    result.className = "quote-search-result";
                    result.setAttribute("role", "option");
                    result.textContent = `${row.querySelector("td:nth-child(2)").textContent.trim()} · ${row.querySelector(".quote-row-description").textContent.trim()}`;
                    result.addEventListener("click", () => chooseProduct(row));
                    searchResults.append(result);
                });

                if (matches.length === 1) {
                    productSelector.value = matches[0].dataset.productId;
                    searchFeedback.textContent = "Producto seleccionado. Pulsa Agregar.";
                } else {
                    productSelector.value = "";
                    searchFeedback.textContent = `${matches.length} productos encontrados. Elige uno de la lista.`;
                }
            } else {
                productSelector.value = "";
            }
            updateSelectedProduct();
        });
        productSelector?.addEventListener("change", () => {
            updateSelectedProduct();
            const row = rows.find(candidate => Number(candidate.dataset.productId) === Number(productSelector.value));
            if (row) searchFeedback.textContent = `${row.querySelector(".quote-row-description").textContent} seleccionado. Pulsa Agregar.`;
        });

        addButton?.addEventListener("click", () => {
            const productId = Number(productSelector.value);
            const row = rows.find(candidate => Number(candidate.dataset.productId) === productId);
            if (!row) return;
            const quantity = Math.max(1, Math.floor(Number(document.getElementById("cantidadAgregar").value) || 1));
            getQuantity(row).value = quantity;
            getSelection(row).checked = true;
            row.classList.add("is-selected");
            updateTotals();
            productSelector.value = "";
            productSearch.value = "";
            Array.from(productSelector.options).forEach(option => { option.hidden = false; });
            searchResults.replaceChildren();
            searchResults.hidden = true;
            searchFeedback.textContent = "";
            document.getElementById("cantidadAgregar").value = "1";
            updateSelectedProduct();
        });

        const updateTotals = () => {
            let subtotal = 0;
            const selectedProducts = [];
            rows.forEach((row) => {
                const selected = getSelection(row);
                const quantity = Math.max(1, Math.floor(Number(getQuantity(row).value) || 1));
                const margin = Number(getMargin(row).value) || 0;
                const cost = Number(row.dataset.cost) || 0;
                const unitPrice = Math.round((cost * (1 + margin / 100) + Number.EPSILON) * 100) / 100;
                const lineSubtotal = selected.checked ? Math.round((unitPrice * quantity + Number.EPSILON) * 100) / 100 : 0;
                row.querySelector("[data-unit-price]").textContent = formatAmount(unitPrice);
                row.querySelector("[data-line-subtotal]").textContent = selected.checked ? formatAmount(lineSubtotal) : "—";
                row.classList.toggle("is-selected", selected.checked);
                subtotal += lineSubtotal;
                if (selected.checked) {
                    selectedProducts.push({ id: Number(row.dataset.productId), quantity });
                }
            });

            subtotal = Math.round((subtotal + Number.EPSILON) * 100) / 100;
            const igv = Math.round((subtotal * 0.18 + Number.EPSILON) * 100) / 100;
            document.getElementById("subtotalCotizacion").textContent = formatAmount(subtotal);
            document.getElementById("igvCotizacion").textContent = formatAmount(igv);
            document.getElementById("totalCotizacion").textContent = formatAmount(subtotal + igv);
            document.getElementById("cantidadProductos").textContent = String(selectedProducts.length);
            if (emptyLines) emptyLines.hidden = selectedProducts.length > 0;
            sessionStorage.setItem(storageKey, JSON.stringify(selectedProducts));
        };

        rows.forEach((row) => {
            getSelection(row).addEventListener("change", updateTotals);
            getQuantity(row).addEventListener("input", updateTotals);
            getMargin(row).addEventListener("input", () => {
                updateTotals();
                if (Number(productSelector?.value) === Number(row.dataset.productId)) updateSelectedProduct();
            });
            row.querySelector("[data-remove-product]").addEventListener("click", () => {
                getSelection(row).checked = false;
                updateTotals();
            });
        });

        document.getElementById("limpiarProductos")?.addEventListener("click", () => {
            rows.forEach((row) => {
                getSelection(row).checked = false;
                getQuantity(row).value = "1";
            });
            updateTotals();
        });

        updateTotals();
        updateSelectedProduct();
        if (document.getElementById("formCotizacion").dataset.cotizacionGuardada === "true") {
            sessionStorage.removeItem(storageKey);
        }
    })();
</script>
