@model Prosegin.Web.ViewModels.Cotizaciones.CotizacionClienteViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Generar Cotización";
    var cotizacionGuardada = TempData["SuccessMessage"] != null;
    var noPuedeVender = !string.Equals(Model.EstadoSunat, "ACTIVO", StringComparison.OrdinalIgnoreCase)
        || !string.Equals(Model.CondicionSunat, "HABIDO", StringComparison.OrdinalIgnoreCase);
}

<div class="container-fluid px-0">
    <div class="prosegin-card mb-4 p-3 p-md-4">
        <div class="prosegin-page-header--accent" style="margin-bottom: 0;">
            <div class="header-content">
                <h1 class="page-title">Generar Cotización</h1>
                <p class="page-subtitle">Validación fiscal SUNAT, cálculo de márgenes comerciales y cotización formal de EPP</p>
            </div>
            <a asp-controller="Clientes" asp-action="Index" class="btn-prosegin-secondary">
                <i class="bi bi-arrow-left"></i> Volver a Clientes
            </a>
        </div>
    </div>


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (Model.DatosSunatDesactualizados)
    {
        <div class="alert alert-warning border-warning shadow-sm">
            <i class="bi bi-arrow-repeat me-2"></i>
            <strong>ACTUALIZACIÓN OBLIGATORIA:</strong> la dirección fiscal difiere de SUNAT.
            <form asp-action="ActualizarDesdeSunat" method="post" class="d-inline ms-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                <button type="submit" class="btn btn-sm btn-warning"><i class="bi bi-cloud-download me-1"></i>ACTUALIZAR DATOS</button>
            </form>
        </div>
    }
    else if (noPuedeVender)
    {
        <div class="alert alert-danger border-danger shadow-sm">
            <i class="bi bi-shield-slash-fill me-2"></i>
            <strong>VENTA RESTRINGIDA:</strong> el cliente debe figurar ACTIVO y HABIDO en SUNAT.
        </div>
    }
    else if (Model.ClienteBloqueado)
    {
        <div class="alert alert-danger border-danger shadow-sm">
            <i class="bi bi-lock-fill me-2"></i>
            <strong>CLIENTE BLOQUEADO POR MORA:</strong> @Model.MotivoBloqueo
            <div class="small mt-1">Las cotizaciones a crédito están deshabilitadas.</div>
        </div>
    }

    <form asp-action="Create" method="post" id="formCotizacion" data-cotizacion-guardada="@(cotizacionGuardada ? "true" : "false")">
        @Html.AntiForgeryToken()
        <input asp-for="ClienteId" type="hidden" />



        <section class="quote-panel" data-quote-panel="cliente" hidden>
            <div class="quote-panel-heading"><div><span>CLIENTE</span><h2>Datos del cliente</h2></div><span class="quote-status @(noPuedeVender ? "is-danger" : "is-ok")">@(noPuedeVender ? "VENTA RESTRINGIDA" : "HABILITADO")</span></div>
            <div class="quote-client-grid">
                <div><span>RUC</span><strong class="font-monospace">@Model.Ruc</strong></div>
                <div class="quote-client-name"><span>Razón social</span><strong>@Model.RazonSocial</strong></div>
                <div><span>Estado SUNAT</span><strong>@Model.EstadoSunat</strong></div>
                <div><span>Condición SUNAT</span><strong>@Model.CondicionSunat</strong></div>
                <div class="quote-client-name"><span>Dirección fiscal</span><strong>@Model.DireccionFiscal</strong></div>
            </div>
        </section>

        <section class="quote-panel" data-quote-panel="cabecera" hidden>
            <div class="quote-panel-heading"><div><span>CABECERA</span><h2>Resumen de cotización</h2></div><span class="quote-status">BORRADOR</span></div>
            <div class="quote-header-grid">
                <div><span>Cliente</span><strong>@Model.RazonSocial</strong></div>
                <div><span>RUC</span><strong class="font-monospace">@Model.Ruc</strong></div>
                <div><span>Emisión</span><strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong></div>
                <div><span>Correlativo</span><strong>Se asignará al guardar</strong></div>
            </div>
        </section>

        <div class="mt-4 w-100" data-quote-panel="productos" style="display: block;">
            
            <div class="row g-3 mb-3">
                <!-- Panel izquierdo: Búsqueda y Agregar -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <div class="mb-3 position-relative">
                                <label class="form-label fw-bold text-secondary small mb-1" for="filtroProductos">Búsqueda de Catálogo</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                    <input id="filtroProductos" type="search" class="form-control border-start-0 ps-0" placeholder="Buscar por código, descripción o categoría (ej: Casco dieléctrico, bota, EPP-BOT-0104...)" autocomplete="off" />
                                </div>
                                <div class="list-group position-absolute w-100 shadow-sm mt-1" id="resultadosBusqueda" style="z-index: 1000; max-height: 250px; overflow-y: auto;" hidden></div>
                            </div>
                            
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label fw-bold text-secondary small mb-1">Producto EPP</label>
                                    <input type="text" id="productoSeleccionadoDesc" class="form-control bg-light" readonly placeholder="-" />
                                    <input type="hidden" id="selectorProducto" value="" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold text-secondary small mb-1">Cantidad</label>
                                    <input id="cantidadAgregar" type="number" class="form-control" min="1" value="1" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label fw-bold text-secondary small mb-1">U.M.</label>
                                    <input type="text" id="unidadSeleccionada" class="form-control bg-light text-center" readonly placeholder="-" />
                                </div>
                                <div class="col-md-3 d-flex gap-2">
                                    <div class="flex-grow-1">
                                        <label class="form-label fw-bold text-secondary small mb-1">Costo Base (S/.)</label>
                                        <input type="text" id="precioSeleccionado" class="form-control bg-light" readonly placeholder="S/ 0.00" />
                                    </div>
                                    <button type="button" class="btn px-3 fw-bold text-white" id="agregarProducto" disabled style="background-color: #0B1727; border-color: #0B1727;">Agregar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Panel derecho: Resumen -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            <h6 class="fw-bold text-secondary mb-4 d-flex align-items-center gap-2">
                                <i class="bi bi-receipt"></i> RESUMEN
                            </h6>
                            <div class="d-flex justify-content-between mb-2 small text-secondary">
                                <span>Subtotal</span>
                                <strong id="subtotalCotizacion" class="text-dark">S/ 0.00</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small text-secondary">
                                <span>IGV (18%)</span>
                                <strong id="igvCotizacion" class="text-dark">S/ 0.00</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-4 small text-secondary pb-3 border-bottom">
                                <span>Margen Estimado</span>
                                <strong id="margenEstimadoCotizacion" class="text-success fw-bold">+0.0% (S/ 0.00)</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="fw-bold text-dark">Total Estimado</span>
                                <h4 class="mb-0 fw-bold text-dark" id="totalCotizacion">S/ 0.00</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alerta de validación de precio en tiempo real -->
            <div id="alertaPrecioError" class="alert alert-danger alert-dismissible fade show d-none align-items-center mb-3 shadow-sm rounded-4 border-0 py-3 px-4" role="alert" style="background-color: #f8d7da; color: #842029;">
                <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i>
                <span id="alertaPrecioErrorTexto" class="fw-semibold">El precio cotizado no puede ser menor al costo base registrado</span>
                <button type="button" class="btn-close ms-auto" aria-label="Close" onclick="this.parentElement.classList.add('d-none')"></button>
            </div>

            <!-- Tabla de productos -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0" style="min-width: 860px;">
                        <thead class="border-bottom">
                            <tr>
                                <th class="text-secondary small fw-bold py-3 ps-4" style="width: 4%;">#</th>
                                <th class="text-secondary small fw-bold py-3" style="width: 12%;">CÓDIGO SKU</th>
                                <th class="text-secondary small fw-bold py-3" style="width: 32%;">DESCRIPCIÓN DEL EPP</th>
                                <th class="text-secondary small fw-bold py-3 text-center" style="width: 6%;">U.M.</th>
                                <th class="text-secondary small fw-bold py-3 text-center" style="width: 8%;">CANTIDAD</th>
                                <th class="text-secondary small fw-bold py-3 text-end" style="width: 11%;">COSTO BASE<br>UNIT.</th>
                                <th class="text-secondary small fw-bold py-3 text-center" style="width: 14%;">PRECIO UNIT. (S/.)</th>
                                <th class="text-secondary small fw-bold py-3 text-end" style="width: 9%;">SUBTOTAL</th>
                                <th class="text-secondary small fw-bold py-3 text-center pe-4" style="width: 4%;">ACCIÓN</th>
                            </tr>
                        </thead>
                        <tbody id="tablaProductosBody">
                            @for (var i = 0; i < Model.ProductosDisponibles.Count; i++)
                            {
                                var producto = Model.ProductosDisponibles[i];
                                var precioInicial = producto.PrecioUnitario > 0 ? producto.PrecioUnitario : producto.CostoReferencial;
                                <tr class="border-bottom @(producto.Seleccionado ? "" : "d-none")"
                                    data-product-row
                                    data-product-id="@producto.ProductoId"
                                    data-cost="@producto.CostoReferencial.ToString(CultureInfo.InvariantCulture)"
                                    data-unit="@producto.UnidadMedida"
                                    data-img="@(string.IsNullOrEmpty(producto.RutaImagen) ? $"/images/productos/{producto.Sku}.png" : producto.RutaImagen)"
                                    data-search="@($"{producto.Sku} {producto.Nombre} {producto.Categoria}".ToLowerInvariant())">
                                    <td class="ps-4 text-muted small" data-row-number></td>
                                    <td class="fw-bold small text-dark">
                                        <input asp-for="ProductosDisponibles[i].ProductoId" type="hidden" />
                                        @producto.Sku
                                    </td>
                                    <td>
                                        <div>
                                            <div class="fw-bold small text-dark quote-row-description">@producto.Nombre</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">Categoría: @producto.Categoria</div>
                                        </div>
                                    </td>
                                    <td class="text-center small text-secondary">@producto.UnidadMedida</td>
                                    <td class="text-center">
                                        <input asp-for="ProductosDisponibles[i].Cantidad"
                                               class="form-control form-control-sm text-center mx-auto quote-quantity-input"
                                               type="number"
                                               min="1"
                                               style="width: 70px;" />
                                    </td>
                                    <td class="text-end small text-secondary fw-medium" data-cost-base>
                                        S/ @producto.CostoReferencial.ToString("N2", new CultureInfo("es-PE"))
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex flex-column align-items-center">
                                            <div class="input-group input-group-sm" style="width: 105px;">
                                                <span class="input-group-text bg-light text-muted border-end-0 small px-2">S/</span>
                                                <input asp-for="ProductosDisponibles[i].PrecioUnitario"
                                                       type="number"
                                                       step="0.01"
                                                       min="@producto.CostoReferencial.ToString(CultureInfo.InvariantCulture)"
                                                       class="form-control form-control-sm text-end fw-bold quote-price-input ps-1 pe-2 border-start-0"
                                                       data-cost-base="@producto.CostoReferencial.ToString(CultureInfo.InvariantCulture)"
                                                       value="@precioInicial.ToString("F2", CultureInfo.InvariantCulture)" />
                                            </div>
                                            <span class="quote-margin-badge text-success small mt-1" style="font-size: 0.75rem; font-weight: 500;">+0% margen</span>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold small text-dark" data-line-subtotal>S/ 0.00</td>
                                    <td class="text-center pe-4">
                                        <input asp-for="ProductosDisponibles[i].Seleccionado" type="checkbox" class="d-none quote-selection-input" />
                                        <input asp-for="ProductosDisponibles[i].MargenPorcentaje" type="hidden" value="@producto.MargenPorcentaje" class="quote-margin-input" />
                                        <button type="button" class="btn btn-sm btn-link text-muted p-0 quote-remove-btn" data-remove-product title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div id="productosVacios" class="text-center py-5 text-muted @(Model.ProductosDisponibles.Any(p => p.Seleccionado) ? "d-none" : "")">
                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                        Agrega productos para preparar la cotización.
                    </div>
                </div>
                <div class="card-footer bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                    <span class="small text-dark fw-bold">
                        <i class="bi bi-circle-fill me-2" style="font-size: 6px;"></i><span id="cantidadProductos">0</span> productos en propuesta
                        <span class="text-muted fw-normal mx-2">|</span>
                        <span class="text-muted fw-normal"><i class="bi bi-info-circle me-1"></i>Regla de negocio: El precio unitario cotizado no puede ser menor al costo base unitario.</span>
                    </span>
                    <span class="small fw-bold text-secondary">Moneda: PEN (S/.)</span>
                </div>
            </div>

            <!-- Notificación de éxito centrada estilo píldora -->
            @if (cotizacionGuardada)
            {
                <div class="text-center my-3">
                    <div class="d-inline-flex align-items-center py-2 px-4 rounded-pill border shadow-sm" style="background-color: #E8F8F2; border-color: #A3E6CD; color: #0D8A58; font-weight: 500; font-size: 0.95rem;">
                        <i class="bi bi-check-lg me-2 fs-5"></i> @TempData["SuccessMessage"]
                    </div>
                </div>
            }

        </div>

        <!-- Condiciones (Oculto, pero necesario para el form submit si se requiere) -->
        <section class="quote-panel d-none" data-quote-panel="condiciones">
            <select asp-for="CondicionPago">
                <option value="7 días">Crédito a 7 días</option>
            </select>
        </section>

        <!-- Barra inferior de acciones -->
        <div class="d-flex justify-content-between align-items-center mt-4 bg-white p-3 rounded-4 shadow-sm border">
            <a asp-controller="Clientes" asp-action="Index" class="btn btn-light border px-4"><i class="bi bi-arrow-left me-2"></i>Atrás</a>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-light border px-4" id="limpiarProductos"><i class="bi bi-arrow-counterclockwise me-2"></i>Limpiar</button>
                <button type="submit" class="btn btn-dark px-4 py-2 fw-bold text-white d-flex align-items-center gap-2" id="btnGrabarCotizacion" @(noPuedeVender || Model.DatosSunatDesactualizados ? "disabled" : null) style="background-color: #0B1727; border-color: #0B1727;">
                    <i class="bi bi-box-arrow-down"></i> Grabar cotización
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    (() => {
        const storageKey = "prosegin.quote.cart.v1";
        const rows = Array.from(document.querySelectorAll("[data-product-row]"));
        const productSelector = document.getElementById("selectorProducto");
        const productSearch = document.getElementById("filtroProductos");
        const searchResults = document.getElementById("resultadosBusqueda");
        const addButton = document.getElementById("agregarProducto");
        const emptyLines = document.getElementById("productosVacios");
        const alertBox = document.getElementById("alertaPrecioError");
        const alertText = document.getElementById("alertaPrecioErrorTexto");
        const currency = new Intl.NumberFormat("es-PE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const formatAmount = (amount) => `S/ ${currency.format(amount)}`;
        const hasServerSelection = rows.some(row => row.querySelector('input.quote-selection-input').checked);

        // Ocultar paneles no relevantes si los hay
        document.querySelectorAll("[data-quote-panel]").forEach((panel) => {
            if(panel.dataset.quotePanel !== "productos") panel.classList.add("d-none");
        });

        const showPriceAlert = (msg) => {
            if (alertBox && alertText) {
                alertText.textContent = msg;
                alertBox.classList.remove("d-none");
                clearTimeout(alertBox._timer);
                alertBox._timer = setTimeout(() => {
                    alertBox.classList.add("d-none");
                }, 5000);
            }
        };

        const getSelection = row => row.querySelector('input.quote-selection-input');
        const getQuantity = row => row.querySelector('input.quote-quantity-input');
        const getPrice = row => row.querySelector('input.quote-price-input');
        const getMarginInput = row => row.querySelector('input.quote-margin-input');
        const getMarginBadge = row => row.querySelector('.quote-margin-badge');

        if (document.getElementById("formCotizacion").dataset.cotizacionGuardada === "true") {
            sessionStorage.removeItem(storageKey);
        } else if (!hasServerSelection) {
            try {
                const cart = JSON.parse(sessionStorage.getItem(storageKey) || "[]");
                cart.forEach(item => {
                    const row = rows.find(candidate => Number(candidate.dataset.productId) === Number(item.id));
                    if (!row) return;
                    getSelection(row).checked = true;
                    getQuantity(row).value = Math.max(1, Number(item.quantity) || 1);
                    if (item.price && Number(item.price) >= Number(row.dataset.cost)) {
                        getPrice(row).value = Number(item.price).toFixed(2);
                    }
                });
            } catch {
                sessionStorage.removeItem(storageKey);
            }
        }

        const updateSelectedProductDisplay = (row) => {
            if (row) {
                const sku = row.querySelector("td:nth-child(2)").textContent.trim();
                const desc = row.querySelector(".quote-row-description").textContent.trim();
                document.getElementById("productoSeleccionadoDesc").value = `${sku} - ${desc}`;
                document.getElementById("unidadSeleccionada").value = row.dataset.unit;
                document.getElementById("precioSeleccionado").value = `S/ ${currency.format(Number(row.dataset.cost))}`;
                addButton.disabled = false;
            } else {
                document.getElementById("productoSeleccionadoDesc").value = "";
                document.getElementById("unidadSeleccionada").value = "";
                document.getElementById("precioSeleccionado").value = "";
                addButton.disabled = true;
            }
        };

        const chooseProduct = row => {
            productSelector.value = row.dataset.productId;
            searchResults.hidden = true;
            productSearch.value = row.querySelector(".quote-row-description").textContent.trim();
            updateSelectedProductDisplay(row);
        };

        const renderSearchResults = () => {
            const term = productSearch.value.trim().toLocaleLowerCase();
            const matches = term ? rows.filter(row => row.dataset.search.includes(term)) : rows;
            
            searchResults.replaceChildren();
            searchResults.hidden = false;

            if (matches.length === 0) {
                const emptyResult = document.createElement("div");
                emptyResult.className = "list-group-item text-muted";
                emptyResult.textContent = "No se encontraron productos.";
                searchResults.append(emptyResult);
                productSelector.value = "";
                updateSelectedProductDisplay(null);
            } else {
                matches.forEach(row => {
                    const result = document.createElement("button");
                    result.type = "button";
                    result.className = "list-group-item list-group-item-action text-start d-flex align-items-center gap-3 py-2";
                    const sku = row.querySelector("td:nth-child(2)").textContent.trim();
                    const desc = row.querySelector(".quote-row-description").textContent.trim();
                    const imgSrc = row.dataset.img || "";
                    
                    result.innerHTML = `
                        <img src="${imgSrc}" style="width: 32px; height: 32px; object-fit: contain; border-radius: 4px; border: 1px solid var(--border-light); background: #fff;" onerror="this.style.display='none';" />
                        <div>
                            <div class="fw-bold" style="font-size: 0.9em; color: var(--text-dark);">${sku}</div>
                            <div class="text-muted text-truncate" style="font-size: 0.8em; max-width: 400px;">${desc}</div>
                        </div>
                    `;
                    result.addEventListener("click", () => chooseProduct(row));
                    searchResults.append(result);
                });
            }
        };

        productSearch?.addEventListener("input", renderSearchResults);
        productSearch?.addEventListener("focus", renderSearchResults);

        // Ocultar resultados al hacer click fuera
        document.addEventListener("click", (e) => {
            if (!searchResults.contains(e.target) && e.target !== productSearch) {
                searchResults.hidden = true;
            }
        });

        addButton?.addEventListener("click", () => {
            const productId = Number(productSelector.value);
            const row = rows.find(candidate => Number(candidate.dataset.productId) === productId);
            if (!row) return;
            const quantity = Math.max(1, Math.floor(Number(document.getElementById("cantidadAgregar").value) || 1));
            
            getQuantity(row).value = quantity;
            getSelection(row).checked = true;
            const priceInput = getPrice(row);
            if (!priceInput.value || parseFloat(priceInput.value) <= 0) {
                priceInput.value = (Number(row.dataset.cost) || 0).toFixed(2);
            }
            
            updateTotals();
            
            // Limpiar selección
            productSelector.value = "";
            productSearch.value = "";
            document.getElementById("cantidadAgregar").value = "1";
            updateSelectedProductDisplay(null);
            searchResults.hidden = true;
        });

        const updateTotals = () => {
            let subtotal = 0;
            let totalCost = 0;
            const selectedProducts = [];
            let displayIndex = 1;

            rows.forEach((row) => {
                const selected = getSelection(row);
                if (selected.checked) {
                    row.classList.remove("d-none");
                    row.querySelector("[data-row-number]").textContent = displayIndex++;
                    const quantity = Math.max(1, Math.floor(Number(getQuantity(row).value) || 1));
                    const cost = Number(row.dataset.cost) || 0;
                    const priceInput = getPrice(row);
                    let unitPrice = parseFloat(priceInput.value);
                    
                    if (isNaN(unitPrice) || unitPrice < cost) {
                        unitPrice = cost;
                    }

                    const lineSubtotal = Math.round((unitPrice * quantity + Number.EPSILON) * 100) / 100;
                    row.querySelector("[data-line-subtotal]").textContent = formatAmount(lineSubtotal);

                    // Margen de ítem
                    const marginBadge = getMarginBadge(row);
                    if (marginBadge) {
                        const itemMargin = cost > 0 ? ((unitPrice - cost) / cost) * 100 : 0;
                        const marginFormatted = itemMargin % 1 === 0 ? `+${itemMargin.toFixed(0)}% margen` : `+${itemMargin.toFixed(1)}% margen`;
                        marginBadge.textContent = unitPrice > cost ? marginFormatted : (unitPrice === cost ? "+0% margen" : "0% margen");
                        if (getMarginInput(row)) {
                            getMarginInput(row).value = itemMargin.toFixed(2);
                        }
                    }

                    subtotal += lineSubtotal;
                    totalCost += cost * quantity;
                    selectedProducts.push({ 
                        id: Number(row.dataset.productId), 
                        quantity, 
                        price: unitPrice 
                    });
                } else {
                    row.classList.add("d-none");
                }
            });

            subtotal = Math.round((subtotal + Number.EPSILON) * 100) / 100;
            const igv = Math.round((subtotal * 0.18 + Number.EPSILON) * 100) / 100;
            const total = Math.round((subtotal + igv + Number.EPSILON) * 100) / 100;
            
            // Margen global estimado
            const totalProfit = Math.round((subtotal - totalCost + Number.EPSILON) * 100) / 100;
            const globalMarginPct = totalCost > 0 ? Math.round(((totalProfit / totalCost) * 100 + Number.EPSILON) * 10) / 10 : 0;
            const globalMarginElem = document.getElementById("margenEstimadoCotizacion");
            if (globalMarginElem) {
                globalMarginElem.textContent = `+${globalMarginPct.toFixed(1)}% (${formatAmount(totalProfit)})`;
            }

            document.getElementById("subtotalCotizacion").textContent = formatAmount(subtotal);
            document.getElementById("igvCotizacion").textContent = formatAmount(igv);
            document.getElementById("totalCotizacion").textContent = formatAmount(total);
            document.getElementById("cantidadProductos").textContent = String(selectedProducts.length);
            
            if (emptyLines) {
                if (selectedProducts.length > 0) emptyLines.classList.add("d-none");
                else emptyLines.classList.remove("d-none");
            }
            sessionStorage.setItem(storageKey, JSON.stringify(selectedProducts));
        };

        const onPriceInput = (row) => {
            const priceInput = getPrice(row);
            const costBase = Number(row.dataset.cost) || 0;
            const currentVal = parseFloat(priceInput.value);
            const qty = Math.max(1, Math.floor(Number(getQuantity(row).value) || 1));
            const effectivePrice = !isNaN(currentVal) && currentVal >= costBase ? currentVal : costBase;
            
            const lineSubtotal = Math.round((effectivePrice * qty + Number.EPSILON) * 100) / 100;
            row.querySelector("[data-line-subtotal]").textContent = formatAmount(lineSubtotal);

            const marginBadge = getMarginBadge(row);
            if (marginBadge) {
                const itemMargin = costBase > 0 ? ((effectivePrice - costBase) / costBase) * 100 : 0;
                const marginText = itemMargin % 1 === 0 ? `+${itemMargin.toFixed(0)}% margen` : `+${itemMargin.toFixed(1)}% margen`;
                marginBadge.textContent = effectivePrice > costBase ? marginText : (effectivePrice === costBase ? "+0% margen" : "0% margen");
                if (getMarginInput(row)) {
                    getMarginInput(row).value = itemMargin.toFixed(2);
                }
            }

            updateTotals();
        };

        const onPriceBlurOrChange = (row) => {
            const priceInput = getPrice(row);
            const costBase = Number(row.dataset.cost) || 0;
            let val = parseFloat(priceInput.value);
            
            if (isNaN(val) || val < costBase) {
                priceInput.value = costBase.toFixed(2);
                showPriceAlert("El precio cotizado no puede ser menor al costo base registrado");
                priceInput.classList.add("is-invalid");
                setTimeout(() => priceInput.classList.remove("is-invalid"), 2500);
            } else {
                priceInput.value = val.toFixed(2);
            }
            updateTotals();
        };

        rows.forEach((row) => {
            getSelection(row).addEventListener("change", updateTotals);
            getQuantity(row).addEventListener("input", updateTotals);
            
            const priceInput = getPrice(row);
            if (priceInput) {
                priceInput.addEventListener("input", () => onPriceInput(row));
                priceInput.addEventListener("change", () => onPriceBlurOrChange(row));
                priceInput.addEventListener("blur", () => onPriceBlurOrChange(row));
            }

            row.querySelector("[data-remove-product]").addEventListener("click", () => {
                getSelection(row).checked = false;
                updateTotals();
            });
        });

        document.getElementById("limpiarProductos")?.addEventListener("click", () => {
            rows.forEach((row) => {
                getSelection(row).checked = false;
                getQuantity(row).value = "1";
                const costBase = Number(row.dataset.cost) || 0;
                getPrice(row).value = costBase.toFixed(2);
            });
            if (productSearch) productSearch.value = "";
            if (productSelector) productSelector.value = "";
            if (document.getElementById("cantidadAgregar")) document.getElementById("cantidadAgregar").value = "1";
            updateSelectedProductDisplay(null);
            updateTotals();
        });

        document.getElementById("formCotizacion")?.addEventListener("submit", (e) => {
            let hasInvalidPrice = false;
            rows.forEach(row => {
                if (getSelection(row).checked) {
                    const cost = Number(row.dataset.cost) || 0;
                    const price = parseFloat(getPrice(row).value);
                    if (isNaN(price) || price < cost) {
                        hasInvalidPrice = true;
                        getPrice(row).value = cost.toFixed(2);
                    }
                }
            });

            if (hasInvalidPrice) {
                e.preventDefault();
                showPriceAlert("El precio cotizado no puede ser menor al costo base registrado");
                updateTotals();
                return false;
            }
        });

        updateTotals();
        if (document.getElementById("formCotizacion").dataset.cotizacionGuardada === "true") {
            sessionStorage.removeItem(storageKey);
        }
    })();
</script>

<!-- Select2 CDN para selector de productos con imágenes -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<style>
    .select2-container--default .select2-selection--single {
        height: 46px;
        padding: 8px 12px;
        border: 1px solid var(--border-input);
        border-radius: 8px;
        display: flex;
        align-items: center;
    }
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 44px;
        right: 10px;
    }
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: normal;
        padding-left: 0;
        display: flex;
        align-items: center;
    }
    .select2-result-product {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .select2-result-product img {
        width: 32px;
        height: 32px;
        object-fit: contain;
        border-radius: 4px;
        background: #fff;
        border: 1px solid var(--border-light);
    }
</style>
<script>
    $(document).ready(function() {
        function formatProduct (product) {
            if (!product.id) { return product.text; }
            var row = document.querySelector(`[data-product-id='${product.id}']`);
            var imgSrc = row ? (row.dataset.img || row.querySelector("img")?.src || "") : "";
            var $product = $(
                '<div class="select2-result-product">' +
                '<img src="' + imgSrc + '" onerror="this.style.display=\'none\'" />' +
                '<span>' + product.text + '</span>' +
                '</div>'
            );
            return $product;
        };

        $('#selectorProducto').select2({
            templateResult: formatProduct,
            templateSelection: formatProduct,
            width: '100%',
            placeholder: 'Selecciona un producto del catálogo'
        }).on('select2:select', function (e) {
            // Trigger native change event so existing JS picks it up
            this.dispatchEvent(new Event('change'));
        });
    });
</script>
