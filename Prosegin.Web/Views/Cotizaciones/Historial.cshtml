@model Prosegin.Web.ViewModels.Cotizaciones.HistorialViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Historial de cotizaciones y compras";
    var culture = CultureInfo.GetCultureInfo("es-PE");
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Historial de cotizaciones y compras</h1>
            <p class="text-muted mb-0">Consulta operaciones anteriores por cliente o número de documento.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="material-symbols-outlined align-middle">arrow_back</i>
            Volver a Cotizaciones
        </a>
    </div>

    <form asp-action="Historial" method="get" class="row g-2 mb-4">
        <div class="col-md-8 col-lg-6">
            <label for="busquedaHistorial" class="visually-hidden">Nombre de cliente o número de documento</label>
            <input id="busquedaHistorial" name="busqueda" value="@Model.Busqueda" class="form-control"
                   placeholder="Nombre del cliente o número de documento" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
        @if (!string.IsNullOrEmpty(Model.Busqueda))
        {
            <div class="col-auto">
                <a asp-action="Historial" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        }
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert @(Model.TotalRegistros == 0 ? "alert-info" : "alert-warning")" role="status">@Model.Mensaje</div>
    }

    @if (Model.Registros.Count > 0)
    {
        <div class="text-muted small mb-2">
            Mostrando @Model.Registros.Count de @Model.TotalRegistros registros
        </div>
        <div class="table-responsive bg-white border rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Documento</th>
                        <th>Tipo</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th class="text-end">Monto</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registro in Model.Registros)
                    {
                        <tr>
                            <td>
                                <strong>@registro.NumeroDocumento</strong>
                                <div class="small text-muted">RUC @registro.NumeroDocumentoCliente</div>
                            </td>
                            <td>@registro.Tipo</td>
                            <td>
                                @registro.Cliente
                                @if (registro.Tipo == "Compra")
                                {
                                    <div class="small text-muted">Pedido @registro.NumeroPedido</div>
                                }
                            </td>
                            <td>@registro.Fecha.ToLocalTime().ToString("dd/MM/yyyy", culture)</td>
                            <td class="text-end">@registro.Total.ToString("C", culture)</td>
                            <td>@registro.Estado</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="DetalleHistorial"
                                   asp-route-tipo="@(registro.Tipo == "Cotización" ? "Cotizacion" : "Compra")"
                                   asp-route-id="@registro.Id"
                                   asp-route-busqueda="@Model.Busqueda"
                                   asp-route-pagina="@Model.Pagina"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Visualizar"
                                   aria-label="Visualizar @registro.NumeroDocumento">
                                    <i class="material-symbols-outlined">visibility</i>
                                </a>
                                <a asp-action="DescargarHistorial"
                                   asp-route-tipo="@(registro.Tipo == "Cotización" ? "Cotizacion" : "Compra")"
                                   asp-route-id="@registro.Id"
                                   asp-route-busqueda="@Model.Busqueda"
                                   asp-route-pagina="@Model.Pagina"
                                   class="btn btn-sm btn-outline-secondary"
                                   title="Descargar PDF"
                                   aria-label="Descargar PDF de @registro.NumeroDocumento">
                                    <i class="material-symbols-outlined">download</i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPaginas > 1)
        {
            <nav class="mt-3" aria-label="Paginación del historial">
                <ul class="pagination justify-content-end">
                    @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                    {
                        <li class="page-item @(pagina == Model.Pagina ? "active" : "")">
                            <a class="page-link" asp-action="Historial" asp-route-busqueda="@Model.Busqueda" asp-route-pagina="@pagina">@pagina</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
