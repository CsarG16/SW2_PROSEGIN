@model Prosegin.Web.ViewModels.Pedidos.FacturaPreviewViewModel
@using System.Globalization

@{
    ViewData["Title"] = $"Factura Electrónica: {Model.NumeroPedido}";
    var urlVolver = Url.Action("Index", "Pedidos", new
    {
        termino = Model.NumeroPedido,
        estado = "ALL",
        abrirDetalle = Model.NumeroPedido
    });
    var facturaCodigo = $"{Model.Serie}-{Model.Numero.ToString("D8")}";
}

@functions {
    public static string NumeroALetras(decimal numero)
    {
        long entero = (long)Math.Floor(numero);
        int decimales = (int)Math.Round((numero - entero) * 100);
        string letras = ConvertirNumero(entero);
        return $"{letras} Y {decimales:D2}/100".ToUpperInvariant();
    }

    private static string ConvertirNumero(long n)
    {
        if (n == 0) return "CERO";
        if (n < 0) return "MENOS " + ConvertirNumero(-n);
        if (n <= 20)
        {
            string[] unidades = {
                "", "UN", "DOS", "TRES", "CUATRO", "CINCO", "SEIS", "SIETE", "OCHO", "NUEVE", "DIEZ",
                "ONCE", "DOCE", "TRECE", "CATORCE", "QUINCE", "DIECISÉIS", "DIECISIETE", "DIECIOCHO", "DIECINUEVE", "VEINTE"
            };
            return unidades[n];
        }
        if (n < 30) return "VEINTI" + ConvertirNumero(n - 20);
        if (n < 100)
        {
            string[] decenas = { "", "", "", "TREINTA", "CUARENTA", "CINCUENTA", "SESENTA", "SETENTA", "OCHENTA", "NOVENTA" };
            return decenas[n / 10] + (n % 10 > 0 ? " Y " + ConvertirNumero(n % 10) : "");
        }
        if (n == 100) return "CIEN";
        if (n < 200) return "CIENTO " + ConvertirNumero(n - 100);
        if (n < 1000)
        {
            string[] centenas = { "", "", "DOSCIENTOS", "TRESCIENTOS", "CUATROCIENTOS", "QUINIENTOS", "SEISCIENTOS", "SETECIENTOS", "OCHOCIENTOS", "NOVECIENTOS" };
            return centenas[n / 100] + (n % 100 > 0 ? " " + ConvertirNumero(n % 100) : "");
        }
        if (n == 1000) return "MIL";
        if (n < 2000) return "MIL " + ConvertirNumero(n % 1000);
        if (n < 1000000)
        {
            return ConvertirNumero(n / 1000) + " MIL" + (n % 1000 > 0 ? " " + ConvertirNumero(n % 1000) : "");
        }
        if (n == 1000000) return "UN MILLÓN";
        if (n < 2000000) return "UN MILLÓN " + ConvertirNumero(n % 1000000);
        return ConvertirNumero(n / 1000000) + " MILLONES" + (n % 1000000 > 0 ? " " + ConvertirNumero(n % 1000000) : "");
    }
}

<div class="container-fluid py-4">
    <!-- 1. Encabezado de la Factura Electrónica (Identidad Fiscal) -->
    <div class="prosegin-card p-3 p-md-4 mb-3">
        <!-- Barra de navegación y estado -->
        <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom flex-wrap gap-2" style="border-color: var(--border-card, #e2e8f0) !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="badge-status badge-status-success">
                    <span class="status-dot"></span> LISTO PARA FACTURAR
                </span>
                <span class="badge" style="background: var(--accent-light, #fef3c7); color: var(--accent-text, #b45309); font-weight: 700; font-size: 0.8rem; border: 1px solid rgba(245, 158, 11, 0.4);">
                    PREVISUALIZACIÓN TRIBUTARIA
                </span>
            </div>
            <a href="@urlVolver" class="btn-prosegin-secondary">
                <i class="material-symbols-outlined">arrow_back</i> Regresar
            </a>
        </div>

        <!-- Encabezado Estilo Comprobante Fiscal -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
            <!-- Emisor -->
            <div class="d-flex align-items-start gap-3">
                <img src="~/logo_horizontal.png" alt="PROSEGIN Prevención Integral" style="height: 52px; object-fit: contain;" />
                <div class="border-start ps-3 small text-muted" style="border-color: #cbd5e1 !important; line-height: 1.4;">
                    <div class="fw-bold text-dark fs-6">PROSEGIN PREVENCIÓN INTEGRAL S.A.C.</div>
                    <div>Distribución y Gestión Técnica de Equipos de Protección Individual (EPP)</div>
                    <div>Av. Los Industriales 450, Urb. Industrial Vulcano, Ate - Lima</div>
                    <div>Central Telefónica: (01) 640-9200 | Email: contacto@prosegin.pe</div>
                </div>
            </div>

            <!-- Recuadro Fiscal RUC / Tipo / Serie-Número -->
            <div class="fiscal-document-box text-center shadow-sm">
                <div class="fiscal-box-header">R.U.C. 20601234567</div>
                <div class="fiscal-box-title">FACTURA ELECTRÓNICA</div>
                <div class="fiscal-box-number">@facturaCodigo</div>
            </div>
        </div>
    </div>

    <!-- 2. Tarjeta Amarilla de Resumen Comercial y Fiscal -->
    <div class="prosegin-card p-3 p-md-4 mb-3" style="background: #fffbeb; border: 1.5px solid rgba(245, 158, 11, 0.4); border-left: 5px solid var(--accent, #f59e0b);">
        <div class="row g-3">
            <!-- Datos del Cliente -->
            <div class="col-md-7 border-end-md" style="border-color: rgba(245, 158, 11, 0.3) !important;">
                <div class="mb-2">
                    <span class="text-uppercase fw-bold d-block" style="font-size: 0.72rem; color: #b45309; letter-spacing: 0.04em;">
                        Cliente / Señor(es):
                    </span>
                    <span class="fw-bold fs-6 text-dark">@Model.ClienteRazonSocial</span>
                </div>
                <div class="mb-2">
                    <span class="text-uppercase fw-bold d-block" style="font-size: 0.72rem; color: #b45309; letter-spacing: 0.04em;">
                        R.U.C.:
                    </span>
                    <span class="fw-bold font-monospace text-dark fs-6">@Model.ClienteRuc</span>
                </div>
                <div>
                    <span class="text-uppercase fw-bold d-block" style="font-size: 0.72rem; color: #b45309; letter-spacing: 0.04em;">
                        Dirección Fiscal:
                    </span>
                    <span class="small fw-semibold text-dark">@Model.DireccionFiscal</span>
                </div>
            </div>

            <!-- Metadatos de la Venta -->
            <div class="col-md-5 ps-md-4 small">
                <div class="d-flex justify-content-between py-1 border-bottom" style="border-color: rgba(245, 158, 11, 0.25) !important;">
                    <span class="fw-bold" style="color: #b45309;">N.° COTIZACIÓN / PEDIDO:</span>
                    <span class="fw-bold text-dark font-monospace">@Model.NumeroPedido</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.NumeroOrdenCompra))
                {
                    <div class="d-flex justify-content-between py-1 border-bottom" style="border-color: rgba(245, 158, 11, 0.25) !important;">
                        <span class="fw-bold" style="color: #b45309;">ORDEN DE COMPRA:</span>
                        <span class="fw-semibold text-dark">@Model.NumeroOrdenCompra</span>
                    </div>
                }
                <div class="d-flex justify-content-between py-1 border-bottom" style="border-color: rgba(245, 158, 11, 0.25) !important;">
                    <span class="fw-bold" style="color: #b45309;">FECHA EMISIÓN:</span>
                    <span class="fw-semibold text-dark">@Model.FechaEmision.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom" style="border-color: rgba(245, 158, 11, 0.25) !important;">
                    <span class="fw-bold" style="color: #b45309;">FECHA VENCIMIENTO:</span>
                    <span class="fw-semibold text-dark">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom" style="border-color: rgba(245, 158, 11, 0.25) !important;">
                    <span class="fw-bold" style="color: #b45309;">MONEDA:</span>
                    <span class="fw-semibold text-dark">Soles (PEN - S/)</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="fw-bold" style="color: #b45309;">FORMA DE PAGO:</span>
                    <span class="badge" style="background: var(--accent-light, #fef3c7); color: var(--accent-text, #b45309); font-weight: 700; border: 1px solid rgba(245, 158, 11, 0.4);">
                        @Model.CondicionPago
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Tabla de Artículos Facturados -->
    <div class="prosegin-card overflow-hidden mb-3">
        <div class="prosegin-results-header">
            <div class="d-flex align-items-center gap-2">
                <span class="results-title">Detalle de Equipos de Protección Facturados</span>
                <span class="count-pill">@Model.Items.Count ítems</span>
            </div>
            <span class="results-note">Valores congelados según orden de venta aprobada</span>
        </div>

        <div class="table-responsive">
            <table class="prosegin-table mb-0" id="tablaFacturaItems">
                <thead>
                    <tr>
                        <th style="width: 60px;" class="text-center">ÍTEM</th>
                        <th style="width: 140px;">CÓDIGO SKU</th>
                        <th>DESCRIPCIÓN TÉCNICA EPP</th>
                        <th style="width: 90px;" class="text-center">U.M.</th>
                        <th class="text-end" style="width: 110px;">CANTIDAD</th>
                        <th class="text-end" style="width: 140px;">V. UNITARIO (S/)</th>
                        <th class="text-end" style="width: 150px;">SUBTOTAL (S/)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Count > 0)
                    {
                        var indice = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center text-muted small fw-semibold">@indice</td>
                                <td>
                                    <span class="font-monospace fw-semibold text-muted small">@item.Codigo</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Descripcion</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-muted border">@item.UnidadMedida</span>
                                </td>
                                <td class="text-end fw-bold font-monospace">
                                    @item.Cantidad.ToString("G29", CultureInfo.InvariantCulture)
                                </td>
                                <td class="text-end font-monospace text-dark">
                                    @item.PrecioUnitario.ToString("N2", CultureInfo.InvariantCulture)
                                </td>
                                <td class="text-end fw-bold font-monospace text-dark">
                                    @item.Subtotal.ToString("N2", CultureInfo.InvariantCulture)
                                </td>
                            </tr>
                            indice++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No se encontraron ítems para facturar.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 4. Sección Inferior: Importe en Letras, QR y Totales Tributarios -->
    <div class="prosegin-card p-3 p-md-4 mb-4">
        <div class="row g-4 align-items-start">
            <!-- Columna Izquierda: Importe en Letras y Verificación Digital -->
            <div class="col-lg-7">
                <!-- Caja Importe en Letras -->
                <div class="p-3 rounded-3 mb-3" style="background: #f8fafc; border: 1px solid var(--border-card, #e2e8f0);">
                    <span class="text-muted d-block text-uppercase fw-bold mb-1" style="font-size: 0.72rem; letter-spacing: 0.04em;">
                        Importe en Letras
                    </span>
                    <div class="fw-bold text-dark fs-6">
                        SON: @NumeroALetras(Model.Total) SOLES
                    </div>
                </div>

                <!-- Recuadro Digital / QR SUNAT -->
                <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background: #f8fafc; border: 1px solid var(--border-card, #e2e8f0);">
                    <div class="fiscal-qr-placeholder flex-shrink-0 d-flex flex-column align-items-center justify-content-center p-2 rounded border" style="background: #ffffff; width: 80px; height: 80px;">
                        <i class="material-symbols-outlined text-dark" style="font-size: 42px;">qr_code_2</i>
                        <span style="font-size: 9px; font-weight: 700; color: #64748b;">SUNAT</span>
                    </div>
                    <div class="small text-muted font-monospace" style="font-size: 0.75rem; line-height: 1.45;">
                        <div><strong class="text-dark">RUC:</strong> 20601234567 | <strong class="text-dark">COMPROBANTE:</strong> 01 (FACTURA)</div>
                        <div><strong class="text-dark">SERIE-NÚMERO:</strong> @facturaCodigo</div>
                        <div><strong class="text-dark">IGV:</strong> S/ @Model.Igv.ToString("N2", CultureInfo.InvariantCulture) | <strong class="text-dark">TOTAL:</strong> S/ @Model.Total.ToString("N2", CultureInfo.InvariantCulture)</div>
                        <div class="text-warning-emphasis"><i class="material-symbols-outlined align-middle" style="font-size: 14px;">verified</i> HASH: Pendiente de firma y envío digital a SUNAT</div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Totales Liquidación -->
            <div class="col-lg-5">
                <div class="p-3 rounded-3" style="background: #f8fafc; border: 1px solid var(--border-card, #e2e8f0);">
                    <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #e2e8f0 !important;">
                        <span class="text-muted fw-semibold">Op. Gravada / Subtotal:</span>
                        <strong class="font-monospace text-dark fs-6">S/ @Model.Subtotal.ToString("N2", CultureInfo.InvariantCulture)</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #e2e8f0 !important;">
                        <span class="text-muted fw-semibold">Op. Exonerada:</span>
                        <span class="font-monospace text-muted">S/ 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #e2e8f0 !important;">
                        <span class="text-muted fw-semibold">Op. Inafecta:</span>
                        <span class="font-monospace text-muted">S/ 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: #e2e8f0 !important;">
                        <span class="text-muted fw-semibold">I.G.V. (18.00%):</span>
                        <strong class="font-monospace text-dark fs-6">S/ @Model.Igv.ToString("N2", CultureInfo.InvariantCulture)</strong>
                    </div>
                    <div class="d-flex justify-content-between pt-3 mt-1 align-items-center">
                        <span class="fw-bold fs-5 text-dark">Importe Total:</span>
                        <span class="fw-extrabold fs-4 font-monospace" style="color: var(--accent-text, #b45309);">
                            S/ @Model.Total.ToString("N2", CultureInfo.InvariantCulture)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Barra de Acciones Final -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 pt-4 mt-4 border-top" style="border-color: var(--border-card, #e2e8f0) !important;">
            <a href="@urlVolver" class="btn-prosegin-secondary btn-lg" id="btnRegresarFactura">
                <i class="material-symbols-outlined">arrow_back</i> Regresar
            </a>

            <form id="facturaForm" onsubmit="event.preventDefault(); emitirFactura();">
                @Html.AntiForgeryToken()
                <input type="hidden" id="numeroPedido" name="numeroPedido" value="@Model.NumeroPedido" />
                <button type="submit" class="btn-prosegin-primary btn-lg" id="btnConfirmarFactura">
                    <i class="material-symbols-outlined" id="btnIcon">bolt</i>
                    <span id="btnText">EMITIR FACTURA ELECTRÓNICA</span>
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .fiscal-document-box {
        border: 2px solid #0f1b2b;
        border-radius: 8px;
        min-width: 260px;
        background: #ffffff;
        overflow: hidden;
    }
    .fiscal-box-header {
        font-weight: 800;
        font-size: 0.95rem;
        padding: 6px 12px;
        color: #0f1b2b;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    .fiscal-box-title {
        background: #0f1b2b;
        color: #ffffff;
        font-weight: 800;
        font-size: 0.88rem;
        letter-spacing: 0.05em;
        padding: 8px 12px;
        text-transform: uppercase;
    }
    .fiscal-box-number {
        font-weight: 800;
        font-family: monospace;
        font-size: 1.15rem;
        padding: 8px 12px;
        color: #0f1b2b;
    }
    .spin-animation {
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }
</style>

@section Scripts {
    <script>
        const emitirFacturaUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("EmitirFactura", "Pedidos")));
        const urlRetorno = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(urlVolver));

        async function emitirFactura() {
            const button = document.getElementById('btnConfirmarFactura');
            const btnIcon = document.getElementById('btnIcon');
            const btnText = document.getElementById('btnText');
            const btnRegresar = document.getElementById('btnRegresarFactura');
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Bloqueo de acciones y animación de carga requerida
            button.disabled = true;
            btnRegresar.classList.add('disabled');
            btnIcon.textContent = 'sync';
            btnIcon.classList.add('spin-animation');
            btnText.textContent = 'ENVIANDO A SUNAT...';

            try {
                const body = new URLSearchParams({
                    numeroPedido: document.getElementById('numeroPedido').value,
                    __RequestVerificationToken: token
                });

                const response = await fetch(emitirFacturaUrl, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: body
                });

                const result = await response.json();

                if (!response.ok || !result.exito) {
                    const msg = result.mensaje || 'No se pudo emitir la factura electrónica. Intente nuevamente.';
                    if (window.ProseginToast) {
                        ProseginToast.error(msg, 'Error en Emisión');
                    } else {
                        alert(msg);
                    }
                    restaurarBoton();
                    return;
                }

                // 1. Notificación visual requerida por la HU
                if (window.ProseginToast) {
                    ProseginToast.success(
                        result.numeroFactura ? `Comprobante fiscal: ${result.numeroFactura}` : 'Factura aceptada por SUNAT.',
                        'Factura emitida con éxito'
                    );
                }

                // 2. Descarga automática inmediata del comprobante PDF requerida por la HU
                if (result.pdf) {
                    try {
                        const link = document.createElement('a');
                        link.href = result.pdf;
                        link.target = '_blank';
                        link.rel = 'noopener noreferrer';
                        link.download = `${result.numeroFactura || 'FacturaElectronica'}.pdf`;
                        document.body.appendChild(link);
                        link.click();
                        link.remove();
                    } catch (e) {
                        console.warn('Descarga automática de PDF bloqueada por el navegador:', e);
                    }
                }

                // 3. Redirección suave al detalle del pedido
                setTimeout(() => {
                    window.location.href = urlRetorno;
                }, 2000);

            } catch (err) {
                console.error(err);
                if (window.ProseginToast) {
                    ProseginToast.error('Ocurrió un error inesperado al conectar con el servicio.', 'Error de Conexión');
                } else {
                    alert('Error de conexión al emitir la factura.');
                }
                restaurarBoton();
            }

            function restaurarBoton() {
                button.disabled = false;
                btnRegresar.classList.remove('disabled');
                btnIcon.textContent = 'bolt';
                btnIcon.classList.remove('spin-animation');
                btnText.textContent = 'EMITIR FACTURA ELECTRÓNICA';
            }
        }
    </script>
}
