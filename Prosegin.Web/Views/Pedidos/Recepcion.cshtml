@model Prosegin.Web.ViewModels.Pedidos.RecepcionMercaderiaViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Control de Recepción";
    var itemsJson = JsonSerializer.Serialize(Model.Items);
}

<div class="recepcion-page">
    <div class="recepcion-heading">
        <h1>Validación y Recepción de Mercadería</h1>
        <span>OC: @Model.NumeroOrdenCompra</span>
    </div>
    <div class="recepcion-summary">
        <span><b>N° Pedido:</b> @Model.NumeroPedido</span>
        <span><b>Cliente:</b> @Model.Cliente</span>
        <span><b>Almacén:</b> @Model.Almacen</span>
        <span><b>Ítems Totales:</b> @Model.Items.Count Artículos EPP</span>
    </div>
    <div class="recepcion-document">
        <div class="document-code">SOC - EO - EPP - 04</div>
        <div class="document-title"><b>Sistema de Gestión de la Calidad</b><small>Control de Recepción de Productos Comprados</small></div>
        <div class="document-meta"><span>REV: <b>@Model.Revision.ToString("00")</b></span><span>FECHA: <b>@Model.FechaDocumento.ToString("dd/MM/yyyy")</b></span><span>DOC. REF: <b>@Model.DocumentoReferencia</b></span></div>
    </div>
    <div class="table-responsive recepcion-table-wrap">
        <table class="recepcion-table">
            <thead>
                <tr><th>N°</th><th>ÍTEM / DESCRIPCIÓN TÉCNICA EPP</th><th>PROVEEDOR</th><th>CANT.<br />SOLICITADA</th><th>CANT.<br />RECIBIDA</th><th>ESTADO<br />INSPECCIÓN</th><th>OBSERVACIONES /<br />INCIDENCIAS</th><th></th></tr>
            </thead>
            <tbody id="recepcionBody"></tbody>
        </table>
    </div>
    <div class="recepcion-footer">
        <div id="recepcionResumen" class="recepcion-legend"></div>
        <div class="recepcion-actions">
            <a asp-action="Index" class="btn-back">Volver al Pedido</a>
            <button type="button" class="btn-partial" id="guardarParcial">Guardar Recepción Parcial</button>
            <button type="button" class="btn-confirm" id="confirmarTotal">Confirmar Recepción Total</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
<style>
    .recepcion-page { width: 100%; max-width: none; margin: 0; color: #17233c; font-size: 14px; }
    .recepcion-heading { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
    .recepcion-heading h1 { font-size: 25px; margin: 0; font-weight: 700; }
    .recepcion-heading > span { color: #8793a7; background: #f2f5f9; border-radius: 5px; padding: 6px 10px; font-size: 13px; }
    .recepcion-summary, .recepcion-document { display: flex; align-items: center; border: 1px solid #e8edf4; border-radius: 8px; background: #fff; }
    .recepcion-summary { flex-wrap: wrap; gap: 32px; padding: 15px 18px; margin-bottom: 18px; color: #8090a7; }
    .recepcion-summary b, .document-title b { color: #243650; }
    .recepcion-document { min-height: 68px; margin-bottom: 0; padding: 12px 18px; gap: 18px; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
    .document-code { color: #f28a00; background: #fff4df; font-weight: 700; padding: 10px 12px; border-radius: 5px; }
    .document-title { min-width: 340px; display: flex; flex-direction: column; color: #25364e; }
    .document-title small { color: #8995a8; margin-top: 3px; }
    .document-meta { margin-left: auto; display: flex; gap: 28px; color: #8692a5; }
    .document-meta b { color: #35445c; }
    .recepcion-table-wrap { border: 1px solid #e8edf4; border-top: 0; }
    .recepcion-table { width: 100%; min-width: 1200px; border-collapse: collapse; table-layout: fixed; }
    .recepcion-table th { background: #f8fafc; color: #74839a; font-size: 11px; letter-spacing: .03em; text-align: left; padding: 14px 12px; border-bottom: 1px solid #e8edf4; }
    .recepcion-table td { padding: 15px 12px; border-bottom: 1px solid #edf1f5; vertical-align: middle; }
    .recepcion-table th:nth-child(1) { width: 42px; }.recepcion-table th:nth-child(2) { width: 230px; }.recepcion-table th:nth-child(3) { width: 145px; }.recepcion-table th:nth-child(4), .recepcion-table th:nth-child(5) { width: 82px; text-align: center; }.recepcion-table th:nth-child(6) { width: 94px; }.recepcion-table th:nth-child(7) { width: 160px; }.recepcion-table th:nth-child(8) { width: 52px; }
    .recepcion-table td:nth-child(4), .recepcion-table td:nth-child(5) { text-align: center; font-weight: 700; }
    .item-name { display: block; font-weight: 700; line-height: 1.3; }.item-sku { display: block; color: #8d99aa; font-size: 11px; margin-top: 4px; }.provider { color: #65748b; line-height: 1.3; }
    .received { width: 62px; height: 38px; margin: auto; text-align: center; border: 1px solid #e1e8f0; border-radius: 6px; background: #f7f9fb; padding: 6px 2px; font-size: 14px; font-weight: 700; }
    .estado { border: 0; border-radius: 14px; padding: 8px 10px; font-size: 12px; font-weight: 700; width: 100%; background: #e8f8f0; color: #1c9a6a; }
    .observacion { width: 100%; min-height: 38px; border: 1px solid #e5eaf1; border-radius: 6px; padding: 8px; font-size: 12px; }
    .recepcion-row.ok { background: #fbfffd; }.recepcion-row.alerta { background: #fffdf6; }.recepcion-row.dano { background: #fff9fa; }
    .recepcion-row.alerta .estado { background: #fff2d6; color: #de9410; }.recepcion-row.dano .estado { background: #ffe5e9; color: #dc5b6b; }
    .estado-icon { text-align: center; color: #1baf79; font-weight: 700; white-space: nowrap; }.estado-icon.alert { color: #e8a51a; }
    .recepcion-footer { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 17px 14px; border: 1px solid #e8edf4; border-top: 0; border-radius: 0 0 8px 8px; }
    .recepcion-legend { display: flex; gap: 24px; color: #758398; }.legend-ok:before, .legend-alert:before, .legend-dano:before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }.legend-ok:before { background: #21b985; }.legend-alert:before { background: #eea71b; }.legend-dano:before { background: #ed6675; }
    .recepcion-actions { display: flex; align-items: center; gap: 12px; }.btn-back, .btn-partial, .btn-confirm { border: 1px solid #dfe5ec; border-radius: 6px; padding: 11px 16px; font-size: 13px; text-decoration: none; background: #fff; color: #526179; }.btn-confirm { color: #fff; background: #f59b0b; border-color: #f59b0b; font-weight: 700; }
    @@media (max-width: 850px) { .recepcion-heading h1 { font-size: 20px; }.document-meta { display: none; }.document-title { min-width: 0; }.recepcion-footer { align-items: stretch; flex-direction: column; }.recepcion-actions { justify-content: flex-end; flex-wrap: wrap; }.recepcion-summary { gap: 12px; } }
</style>
<script>
(() => {
    const items = @Html.Raw(itemsJson);
    const pedido = @Html.Raw(JsonSerializer.Serialize(Model.NumeroPedido));
    const body = document.getElementById('recepcionBody');
    const resumen = document.getElementById('recepcionResumen');
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    items.forEach((item, index) => {
        const row = document.createElement('tr');
        row.className = 'recepcion-row'; row.dataset.id = item.ProductoId;
        row.innerHTML = `<td>${String(index + 1).padStart(2, '0')}</td><td><span class="item-name">${item.Descripcion}</span><span class="item-sku">SKU: ${item.Codigo}</span></td><td class="provider">${item.Proveedor}</td><td>${item.CantidadSolicitada} ${item.UnidadMedida}</td><td><input type="number" min="0" max="${item.CantidadSolicitada}" value="${item.CantidadRecibida || 0}" class="received recibido"></td><td><select class="estado"><option>Pendiente</option><option>Conforme</option><option>Incompleto</option><option>Mercadería Dañada</option></select></td><td><input class="observacion" maxlength="500" placeholder="Registrar incidencia..." value="${item.Observaciones || ''}"></td><td class="estado-icon"></td>`;
        body.appendChild(row); row.querySelector('.estado').value = item.EstadoInspeccion || 'Pendiente';
        row.querySelectorAll('input, select').forEach(control => control.addEventListener('input', actualizarFila));
        actualizarFila({ target: row.querySelector('.estado') });
    });
    function actualizarFila(event) {
        const row = event.target.closest('tr'); const cantidad = Number(row.querySelector('.recibido').value);
        const item = items.find(value => value.ProductoId == row.dataset.id); const estado = row.querySelector('.estado').value;
        row.classList.toggle('ok', estado === 'Conforme' && cantidad === item.CantidadSolicitada); row.classList.toggle('alerta', estado === 'Incompleto'); row.classList.toggle('dano', estado === 'Mercadería Dañada');
        row.querySelector('.observacion').required = estado === 'Incompleto' || estado === 'Mercadería Dañada';
        const icon = row.querySelector('.estado-icon'); icon.className = 'estado-icon ' + (estado === 'Incompleto' ? 'alert' : ''); icon.textContent = estado === 'Conforme' && cantidad === item.CantidadSolicitada ? '✓ OK' : estado === 'Incompleto' ? '⚠ -' + (item.CantidadSolicitada - cantidad) : estado === 'Mercadería Dañada' ? '⚠ Daño' : ''; actualizarResumen();
    }
    function actualizarResumen() {
        const rows = [...body.querySelectorAll('tr')]; const counts = { ok: 0, alerta: 0, dano: 0 };
        rows.forEach(row => { if (row.classList.contains('ok')) counts.ok++; if (row.classList.contains('alerta')) counts.alerta++; if (row.classList.contains('dano')) counts.dano++; });
        resumen.innerHTML = `<span class="legend-ok">Conformes: ${counts.ok} ítems</span><span class="legend-alert">Incompletos: ${counts.alerta} ítem${counts.alerta === 1 ? '' : 's'}</span><span class="legend-dano">Observados: ${counts.dano} ítem${counts.dano === 1 ? '' : 's'}</span>`;
    }
    async function guardar(confirmarTotal) {
        const data = { numeroPedido: pedido, confirmarTotal, items: [...body.querySelectorAll('tr')].map(row => ({ productoId: Number(row.dataset.id), cantidadRecibida: Number(row.querySelector('.recibido').value), estadoInspeccion: row.querySelector('.estado').value, observaciones: row.querySelector('.observacion').value })) };
        const response = await fetch('@Url.Action("GuardarRecepcion", "Pedidos")', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token }, body: JSON.stringify(data) });
        const result = await response.json(); if (!response.ok) { window.ProseginToast?.error(result.mensaje); return; } window.ProseginToast?.success(result.mensaje); if (confirmarTotal) window.location.href = '@Url.Action("Index", "Pedidos")';
    }
    document.getElementById('guardarParcial').addEventListener('click', () => guardar(false)); document.getElementById('confirmarTotal').addEventListener('click', () => guardar(true));
})();
</script>
