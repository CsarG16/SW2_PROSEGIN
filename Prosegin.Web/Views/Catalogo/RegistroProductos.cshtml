@model Prosegin.Web.ViewModels.Catalogo.ProductoCreateViewModel

@{
    ViewData["Title"] = "Registrar Nuevo Producto EPP";
}

<div class="container-fluid px-0">
    <!-- 1. ENCABEZADO / BREADCRUMB CARD (Diseño Figma) -->
    <div class="prosegin-card mb-4 p-3 p-md-4">
        <div class="mb-1 text-muted small" style="font-size: 0.82rem;">
            <a asp-controller="Catalogo" asp-action="Index" class="text-decoration-none text-muted">Catálogo de EPP</a>
            <i class="bi bi-chevron-right mx-1" style="font-size: 0.72rem;"></i>
            <span class="text-secondary fw-semibold">Registrar Nuevo Producto</span>
        </div>
        <h1 class="fw-bold text-dark mb-0" style="font-size: 1.25rem; letter-spacing: -0.01em;">
            Alta técnica y comercial de equipos de protección personal
        </h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
                <strong class="d-block">¡Registro Exitoso!</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Catalogo" asp-action="RegistroProductos" method="post" enctype="multipart/form-data" id="formRegistroProducto" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

        <!-- 2. CARD 1: INFORMACIÓN GENERAL Y CÓDIGO IDENTIFICADOR -->
        <div class="prosegin-card mb-4 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center py-3 px-4 border-bottom bg-white">
                <span class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 0.92rem;">
                    <i class="bi bi-shield text-muted"></i> Información General y Código Identificador
                </span>
                <span class="text-muted small fst-italic" style="font-size: 0.8rem;">*obligatorios</span>
            </div>

            <div class="p-3 p-md-4">
                <!-- Fila 1: SKU y Nombre del EPP -->
                <div class="row g-3 mb-3">
                    <!-- Código SKU -->
                    <div class="col-md-5">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Sku" class="form-label-prosegin small text-uppercase fw-bold mb-0">
                                CÓDIGO SKU <span class="text-danger">*</span>
                            </label>
                            <span class="text-muted" style="font-size: 0.75rem;">Hasta 50 caracteres</span>
                        </div>
                        <div class="position-relative">
                            <input asp-for="Sku" id="txtSku" class="form-control form-control-prosegin font-monospace text-uppercase pe-5"
                                   placeholder="EPP-CAS-0042" maxlength="50" autocomplete="off" />
                            <span id="skuCheckIcon" class="position-absolute end-0 top-50 translate-middle-y me-3 d-none">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            </span>
                        </div>
                        <div class="mt-1 small text-muted" style="font-size: 0.78rem;" id="skuHelperText">
                            <i class="bi bi-info-circle me-1"></i> Código único alfanumérico. Si ya existe, mostrará: <em class="text-secondary">"El código SKU ya se encuentra registrado"</em>
                        </div>
                        <span asp-validation-for="Sku" class="text-danger small d-block"></span>
                    </div>

                    <!-- Nombre o Descripción -->
                    <div class="col-md-7">
                        <label asp-for="Nombre" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            NOMBRE O DESCRIPCIÓN DEL EPP <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Nombre" id="txtNombre" class="form-control form-control-prosegin"
                               placeholder="Casco de Seguridad Dieléctrico Tipo 1 Clase E con Barboquejo" autocomplete="off" />
                        <span asp-validation-for="Nombre" class="text-danger small d-block"></span>
                    </div>
                </div>

                <!-- Fila 2: Categoría, Marca y Unidad de Medida -->
                <div class="row g-3">
                    <!-- Categoría -->
                    <div class="col-md-5">
                        <label asp-for="Categoria" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            CATEGORÍA / TIPO DE PROTECCIÓN <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Categoria" id="ddlCategoria" class="form-select form-control-prosegin">
                            <option value="">-- Seleccione una categoría --</option>
                            <option value="Protección Craneal / Cascos">Protección Craneal / Cascos</option>
                            <option value="Protección Auditiva">Protección Auditiva</option>
                            <option value="Protección Visual y Facial">Protección Visual y Facial</option>
                            <option value="Protección Respiratoria">Protección Respiratoria</option>
                            <option value="Protección Manual / Guantes">Protección Manual / Guantes</option>
                            <option value="Calzado de Seguridad">Calzado de Seguridad</option>
                            <option value="Protección Corporal / Ropa">Protección Corporal / Ropa</option>
                            <option value="Trabajo en Altura">Trabajo en Altura</option>
                        </select>
                        <span asp-validation-for="Categoria" class="text-danger small d-block"></span>
                    </div>

                    <!-- Marca / Fabricante -->
                    <div class="col-md-4">
                        <label asp-for="Marca" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            MARCA / FABRICANTE <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Marca" id="ddlMarca" class="form-select form-control-prosegin">
                            <option value="MSA Safety" selected>MSA Safety</option>
                            <option value="3M">3M</option>
                            <option value="Steelpro">Steelpro</option>
                            <option value="Ansell">Ansell</option>
                            <option value="Bata Industrials">Bata Industrials</option>
                            <option value="Caterpillar (CAT)">Caterpillar (CAT)</option>
                            <option value="Showa">Showa</option>
                            <option value="Hawk">Hawk</option>
                            <option value="KleenGuard">KleenGuard</option>
                            <option value="Generico / Nacional">Genérico / Nacional</option>
                        </select>
                    </div>

                    <!-- Unidad de Medida -->
                    <div class="col-md-3">
                        <label asp-for="UnidadMedida" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            UNIDAD DE MEDIDA <span class="text-danger">*</span>
                        </label>
                        <select asp-for="UnidadMedida" id="ddlUnidad" class="form-select form-control-prosegin">
                            <option value="UND" selected>Unidad (UND)</option>
                            <option value="PAR">Par (PAR)</option>
                            <option value="CAJ">Caja (CAJ)</option>
                            <option value="PQT">Paquete (PQT)</option>
                            <option value="JGO">Juego (JGO)</option>
                        </select>
                        <span asp-validation-for="UnidadMedida" class="text-danger small d-block"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. CARD 2: COSTO BASE Y PROVEEDOR AUTORIZADO -->
        <div class="prosegin-card mb-4" style="overflow: visible;">
            <div class="d-flex justify-content-between align-items-center py-3 px-4 border-bottom bg-white">
                <span class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 0.92rem;">
                    <i class="bi bi-wallet2 text-dark"></i> Costo Base y Proveedores Autorizados
                </span>
                <span class="badge bg-light text-secondary border font-monospace px-2 py-1" style="font-size: 0.74rem;">
                    Compras JIT Las Malvinas
                </span>
            </div>

            <div class="p-3 p-md-4">
                <div class="row g-4 align-items-start">
                    <!-- Columna 1: Costo Base -->
                    <div class="col-md-5">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="CostoBaseAdquisicion" class="form-label-prosegin small text-uppercase fw-bold mb-0">
                                COSTO BASE (S/.) <span class="text-danger">*</span>
                            </label>
                            <span class="text-muted" style="font-size: 0.75rem;">Contado / Efectivo</span>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary fw-bold px-3">S/.</span>
                            <input asp-for="CostoBaseAdquisicion" id="txtCosto" type="number" step="0.01" min="0.01"
                                   class="form-control form-control-prosegin border-start-0 font-monospace fw-bold ps-1"
                                   placeholder="0.00" style="font-size: 1.05rem;" />
                        </div>
                        <span asp-validation-for="CostoBaseAdquisicion" class="text-danger small d-block mt-1"></span>

                    </div>

                    <!-- Columna 2: Proveedores Autorizados (Dropdown Multi-select) -->
                    <div class="col-md-7">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label-prosegin small text-uppercase fw-bold mb-0">
                                PROVEEDORES AUTORIZADOS <span class="text-danger">*</span>
                            </label>
                            <span class="text-muted" style="font-size: 0.75rem;" id="proveedoresContador">0 seleccionados</span>
                        </div>

                        <!-- Dropdown Multi-select Container -->
                        <div class="position-relative" id="proveedoresDropdownWrapper">
                            <!-- Trigger Button -->
                            <button type="button"
                                    class="form-control form-control-prosegin d-flex align-items-center justify-content-between text-start w-100 py-2 px-3 bg-white"
                                    id="btnDropdownProveedores"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                <span class="d-flex align-items-center gap-2 text-truncate" id="dropdownProveedoresText">
                                    <i class="bi bi-shop text-muted"></i>
                                    <span class="text-muted" id="dropdownPlaceholder">Seleccionar proveedores autorizados...</span>
                                </span>
                                <span class="d-flex align-items-center gap-2 flex-shrink-0 ms-2">
                                    <span class="badge rounded-pill bg-light text-dark border font-monospace px-2 py-1 d-none" id="proveedoresBadgeCount">0</span>
                                    <i class="bi bi-chevron-down text-muted" id="dropdownChevron" style="transition: transform 0.2s ease;"></i>
                                </span>
                            </button>

                            <!-- Menú flotante (No empuja la tarjeta hacia abajo) -->
                            <div id="proveedoresList"
                                 class="position-absolute start-0 end-0 bg-white border rounded-3 shadow-lg mt-1"
                                 style="display: none; z-index: 1050; border-color: #cbd5e1; box-shadow: 0 12px 28px rgba(11, 23, 39, 0.14);">

                                <!-- Buscador dentro del Dropdown -->
                                <div class="p-2 border-bottom bg-light bg-opacity-50">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                                        <input type="search" id="txtProveedorBusqueda" class="form-control form-control-sm border-start-0 ps-0 shadow-none"
                                               placeholder="Buscar por razón social o RUC..." autocomplete="off" />
                                    </div>
                                </div>

                                <!-- Lista scrollable de opciones -->
                                <div class="p-2" style="max-height: 210px; overflow-y: auto;" id="proveedoresItemsContainer">
                                    @foreach (var proveedor in Model.ProveedoresDisponibles)
                                    {
                                        <div class="proveedor-opcion d-flex align-items-center justify-content-between p-2 rounded-2 mb-1"
                                             data-busqueda="@proveedor.RazonSocial @proveedor.Ruc"
                                             style="cursor: pointer; transition: background-color 0.15s ease;">
                                            <div class="d-flex align-items-center gap-2 flex-grow-1 overflow-hidden">
                                                <input type="checkbox" name="ProveedorIds" value="@proveedor.Id"
                                                       class="form-check-input proveedor-check m-0"
                                                       data-nombre="@proveedor.RazonSocial"
                                                       data-ruc="@proveedor.Ruc"
                                                       checked="@(Model.ProveedorIds.Contains(proveedor.Id))" />
                                                <span class="small fw-semibold text-dark text-truncate">@proveedor.RazonSocial</span>
                                            </div>
                                            <span class="badge bg-light text-muted border font-monospace ms-2 flex-shrink-0" style="font-size: 0.72rem;">@proveedor.Ruc</span>
                                        </div>
                                    }
                                    <div id="proveedoresSinResultados" class="small text-muted p-3 text-center d-none">
                                        <i class="bi bi-search me-1"></i> No se encontraron proveedores que coincidan.
                                    </div>
                                </div>

                                <!-- Footer del Dropdown con botón Listo -->
                                <div class="p-2 border-top bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                                    <span class="small text-muted" id="proveedoresFooterCount" style="font-size: 0.75rem;">0 seleccionados</span>
                                    <button type="button" class="btn btn-sm btn-dark px-3 py-1 fw-bold text-white rounded-2" id="btnCerrarProveedores" style="background-color: #0B1727; font-size: 0.76rem;">
                                        Listo
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Etiquetas / Chips de Proveedores Seleccionados -->
                        <div id="proveedoresSeleccionados" class="d-flex flex-wrap gap-2 mt-2" aria-live="polite"></div>
                        <span asp-validation-for="ProveedorIds" id="proveedoresError" class="text-danger small d-block mt-1"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. CARD 3: FICHA TÉCNICA DEL FABRICANTE -->
        <div class="prosegin-card mb-4 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center py-3 px-4 border-bottom bg-white">
                <span class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 0.92rem;">
                    <i class="bi bi-file-earmark-text text-muted"></i> Ficha técnica del fabricante
                </span>
            </div>

            <div class="p-3 p-md-4">
                <!-- Input file oculto -->
                <input asp-for="FichaTecnica" type="file" id="txtFichaTecnica" class="d-none" accept=".pdf,application/pdf" />

                <!-- Dropzone Box -->
                <div id="dropzoneBox" class="pdf-dropzone p-4 text-center rounded-3 mb-3"
                     style="border: 2px dashed #cbd5e1; background-color: #f8fafc; cursor: pointer; transition: all 0.2s ease;">
                    <div class="d-flex flex-column align-items-center justify-content-center py-2">
                        <div class="p-2 rounded-3 bg-white border mb-2 shadow-sm d-flex align-items-center justify-content-center"
                             style="width: 44px; height: 44px;">
                            <i class="bi bi-file-earmark-arrow-up fs-4 text-dark"></i>
                        </div>
                        <div class="text-dark small mb-1" style="font-size: 0.88rem;">
                            Arrastrar archivo PDF aquí o <span class="text-dark fw-bold text-decoration-underline">explorar equipo</span>
                        </div>
                        <div class="text-muted" style="font-size: 0.78rem;">
                            Formato admitido: Solo PDF. Tamaño máximo: 5 MB
                        </div>
                    </div>
                </div>

                <!-- Selected File Preview Card (Se muestra tras seleccionar) -->
                <div id="boxFichaSeleccionada" class="d-none p-3 rounded-3 border bg-white d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded bg-danger-subtle text-danger d-flex align-items-center justify-content-center"
                             style="width: 44px; height: 44px; border-radius: 8px;">
                            <i class="bi bi-file-earmark-pdf-fill fs-3"></i>
                        </div>
                        <div>
                            <div class="small fw-bold text-muted mb-1">ARCHIVO CARGADO</div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-bold text-dark small" id="lblFichaNombre">FT_Archivo.pdf</span>
                                <span class="text-muted small" id="lblFichaTamano" style="font-size: 0.78rem;">(1.8 MB)</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-semibold px-2 py-1"
                                      style="font-size: 0.72rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i> ARCHIVO VALIDADO
                                </span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnQuitarFicha" title="Quitar archivo">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>

                <span asp-validation-for="FichaTecnica" id="fichaError" class="text-danger small d-block mt-2" role="alert"></span>
            </div>
        </div>

        <!-- 5. BARRA DE ACCIÓN INFERIOR (Diseño Figma) -->
        <div class="prosegin-card p-3 mb-5 bg-white border d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2" id="formStatusIndicator">
                <i class="bi bi-check-circle text-muted fs-5" id="statusIcon"></i>
                <span id="statusLabel" class="small text-muted fw-medium">
                    Complete todos los campos obligatorios (*) para guardar
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Catalogo" asp-action="Index" id="btnCancelar" class="btn btn-outline-secondary py-2 px-4 fw-semibold"
                   style="border-radius: 8px; font-size: 0.85rem;">
                    CANCELAR
                </a>
                <button type="submit" id="btnGuardarProducto" class="btn d-inline-flex align-items-center gap-2 py-2 px-4 fw-bold text-white"
                        style="background-color: #0c1524; border: 1px solid #0c1524; border-radius: 8px; font-size: 0.85rem;">
                    <i class="bi bi-floppy"></i> GUARDAR PRODUCTO EPP
                </button>
            </div>
        </div>
    </form>
</div>

<style>
    /* Estilos Prosegin para Dropdown Multi-Select de Proveedores - Cero hovers amarillos */
    #btnDropdownProveedores:hover {
        border-color: #94a3b8;
        background-color: #f8fafc;
    }
    #btnDropdownProveedores:focus {
        border-color: #0B1727 !important;
        box-shadow: 0 0 0 3px rgba(11, 23, 39, 0.12) !important;
    }
    .proveedor-opcion:hover {
        background-color: #f8fafc !important;
    }
    .proveedor-check:focus {
        box-shadow: 0 0 0 2px rgba(11, 23, 39, 0.15) !important;
        border-color: #0B1727 !important;
    }
    .proveedor-check:checked {
        background-color: #0B1727 !important;
        border-color: #0B1727 !important;
    }
    #txtProveedorBusqueda:focus {
        border-color: #0B1727 !important;
        box-shadow: none !important;
    }
    #proveedoresItemsContainer::-webkit-scrollbar {
        width: 6px;
    }
    #proveedoresItemsContainer::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
    }
    #proveedoresItemsContainer::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
    }
    #proveedoresItemsContainer::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registro-productos.js" asp-append-version="true"></script>
}
