@model Prosegin.Web.ViewModels.Catalogo.ProductoCreateViewModel
@using Prosegin.Data.Entities

@{
    ViewData["Title"] = "Registro de Productos EPP";
    var productosRegistrados = ViewBag.ProductosRegistrados as List<Producto> ?? new List<Producto>();
}

<div class="container-fluid px-0">
    <!-- Encabezado Principal del Registro -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1" style="letter-spacing: -0.01em;">
                <i class="bi bi-box-seam text-warning me-2"></i> REGISTRAR EQUIPO DE PROTECCIÓN PERSONAL (EPP)
            </h4>
            <p class="text-muted small mb-0">
                Complete la ficha técnica comercial y adjunte el archivo PDF homologado del fabricante para compras y cotizaciones corporativas.
            </p>
        </div>
        <a asp-controller="Catalogo" asp-action="Index" class="btn-prosegin-secondary">
            <i class="bi bi-grid-3x3-gap"></i> Ir al Catálogo EPP
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
                <strong class="d-block">¡Registro Exitoso!</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Catalogo" asp-action="RegistroProductos" method="post" enctype="multipart/form-data" id="formRegistroProducto" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: FORMULARIO PRINCIPAL -->
            <div class="col-lg-8">
                
                <!-- SECCIÓN 1: IDENTIFICACIÓN DEL PRODUCTO -->
                <div class="prosegin-card mb-4">
                    <div class="prosegin-card-header bg-white py-2 px-3">
                        <span class="fw-bold text-dark small text-uppercase">
                            <i class="bi bi-upc-scan text-warning me-2"></i> 1. Identificación del Producto
                        </span>
                    </div>

                    <div class="prosegin-card-body p-3">
                        <!-- Campo SKU -->
                        <div class="mb-3">
                            <label asp-for="Sku" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                Código SKU / Parte <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted fw-bold">
                                    <i class="bi bi-hash"></i>
                                </span>
                                <input asp-for="Sku" id="txtSku" class="form-control form-control-prosegin font-monospace fw-bold fs-6 border-start-0 text-uppercase" 
                                       placeholder="Ej: CAS-3M-H700" maxlength="50" autocomplete="off" />
                            </div>
                            <div id="skuStatusBox" class="mt-1 small">
                                <span id="skuStatusText" class="text-muted" style="font-size: 0.75rem;">
                                    Código único para cotizaciones y almacén
                                </span>
                            </div>
                            <span asp-validation-for="Sku" class="text-danger small d-block"></span>
                        </div>

                        <!-- Nombre Comercial -->
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                Nombre Comercial del EPP <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Nombre" id="txtNombre" class="form-control form-control-prosegin form-control-sm text-uppercase" 
                                   placeholder="Ej: CASCO DE SEGURIDAD MINERO H-700 CON SUSPENSIÓN DE 4 PUNTOS" autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Categoría y Unidad de Medida -->
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label asp-for="Categoria" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                    Categoría de EPP <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Categoria" id="ddlCategoria" class="form-select form-control-prosegin form-control-sm">
                                    <option value="">-- Seleccionar Categoría --</option>
                                    <option value="Protección de cabeza">Protección de cabeza</option>
                                    <option value="Protección ocular">Protección ocular / Facial</option>
                                    <option value="Protección respiratoria">Protección respiratoria</option>
                                    <option value="Protección auditiva">Protección auditiva</option>
                                    <option value="Protección de manos">Protección de manos / Guantes</option>
                                    <option value="Protección de pies">Protección de pies / Calzado</option>
                                    <option value="Protección corporal">Protección corporal / Indumentaria</option>
                                    <option value="Trabajo en altura">Trabajo en altura / Caídas</option>
                                </select>
                                <span asp-validation-for="Categoria" class="text-danger small d-block mt-1"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="UnidadMedida" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                    Unidad de Medida
                                </label>
                                <select asp-for="UnidadMedida" id="ddlUnidad" class="form-select form-control-prosegin form-control-sm font-monospace fw-bold">
                                    <option value="UND" selected>UND - Unidad</option>
                                    <option value="PAR">PAR - Par</option>
                                    <option value="JGO">JGO - Juego</option>
                                    <option value="CJA">CJA - Caja</option>
                                    <option value="PKT">PKT - Paquete</option>
                                </select>
                                <span asp-validation-for="UnidadMedida" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN 2: COSTOS Y PROVEEDOR AUTORIZADO -->
                <div class="prosegin-card mb-4">
                    <div class="prosegin-card-header bg-white py-2 px-3">
                        <span class="fw-bold text-dark small text-uppercase">
                            <i class="bi bi-cash-stack text-warning me-2"></i> 2. Costo Base y Proveedor Autorizado
                        </span>
                    </div>

                    <div class="prosegin-card-body p-3">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CostoBaseAdquisicion" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                    Costo Base de Adquisición (Sin IGV) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 fw-bold text-dark">S/</span>
                                    <input asp-for="CostoBaseAdquisicion" id="txtCosto" type="number" step="0.01" min="0.01" 
                                           class="form-control form-control-prosegin font-monospace fw-bold border-start-0" 
                                           placeholder="0.00" autocomplete="off" />
                                </div>
                                <div class="small text-muted mt-1" style="font-size: 0.72rem;">
                                    Costo al contado en Las Malvinas o proveedor oficial
                                </div>
                                <span asp-validation-for="CostoBaseAdquisicion" class="text-danger small d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ProveedorAutorizado" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                    Proveedor Autorizado <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-shop"></i>
                                    </span>
                                    <input asp-for="ProveedorAutorizado" id="txtProveedor" class="form-control form-control-prosegin border-start-0 text-uppercase" 
                                           placeholder="Ej: 3M PERÚ S.A.C. / IMPORTACIONES MALVINAS" autocomplete="organization" />
                                </div>
                                <div class="small text-muted mt-1" style="font-size: 0.72rem;">
                                    Razón social o distribuidor habitual
                                </div>
                                <span asp-validation-for="ProveedorAutorizado" class="text-danger small d-block"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN 3: DOCUMENTACIÓN TÉCNICA OFICIAL (PDF) -->
                <div class="prosegin-card mb-4">
                    <div class="prosegin-card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark small text-uppercase">
                            <i class="bi bi-file-earmark-pdf text-warning me-2"></i> 3. Ficha Técnica Oficial (PDF Obligatorio) <span class="text-danger">*</span>
                        </span>
                        <span class="badge bg-warning-subtle text-dark border border-warning" style="font-size: 0.68rem;">
                            Auditoría SST & SUNAT
                        </span>
                    </div>

                    <div class="prosegin-card-body p-3">
                        <div class="row g-3 align-items-stretch">
                            <!-- Dropzone interactivo -->
                            <div class="col-lg-6">
                                <div id="dropzoneBox" class="d-flex flex-column justify-content-center align-items-center text-center border border-2 border-secondary-subtle border-dashed rounded-3 p-4 bg-light h-100" style="cursor: pointer; min-height: 140px; transition: all 0.2s ease;">
                                    <i class="bi bi-cloud-arrow-up fs-2 text-warning mb-1"></i>
                                    <span class="fw-bold text-dark small">Arrastra el archivo PDF aquí</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">o haz clic para examinar tu equipo</span>
                                    <span class="badge bg-white text-secondary border mt-2" style="font-size: 0.68rem;">
                                        PDF • Máximo 5 MB
                                    </span>
                                </div>
                                <input asp-for="FichaTecnica" id="txtFichaTecnica" type="file" accept="application/pdf,.pdf" class="visually-hidden" />
                                <span asp-validation-for="FichaTecnica" class="text-danger small d-block mt-1"></span>
                            </div>

                            <!-- Estado del archivo seleccionado -->
                            <div class="col-lg-6">
                                <div id="boxFichaSeleccionada" class="border rounded-3 p-3 h-100 d-none bg-white d-flex align-items-start gap-3 shadow-sm border-success">
                                    <div class="rounded-2 p-2 bg-danger-subtle text-danger fw-bold d-flex flex-column align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                                    </div>
                                    <div class="flex-grow-1 min-width-0">
                                        <div class="fw-bold text-dark text-truncate small" id="lblFichaNombre">archivo.pdf</div>
                                        <div class="text-muted small" id="lblFichaTamano" style="font-size: 0.72rem;">0.00 MB</div>
                                        <span class="badge bg-success-subtle text-success border border-success mt-1" style="font-size: 0.68rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i> PDF Válido
                                        </span>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0" id="btnQuitarFicha" title="Quitar archivo">
                                        <i class="bi bi-x-circle-fill fs-5"></i>
                                    </button>
                                </div>

                                <div id="boxFichaVacia" class="border border-dashed rounded-3 p-3 h-100 d-flex flex-column align-items-center justify-content-center text-muted bg-white text-center">
                                    <i class="bi bi-file-earmark-x fs-3 text-secondary mb-1"></i>
                                    <span class="small fw-semibold">Ningún archivo cargado</span>
                                    <span style="font-size: 0.72rem;">La ficha técnica es requerida para validar cotizaciones.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- COLUMNA DERECHA: RESUMEN DEL PRODUCTO (STICKY PREVIEW) -->
            <div class="col-lg-4">
                
                <div class="prosegin-card mb-4 sticky-top" style="top: 85px;">
                    <div class="prosegin-card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark small text-uppercase">
                            Resumen del Producto
                        </span>
                        <i class="bi bi-box-seam text-muted"></i>
                    </div>

                    <div class="prosegin-card-body p-3">
                        <div class="mb-3">
                            <span class="text-muted small text-uppercase fw-bold d-block" style="font-size: 0.7rem;">CÓDIGO SKU</span>
                            <div class="fs-4 fw-bolder font-monospace text-muted text-break" id="previewSku">
                                -----------
                            </div>
                            <div class="small text-muted fst-italic mt-1 text-break" id="previewNombre">
                                Nombre comercial del EPP
                            </div>
                        </div>

                        <hr class="my-2 border-light" />

                        <!-- Ficha de Datos Dinámica -->
                        <div class="d-flex flex-column gap-2 py-2 small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Categoría:</span>
                                <span class="badge bg-light text-muted border text-truncate" style="max-width: 170px;" id="previewCategoria">Pendiente</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Unidad Medida:</span>
                                <span class="badge bg-light text-dark border font-monospace" id="previewUnidad">UND</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Costo Base (Sin IGV):</span>
                                <span class="fw-bold font-monospace text-dark" id="previewCosto">S/ 0.00</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted">Ficha Técnica:</span>
                                <span class="badge bg-light text-muted border" id="previewFicha">Sin Archivo</span>
                            </div>
                        </div>

                        <hr class="my-2 border-light" />

                        <!-- Checklist de Validaciones del Producto -->
                        <div class="d-flex flex-column gap-2 pt-2 small" style="font-size: 0.78rem;">
                            <!-- Check 1: SKU ingresado -->
                            <div class="d-flex align-items-center gap-2" id="chkSku">
                                <i class="bi bi-circle text-muted" id="iconChkSku"></i>
                                <span class="text-muted" id="lblChkSku">Código SKU asignado</span>
                            </div>

                            <!-- Check 2: Nombre comercial -->
                            <div class="d-flex align-items-center gap-2" id="chkNombre">
                                <i class="bi bi-circle text-muted" id="iconChkNombre"></i>
                                <span class="text-muted" id="lblChkNombre">Nombre comercial y categoría</span>
                            </div>

                            <!-- Check 3: Costo Base mayor a 0 -->
                            <div class="d-flex align-items-center gap-2" id="chkCosto">
                                <i class="bi bi-circle text-muted" id="iconChkCosto"></i>
                                <span class="text-muted" id="lblChkCosto">Costo base mayor a S/ 0.00</span>
                            </div>

                            <!-- Check 4: Ficha técnica PDF -->
                            <div class="d-flex align-items-center gap-2" id="chkFicha">
                                <i class="bi bi-circle text-muted" id="iconChkFicha"></i>
                                <span class="text-muted" id="lblChkFicha">Ficha técnica PDF adjuntada</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- BARRA DE ACCIÓN INFERIOR: BOTONES DE GUARDADO -->
        <div class="prosegin-card p-3 mt-2 mb-4 bg-white border d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2 small fw-bold text-secondary" id="formStatusIndicator">
                <span class="d-inline-block rounded-circle bg-secondary" id="statusDot" style="width: 10px; height: 10px;"></span>
                <span id="statusLabel">FORMULARIO PENDIENTE // COMPLETE LOS CAMPOS OBLIGATORIOS (*)</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Catalogo" asp-action="Index" class="btn-prosegin-secondary py-2 px-3">
                    CANCELAR
                </a>
                <button type="submit" id="btnGuardarProducto" class="btn-prosegin-primary py-2 px-4 fw-bold">
                    <i class="bi bi-save me-1"></i> GUARDAR PRODUCTO EN CATÁLOGO
                </button>
            </div>
        </div>
    </form>

    <!-- LISTADO DE PRODUCTOS REGISTRADOS RECIENTEMENTE (EN BASE DE DATOS) -->
    @if (productosRegistrados.Any())
    {
        <div class="prosegin-card mt-4 mb-5">
            <div class="prosegin-card-header py-2 px-3 d-flex justify-content-between align-items-center bg-light">
                <span class="fw-bold text-dark small text-uppercase">
                    <i class="bi bi-boxes text-warning me-1"></i> Productos EPP Registrados en Base de Datos (@productosRegistrados.Count)
                </span>
                <span class="badge bg-success text-white small">Base de Datos Activa</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-prosegin mb-0 align-middle">
                    <thead>
                        <tr>
                            <th style="width: 140px;">SKU</th>
                            <th>Nombre del Producto EPP</th>
                            <th style="width: 170px;">Categoría</th>
                            <th style="width: 80px;" class="text-center">Unidad</th>
                            <th style="width: 120px;" class="text-end">Costo Base</th>
                            <th style="width: 130px;" class="text-center">Ficha Técnica</th>
                            <th style="width: 125px;">Fecha Registro</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in productosRegistrados)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-dark">@p.Sku</td>
                                <td class="fw-semibold text-dark">
                                    @p.Nombre
                                    @if (!string.IsNullOrWhiteSpace(p.Descripcion))
                                    {
                                        <div class="text-muted small fst-italic" style="font-size: 0.72rem;">@p.Descripcion</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@p.Categoria</span>
                                </td>
                                <td class="text-center font-monospace small">@p.UnidadMedida</td>
                                <td class="text-end font-monospace fw-bold text-dark">
                                    S/ @p.CostoReferencial.ToString("N2")
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(p.RutaFichaTecnicaPdf))
                                    {
                                        <a asp-controller="Catalogo" asp-action="VerFicha" asp-route-id="@p.Id" target="_blank" 
                                           class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 py-1 px-2" 
                                           style="font-size: 0.75rem;" title="Abrir ficha técnica en nueva pestaña">
                                            <i class="bi bi-file-earmark-pdf-fill"></i> Ver Ficha ↗
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary small">Sin Ficha</span>
                                    }
                                </td>
                                <td class="small text-muted">@p.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formRegistroProducto');
            const txtSku = document.getElementById('txtSku');
            const txtNombre = document.getElementById('txtNombre');
            const ddlCategoria = document.getElementById('ddlCategoria');
            const ddlUnidad = document.getElementById('ddlUnidad');
            const txtCosto = document.getElementById('txtCosto');
            const txtProveedor = document.getElementById('txtProveedor');
            const txtFichaTecnica = document.getElementById('txtFichaTecnica');
            const dropzoneBox = document.getElementById('dropzoneBox');

            const boxFichaSeleccionada = document.getElementById('boxFichaSeleccionada');
            const boxFichaVacia = document.getElementById('boxFichaVacia');
            const lblFichaNombre = document.getElementById('lblFichaNombre');
            const lblFichaTamano = document.getElementById('lblFichaTamano');
            const btnQuitarFicha = document.getElementById('btnQuitarFicha');
            const btnGuardar = document.getElementById('btnGuardarProducto');

            // Previews
            const previewSku = document.getElementById('previewSku');
            const previewNombre = document.getElementById('previewNombre');
            const previewCategoria = document.getElementById('previewCategoria');
            const previewUnidad = document.getElementById('previewUnidad');
            const previewCosto = document.getElementById('previewCosto');
            const previewFicha = document.getElementById('previewFicha');

            // Checks
            const iconChkSku = document.getElementById('iconChkSku');
            const lblChkSku = document.getElementById('lblChkSku');
            const iconChkNombre = document.getElementById('iconChkNombre');
            const lblChkNombre = document.getElementById('lblChkNombre');
            const iconChkCosto = document.getElementById('iconChkCosto');
            const lblChkCosto = document.getElementById('lblChkCosto');
            const iconChkFicha = document.getElementById('iconChkFicha');
            const lblChkFicha = document.getElementById('lblChkFicha');

            const statusDot = document.getElementById('statusDot');
            const statusLabel = document.getElementById('statusLabel');

            const maxBytes = 5 * 1024 * 1024; // 5 MB

            function setCheck(iconEl, lblEl, isValid, text) {
                if (isValid) {
                    iconEl.className = 'bi bi-check-circle-fill text-success';
                    lblEl.className = 'text-success fw-bold';
                    lblEl.textContent = text;
                } else {
                    iconEl.className = 'bi bi-circle text-muted';
                    lblEl.className = 'text-muted';
                    lblEl.textContent = text;
                }
            }

            // Sincronización SKU
            txtSku.addEventListener('input', function () {
                this.value = this.value.toUpperCase();
                const val = this.value.trim();
                if (val.length > 0) {
                    previewSku.textContent = val;
                    previewSku.className = 'fs-4 fw-bolder font-monospace text-dark text-break';
                    txtSku.classList.remove('is-invalid');
                    txtSku.classList.add('is-valid');
                    setCheck(iconChkSku, lblChkSku, true, `SKU: ${val}`);
                } else {
                    previewSku.textContent = '-----------';
                    previewSku.className = 'fs-4 fw-bolder font-monospace text-muted';
                    txtSku.classList.remove('is-valid');
                    setCheck(iconChkSku, lblChkSku, false, 'Código SKU asignado');
                }
                actualizarEstadoFormulario();
            });

            // Sincronización Nombre
            txtNombre.addEventListener('input', function () {
                this.value = this.value.toUpperCase();
                const val = this.value.trim();
                if (val.length > 0) {
                    previewNombre.textContent = val;
                    previewNombre.className = 'small fw-bold text-dark mt-1 text-break';
                    txtNombre.classList.remove('is-invalid');
                    txtNombre.classList.add('is-valid');
                } else {
                    previewNombre.textContent = 'Nombre comercial del EPP';
                    previewNombre.className = 'small text-muted fst-italic mt-1';
                    txtNombre.classList.remove('is-valid');
                }
                evaluarNombreYCategoria();
                actualizarEstadoFormulario();
            });

            // Sincronización Categoría
            ddlCategoria.addEventListener('change', function () {
                const val = this.value.trim();
                if (val.length > 0) {
                    previewCategoria.textContent = val;
                    previewCategoria.className = 'badge bg-primary-subtle text-primary border border-primary text-truncate';
                    ddlCategoria.classList.remove('is-invalid');
                    ddlCategoria.classList.add('is-valid');
                } else {
                    previewCategoria.textContent = 'Pendiente';
                    previewCategoria.className = 'badge bg-light text-muted border text-truncate';
                    ddlCategoria.classList.remove('is-valid');
                }
                evaluarNombreYCategoria();
                actualizarEstadoFormulario();
            });

            function evaluarNombreYCategoria() {
                const nombreOk = txtNombre.value.trim().length > 0;
                const catOk = ddlCategoria.value.trim().length > 0;
                if (nombreOk && catOk) {
                    setCheck(iconChkNombre, lblChkNombre, true, 'Nombre y categoría definidos');
                } else {
                    setCheck(iconChkNombre, lblChkNombre, false, 'Nombre comercial y categoría');
                }
            }

            // Sincronización Unidad de Medida
            ddlUnidad.addEventListener('change', function () {
                previewUnidad.textContent = this.value;
            });

            // Sincronización Costo Base
            txtCosto.addEventListener('input', function () {
                const num = parseFloat(this.value);
                if (!isNaN(num) && num > 0) {
                    previewCosto.textContent = `S/ ${num.toFixed(2)}`;
                    txtCosto.classList.remove('is-invalid');
                    txtCosto.classList.add('is-valid');
                    setCheck(iconChkCosto, lblChkCosto, true, `Costo Base: S/ ${num.toFixed(2)}`);
                } else {
                    previewCosto.textContent = 'S/ 0.00';
                    txtCosto.classList.remove('is-valid');
                    setCheck(iconChkCosto, lblChkCosto, false, 'Costo base mayor a S/ 0.00');
                }
                actualizarEstadoFormulario();
            });

            txtProveedor.addEventListener('input', function () {
                this.value = this.value.toUpperCase();
                if (this.value.trim().length > 0) {
                    txtProveedor.classList.remove('is-invalid');
                }
                actualizarEstadoFormulario();
            });

            // Manejo de Dropzone & Ficha Técnica PDF
            dropzoneBox.addEventListener('click', () => txtFichaTecnica.click());

            ['dragenter', 'dragover'].forEach(eventName => {
                dropzoneBox.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzoneBox.classList.add('border-warning', 'bg-warning-subtle');
                });
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzoneBox.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzoneBox.classList.remove('border-warning', 'bg-warning-subtle');
                });
            });

            dropzoneBox.addEventListener('drop', (e) => {
                const files = e.dataTransfer.files;
                if (files && files.length > 0) {
                    txtFichaTecnica.files = files;
                    procesarArchivoFicha(files[0]);
                }
            });

            txtFichaTecnica.addEventListener('change', function () {
                if (this.files && this.files.length > 0) {
                    procesarArchivoFicha(this.files[0]);
                } else {
                    resetearFicha();
                }
            });

            function procesarArchivoFicha(file) {
                if (!file) {
                    resetearFicha();
                    return;
                }

                if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
                    alert('Solo se permiten archivos en formato PDF.');
                    resetearFicha();
                    return;
                }

                if (file.size > maxBytes) {
                    alert('La ficha técnica no puede superar los 5 MB.');
                    resetearFicha();
                    return;
                }

                lblFichaNombre.textContent = file.name;
                lblFichaTamano.textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB`;

                boxFichaSeleccionada.classList.remove('d-none');
                boxFichaVacia.classList.add('d-none');

                previewFicha.textContent = 'PDF Cargado';
                previewFicha.className = 'badge bg-success-subtle text-success border border-success';

                setCheck(iconChkFicha, lblChkFicha, true, `Ficha: ${file.name}`);
                txtFichaTecnica.classList.remove('is-invalid');
                actualizarEstadoFormulario();
            }

            function resetearFicha() {
                txtFichaTecnica.value = '';
                lblFichaNombre.textContent = '';
                lblFichaTamano.textContent = '';
                boxFichaSeleccionada.classList.add('d-none');
                boxFichaVacia.classList.remove('d-none');

                previewFicha.textContent = 'Sin Archivo';
                previewFicha.className = 'badge bg-light text-muted border';

                setCheck(iconChkFicha, lblChkFicha, false, 'Ficha técnica PDF adjuntada');
                actualizarEstadoFormulario();
            }

            btnQuitarFicha.addEventListener('click', resetearFicha);

            // Validación global del formulario
            function actualizarEstadoFormulario() {
                const skuOk = txtSku.value.trim().length > 0;
                const nombreOk = txtNombre.value.trim().length > 0;
                const catOk = ddlCategoria.value.trim().length > 0;
                const costoOk = parseFloat(txtCosto.value) > 0;
                const provOk = txtProveedor.value.trim().length > 0;
                const fichaOk = txtFichaTecnica.files && txtFichaTecnica.files.length > 0;

                if (skuOk && nombreOk && catOk && costoOk && provOk && fichaOk) {
                    statusDot.className = 'd-inline-block rounded-circle bg-success';
                    statusLabel.textContent = 'FORMULARIO LISTO PARA GUARDAR';
                    statusLabel.className = 'text-success fw-bold';
                } else {
                    statusDot.className = 'd-inline-block rounded-circle bg-warning';
                    statusLabel.textContent = 'FORMULARIO PENDIENTE // COMPLETE LOS CAMPOS OBLIGATORIOS (*)';
                    statusLabel.className = 'text-secondary fw-bold';
                }
            }

            // Envío con validación
            form.addEventListener('submit', function (e) {
                let esValido = true;

                if (!txtSku.value.trim()) {
                    txtSku.classList.add('is-invalid');
                    txtSku.focus();
                    esValido = false;
                }

                if (!txtNombre.value.trim()) {
                    txtNombre.classList.add('is-invalid');
                    if (esValido) txtNombre.focus();
                    esValido = false;
                }

                if (!ddlCategoria.value.trim()) {
                    ddlCategoria.classList.add('is-invalid');
                    if (esValido) ddlCategoria.focus();
                    esValido = false;
                }

                const costoVal = parseFloat(txtCosto.value);
                if (isNaN(costoVal) || costoVal <= 0) {
                    txtCosto.classList.add('is-invalid');
                    if (esValido) txtCosto.focus();
                    esValido = false;
                }

                if (!txtProveedor.value.trim()) {
                    txtProveedor.classList.add('is-invalid');
                    if (esValido) txtProveedor.focus();
                    esValido = false;
                }

                if (!txtFichaTecnica.files || txtFichaTecnica.files.length === 0) {
                    dropzoneBox.classList.add('border-danger');
                    if (esValido) dropzoneBox.scrollIntoView({ behavior: 'smooth' });
                    esValido = false;
                }

                if (!esValido) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }

                btnGuardar.disabled = true;
                btnGuardar.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Guardando en Base de Datos...';
            });

            // Disparar sincronización inicial si hay valores (por ejemplo tras error de post)
            if (txtSku.value.trim().length > 0) txtSku.dispatchEvent(new Event('input'));
            if (txtNombre.value.trim().length > 0) txtNombre.dispatchEvent(new Event('input'));
            if (ddlCategoria.value.trim().length > 0) ddlCategoria.dispatchEvent(new Event('change'));
            if (txtCosto.value.trim().length > 0) txtCosto.dispatchEvent(new Event('input'));
            if (txtProveedor.value.trim().length > 0) txtProveedor.dispatchEvent(new Event('input'));
        });
    </script>
}