@model Prosegin.Web.ViewModels.Catalogo.ProductoCreateViewModel
@using Prosegin.Data.Entities

@{
    ViewData["Title"] = "Registrar Nuevo Producto EPP";
}

<div class="container-fluid px-0">
    <!-- 1. ENCABEZADO / BREADCRUMB CARD (Diseño Figma) -->
    <div class="prosegin-card mb-4 p-3 p-md-4">
        <div class="mb-1 text-muted small" style="font-size: 0.82rem;">
            <a asp-controller="Catalogo" asp-action="Index" class="text-decoration-none text-muted">Catálogo de EPP</a>
            <i class="bi bi-chevron-right mx-1" style="font-size: 0.72rem;"></i>
            <span class="text-secondary fw-semibold">Registrar Nuevo Producto</span>
        </div>
        <h1 class="fw-bold text-dark mb-0" style="font-size: 1.25rem; letter-spacing: -0.01em;">
            Alta técnica y comercial de equipos de protección personal
        </h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
                <strong class="d-block">¡Registro Exitoso!</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Catalogo" asp-action="RegistroProductos" method="post" enctype="multipart/form-data" id="formRegistroProducto" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

        <!-- 2. CARD 1: INFORMACIÓN GENERAL Y CÓDIGO IDENTIFICADOR -->
        <div class="prosegin-card mb-4 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center py-3 px-4 border-bottom bg-white">
                <span class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 0.92rem;">
                    <i class="bi bi-shield text-muted"></i> Información General y Código Identificador
                </span>
                <span class="text-muted small fst-italic" style="font-size: 0.8rem;">*obligatorios</span>
            </div>

            <div class="p-3 p-md-4">
                <!-- Fila 1: SKU y Nombre del EPP -->
                <div class="row g-3 mb-3">
                    <!-- Código SKU -->
                    <div class="col-md-5">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Sku" class="form-label-prosegin small text-uppercase fw-bold mb-0">
                                CÓDIGO SKU <span class="text-danger">*</span>
                            </label>
                            <span class="text-muted" style="font-size: 0.75rem;">6-12 caracteres</span>
                        </div>
                        <div class="position-relative">
                            <input asp-for="Sku" id="txtSku" class="form-control form-control-prosegin font-monospace text-uppercase pe-5"
                                   placeholder="EPP-CAS-0042" maxlength="30" autocomplete="off" />
                            <span id="skuCheckIcon" class="position-absolute end-0 top-50 translate-middle-y me-3 d-none">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            </span>
                        </div>
                        <div class="mt-1 small text-muted" style="font-size: 0.78rem;" id="skuHelperText">
                            <i class="bi bi-info-circle me-1"></i> Código único alfanumérico. Si ya existe, mostrará: <em class="text-secondary">"El código SKU ya se encuentra registrado"</em>
                        </div>
                        <span asp-validation-for="Sku" class="text-danger small d-block"></span>
                    </div>

                    <!-- Nombre o Descripción -->
                    <div class="col-md-7">
                        <label asp-for="Nombre" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            NOMBRE O DESCRIPCIÓN DEL EPP <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Nombre" id="txtNombre" class="form-control form-control-prosegin"
                               placeholder="Casco de Seguridad Dieléctrico Tipo 1 Clase E con Barboquejo" autocomplete="off" />
                        <span asp-validation-for="Nombre" class="text-danger small d-block"></span>
                    </div>
                </div>

                <!-- Fila 2: Categoría, Marca y Unidad de Medida -->
                <div class="row g-3">
                    <!-- Categoría -->
                    <div class="col-md-5">
                        <label asp-for="Categoria" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            CATEGORÍA / TIPO DE PROTECCIÓN <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Categoria" id="ddlCategoria" class="form-select form-control-prosegin">
                            <option value="">-- Seleccione una categoría --</option>
                            <option value="Protección Craneal / Cascos">Protección Craneal / Cascos</option>
                            <option value="Protección Auditiva">Protección Auditiva</option>
                            <option value="Protección Visual y Facial">Protección Visual y Facial</option>
                            <option value="Protección Respiratoria">Protección Respiratoria</option>
                            <option value="Protección Manual / Guantes">Protección Manual / Guantes</option>
                            <option value="Calzado de Seguridad">Calzado de Seguridad</option>
                            <option value="Protección Corporal / Ropa">Protección Corporal / Ropa</option>
                            <option value="Trabajo en Altura">Trabajo en Altura</option>
                        </select>
                        <span asp-validation-for="Categoria" class="text-danger small d-block"></span>
                    </div>

                    <!-- Marca / Fabricante -->
                    <div class="col-md-4">
                        <label asp-for="Marca" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            MARCA / FABRICANTE <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Marca" id="ddlMarca" class="form-select form-control-prosegin">
                            <option value="MSA Safety" selected>MSA Safety</option>
                            <option value="3M">3M</option>
                            <option value="Steelpro">Steelpro</option>
                            <option value="Ansell">Ansell</option>
                            <option value="Bata Industrials">Bata Industrials</option>
                            <option value="Caterpillar (CAT)">Caterpillar (CAT)</option>
                            <option value="Showa">Showa</option>
                            <option value="Hawk">Hawk</option>
                            <option value="KleenGuard">KleenGuard</option>
                            <option value="Generico / Nacional">Genérico / Nacional</option>
                        </select>
                    </div>

                    <!-- Unidad de Medida -->
                    <div class="col-md-3">
                        <label asp-for="UnidadMedida" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            UNIDAD DE MEDIDA <span class="text-danger">*</span>
                        </label>
                        <select asp-for="UnidadMedida" id="ddlUnidad" class="form-select form-control-prosegin">
                            <option value="UND" selected>Unidad (UND)</option>
                            <option value="PAR">Par (PAR)</option>
                            <option value="CAJ">Caja (CAJ)</option>
                            <option value="PQT">Paquete (PQT)</option>
                            <option value="JGO">Juego (JGO)</option>
                        </select>
                        <span asp-validation-for="UnidadMedida" class="text-danger small d-block"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. CARD 2: COSTO BASE Y PROVEEDOR AUTORIZADO -->
        <div class="prosegin-card mb-4 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center py-3 px-4 border-bottom bg-white">
                <span class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 0.92rem;">
                    <i class="bi bi-wallet2 text-muted"></i> Costo base y proveedor autorizado
                </span>
            </div>

            <div class="p-3 p-md-4">
                <div class="row g-3 align-items-end">
                    <!-- Costo Base -->
                    <div class="col-md-4">
                        <label asp-for="CostoBaseAdquisicion" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            COSTO BASE (S/.) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted fw-semibold">S/.</span>
                            <input asp-for="CostoBaseAdquisicion" id="txtCosto" type="number" step="0.01" min="0.01"
                                   class="form-control form-control-prosegin border-start-0 font-monospace fw-bold"
                                   placeholder="48.50" />
                        </div>
                        <span asp-validation-for="CostoBaseAdquisicion" class="text-danger small d-block"></span>
                    </div>

                    <!-- Proveedores Autorizados -->
                    <div class="col-md-6">
                        <label asp-for="ProveedorAutorizado" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                            PROVEEDORES AUTORIZADOS <span class="text-danger">*</span>
                        </label>
                        <div class="position-relative">
                            <input asp-for="ProveedorAutorizado" id="txtProveedor" class="form-control form-control-prosegin pe-5"
                                   placeholder="Buscar y seleccionar proveedor homologado..." autocomplete="off" list="proveedoresList" />
                            <span class="position-absolute end-0 top-50 translate-middle-y me-3 text-muted pointer-events-none">
                                <i class="bi bi-search"></i>
                            </span>
                            <datalist id="proveedoresList">
                                <option value="DISTRIBUIDORA FERRETERA LAS MALVINAS S.A.C." />
                                <option value="IMPORTADORA INDUSTRIAL DE SEGURIDAD DEL PERÚ E.I.R.L." />
                                <option value="COMERCIAL EPP PERÚ S.A." />
                                <option value="MULTISERVICIOS Y SUMINISTROS LIMA S.A.C." />
                                <option value="PROVEEDOR DIRECTO FABRICANTE" />
                            </datalist>
                        </div>
                        <span asp-validation-for="ProveedorAutorizado" class="text-danger small d-block"></span>
                    </div>

                    <!-- Botón Agregar Proveedor -->
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center gap-1"
                                id="btnAgregarProveedor" style="height: 44px; font-size: 0.82rem; font-weight: 600; border-radius: 8px;">
                            <i class="bi bi-plus-lg"></i> Agregar proveedor
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. CARD 3: FICHA TÉCNICA DEL FABRICANTE -->
        <div class="prosegin-card mb-4 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center py-3 px-4 border-bottom bg-white">
                <span class="fw-bold text-dark d-flex align-items-center gap-2" style="font-size: 0.92rem;">
                    <i class="bi bi-file-earmark-text text-muted"></i> Ficha técnica del fabricante
                </span>
            </div>

            <div class="p-3 p-md-4">
                <!-- Input file oculto -->
                <input asp-for="FichaTecnica" type="file" id="txtFichaTecnica" class="d-none" accept=".pdf,application/pdf" />

                <!-- Dropzone Box -->
                <div id="dropzoneBox" class="pdf-dropzone p-4 text-center rounded-3 mb-3"
                     style="border: 2px dashed #cbd5e1; background-color: #f8fafc; cursor: pointer; transition: all 0.2s ease;">
                    <div class="d-flex flex-column align-items-center justify-content-center py-2">
                        <div class="p-2 rounded-3 bg-white border mb-2 shadow-sm d-flex align-items-center justify-content-center"
                             style="width: 44px; height: 44px;">
                            <i class="bi bi-file-earmark-arrow-up fs-4 text-dark"></i>
                        </div>
                        <div class="text-dark small mb-1" style="font-size: 0.88rem;">
                            Arrastrar archivo PDF aquí o <span class="text-dark fw-bold text-decoration-underline">explorar equipo</span>
                        </div>
                        <div class="text-muted" style="font-size: 0.78rem;">
                            Formato admitido: Solo PDF. Tamaño máximo: 5 MB
                        </div>
                    </div>
                </div>

                <!-- Selected File Preview Card (Se muestra tras seleccionar) -->
                <div id="boxFichaSeleccionada" class="d-none p-3 rounded-3 border bg-white d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2 rounded bg-danger-subtle text-danger d-flex align-items-center justify-content-center"
                             style="width: 44px; height: 44px; border-radius: 8px;">
                            <i class="bi bi-file-earmark-pdf-fill fs-3"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-bold text-dark small" id="lblFichaNombre">FT_Archivo.pdf</span>
                                <span class="text-muted small" id="lblFichaTamano" style="font-size: 0.78rem;">(1.8 MB)</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle fw-semibold px-2 py-1"
                                      style="font-size: 0.72rem;">
                                    <i class="bi bi-check-circle-fill me-1"></i> ARCHIVO VALIDADO
                                </span>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="btnQuitarFicha" title="Quitar archivo">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>

                <span asp-validation-for="FichaTecnica" class="text-danger small d-block mt-2"></span>
            </div>
        </div>

        <!-- 5. BARRA DE ACCIÓN INFERIOR (Diseño Figma) -->
        <div class="prosegin-card p-3 mb-5 bg-white border d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2" id="formStatusIndicator">
                <i class="bi bi-check-circle text-muted fs-5" id="statusIcon"></i>
                <span id="statusLabel" class="small text-muted fw-medium">
                    Complete todos los campos obligatorios (*) para guardar
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Catalogo" asp-action="Index" class="btn btn-outline-secondary py-2 px-4 fw-semibold"
                   style="border-radius: 8px; font-size: 0.85rem;">
                    CANCELAR
                </a>
                <button type="submit" id="btnGuardarProducto" class="btn d-inline-flex align-items-center gap-2 py-2 px-4 fw-bold text-white"
                        style="background-color: #0c1524; border: 1px solid #0c1524; border-radius: 8px; font-size: 0.85rem;">
                    <i class="bi bi-floppy"></i> GUARDAR PRODUCTO EPP
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formRegistroProducto');
            const txtSku = document.getElementById('txtSku');
            const txtNombre = document.getElementById('txtNombre');
            const ddlCategoria = document.getElementById('ddlCategoria');
            const ddlMarca = document.getElementById('ddlMarca');
            const ddlUnidad = document.getElementById('ddlUnidad');
            const txtCosto = document.getElementById('txtCosto');
            const txtProveedor = document.getElementById('txtProveedor');
            const txtFichaTecnica = document.getElementById('txtFichaTecnica');
            const dropzoneBox = document.getElementById('dropzoneBox');

            const skuCheckIcon = document.getElementById('skuCheckIcon');
            const skuHelperText = document.getElementById('skuHelperText');

            const boxFichaSeleccionada = document.getElementById('boxFichaSeleccionada');
            const lblFichaNombre = document.getElementById('lblFichaNombre');
            const lblFichaTamano = document.getElementById('lblFichaTamano');
            const btnQuitarFicha = document.getElementById('btnQuitarFicha');
            const btnGuardar = document.getElementById('btnGuardarProducto');
            const btnAgregarProveedor = document.getElementById('btnAgregarProveedor');

            const statusIcon = document.getElementById('statusIcon');
            const statusLabel = document.getElementById('statusLabel');

            const maxBytes = 5 * 1024 * 1024; // 5 MB
            let skuTimeout = null;
            let skuEsValido = false;

            // Validación en tiempo real del SKU
            txtSku.addEventListener('input', function () {
                this.value = this.value.toUpperCase().replace(/\s+/g, '-');
                const skuVal = this.value.trim();

                clearTimeout(skuTimeout);
                if (skuVal.length < 3) {
                    skuCheckIcon.classList.add('d-none');
                    txtSku.classList.remove('is-valid', 'is-invalid');
                    skuHelperText.className = 'mt-1 small text-muted';
                    skuHelperText.innerHTML = '<i class="bi bi-info-circle me-1"></i> Código único alfanumérico. Si ya existe, mostrará: <em class="text-secondary">"El código SKU ya se encuentra registrado"</em>';
                    skuEsValido = false;
                    actualizarEstadoFormulario();
                    return;
                }

                skuTimeout = setTimeout(async () => {
                    try {
                        const response = await fetch(`/Catalogo/ValidarSku?sku=${encodeURIComponent(skuVal)}`);
                        const data = await response.json();

                        if (data.valido) {
                            skuCheckIcon.classList.remove('d-none');
                            txtSku.classList.remove('is-invalid');
                            txtSku.classList.add('is-valid');
                            skuHelperText.className = 'mt-1 small text-success fw-medium';
                            skuHelperText.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Código SKU disponible para registro';
                            skuEsValido = true;
                        } else {
                            skuCheckIcon.classList.add('d-none');
                            txtSku.classList.remove('is-valid');
                            txtSku.classList.add('is-invalid');
                            skuHelperText.className = 'mt-1 small text-danger fw-bold';
                            skuHelperText.innerHTML = `<i class="bi bi-exclamation-circle-fill me-1"></i> "${data.mensaje || 'El código SKU ya se encuentra registrado'}"`;
                            skuEsValido = false;
                        }
                    } catch (e) {
                        skuEsValido = skuVal.length >= 3;
                    }
                    actualizarEstadoFormulario();
                }, 350);
            });

            // Botón Agregar Proveedor Rápido
            if (btnAgregarProveedor) {
                btnAgregarProveedor.addEventListener('click', function () {
                    const nuevo = prompt("Ingrese el nombre comercial o razón social del proveedor:");
                    if (nuevo && nuevo.trim().length > 0) {
                        txtProveedor.value = nuevo.trim().toUpperCase();
                        txtProveedor.classList.remove('is-invalid');
                        actualizarEstadoFormulario();
                    }
                });
            }

            // Manejo de Dropzone & Ficha Técnica PDF
            dropzoneBox.addEventListener('click', () => txtFichaTecnica.click());

            ['dragenter', 'dragover'].forEach(eventName => {
                dropzoneBox.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzoneBox.style.borderColor = 'var(--accent, #f59e0b)';
                    dropzoneBox.style.backgroundColor = '#fffbeb';
                });
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropzoneBox.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzoneBox.style.borderColor = '#cbd5e1';
                    dropzoneBox.style.backgroundColor = '#f8fafc';
                });
            });

            dropzoneBox.addEventListener('drop', (e) => {
                const files = e.dataTransfer.files;
                if (files && files.length > 0) {
                    txtFichaTecnica.files = files;
                    procesarArchivoFicha(files[0]);
                }
            });

            txtFichaTecnica.addEventListener('change', function () {
                if (this.files && this.files.length > 0) {
                    procesarArchivoFicha(this.files[0]);
                } else {
                    resetearFicha();
                }
            });

            function procesarArchivoFicha(file) {
                if (!file) {
                    resetearFicha();
                    return;
                }

                if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
                    alert('Solo se permiten archivos en formato PDF.');
                    resetearFicha();
                    return;
                }

                if (file.size > maxBytes) {
                    alert('La ficha técnica no puede superar los 5 MB.');
                    resetearFicha();
                    return;
                }

                lblFichaNombre.textContent = file.name;
                lblFichaTamano.textContent = `(${(file.size / 1024 / 1024).toFixed(1)} MB)`;

                boxFichaSeleccionada.classList.remove('d-none');
                dropzoneBox.classList.add('d-none');
                actualizarEstadoFormulario();
            }

            function resetearFicha() {
                txtFichaTecnica.value = '';
                lblFichaNombre.textContent = '';
                lblFichaTamano.textContent = '';
                boxFichaSeleccionada.classList.add('d-none');
                dropzoneBox.classList.remove('d-none');
                actualizarEstadoFormulario();
            }

            btnQuitarFicha.addEventListener('click', resetearFicha);

            // Escuchar cambios en campos para estado
            [txtNombre, ddlCategoria, txtCosto, txtProveedor].forEach(el => {
                el.addEventListener('input', actualizarEstadoFormulario);
                el.addEventListener('change', actualizarEstadoFormulario);
            });

            // Estado general del formulario
            function actualizarEstadoFormulario() {
                const skuOk = txtSku.value.trim().length >= 3 && skuEsValido;
                const nombreOk = txtNombre.value.trim().length > 0;
                const catOk = ddlCategoria.value.trim().length > 0;
                const costoOk = parseFloat(txtCosto.value) > 0;
                const provOk = txtProveedor.value.trim().length > 0;
                const fichaOk = txtFichaTecnica.files && txtFichaTecnica.files.length > 0;

                if (skuOk && nombreOk && catOk && costoOk && provOk && fichaOk) {
                    statusIcon.className = 'bi bi-check-circle-fill text-success fs-5';
                    statusLabel.className = 'small text-success fw-bold';
                    statusLabel.textContent = 'Todos los campos obligatorios (*) completados correctamente';
                } else {
                    statusIcon.className = 'bi bi-check-circle text-muted fs-5';
                    statusLabel.className = 'small text-muted fw-medium';
                    statusLabel.textContent = 'Complete todos los campos obligatorios (*) para guardar';
                }
            }

            // Validación al enviar
            form.addEventListener('submit', function (e) {
                let esValido = true;

                if (!txtSku.value.trim()) {
                    txtSku.classList.add('is-invalid');
                    txtSku.focus();
                    esValido = false;
                }

                if (!txtNombre.value.trim()) {
                    txtNombre.classList.add('is-invalid');
                    if (esValido) txtNombre.focus();
                    esValido = false;
                }

                if (!ddlCategoria.value.trim()) {
                    ddlCategoria.classList.add('is-invalid');
                    if (esValido) ddlCategoria.focus();
                    esValido = false;
                }

                const costoVal = parseFloat(txtCosto.value);
                if (isNaN(costoVal) || costoVal <= 0) {
                    txtCosto.classList.add('is-invalid');
                    if (esValido) txtCosto.focus();
                    esValido = false;
                }

                if (!txtProveedor.value.trim()) {
                    txtProveedor.classList.add('is-invalid');
                    if (esValido) txtProveedor.focus();
                    esValido = false;
                }

                if (!txtFichaTecnica.files || txtFichaTecnica.files.length === 0) {
                    dropzoneBox.style.borderColor = '#ef4444';
                    dropzoneBox.scrollIntoView({ behavior: 'smooth' });
                    esValido = false;
                }

                if (!esValido) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }

                btnGuardar.disabled = true;
                btnGuardar.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Guardando producto...';
            });
        });
    </script>
}