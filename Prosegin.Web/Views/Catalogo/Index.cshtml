@model Prosegin.Web.ViewModels.Catalogo.CatalogoIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Catálogo de EPP";
    var hasResults = Model.Productos.Any();
    var categories = Model.Productos.Select(product => product.Categoria).Where(category => !string.IsNullOrWhiteSpace(category)).Distinct().OrderBy(category => category).ToList();
}

<div class="container-fluid px-0 catalog-shopping" id="catalogShopping">
    <!-- ENCABEZADO: Catálogo de Productos EPP -->
    <div class="prosegin-card mb-4 p-3 p-md-4">
        <div class="prosegin-page-header--accent" style="margin-bottom: 0;">
            <div class="header-content">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h1 class="page-title mb-0">Catálogo de Productos EPP</h1>
                    <span class="badge-status badge-status-warning"><span class="status-dot"></span> <span id="catalogProductCount">@Model.Productos.Count</span> <span id="catalogProductLabel">disponibles</span></span>
                </div>
                <p class="page-subtitle mb-0">Explora el catálogo homologado, selecciona las unidades requeridas y continúa con la cotización.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Catalogo" asp-action="RegistroProductos" class="btn-prosegin-primary">
                    <i class="bi bi-plus-lg"></i> Registrar Nuevos Productos
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="catalog-toolbar">
        <label class="catalog-search" for="catalogSearch">
            <i class="bi bi-search"></i>
            <input id="catalogSearch" type="search" placeholder="Buscar por código, descripción o categoría..." autocomplete="off" />
        </label>
        <div class="catalog-category-list" role="group" aria-label="Filtrar por categoría">
            <button type="button" class="catalog-category active" data-category-filter="">Todos</button>
            @foreach (var category in categories)
            {
                <button type="button" class="catalog-category" data-category-filter="@category">@category</button>
            }
        </div>
    </div>

    @if (!hasResults)
    {
        <div class="prosegin-card py-5 text-center">
            <i class="bi bi-box-seam display-5 text-muted"></i>
            <h2 class="h5 mt-3">No hay productos disponibles</h2>
            <p class="text-muted mb-0">Los productos del catálogo aparecerán aquí cuando estén cargados en el sistema.</p>
        </div>
    }
    else
    {
        <div class="catalog-layout mt-3" id="catalogProducts">
            <section class="catalog-product-list" aria-label="Productos disponibles">
                @foreach (var product in Model.Productos)
                {
                    var estimatedPrice = Math.Round(product.Precio * 1.30m, 2);
                    var searchText = $"{product.Sku} {product.Nombre} {product.Categoria}".ToLowerInvariant();
                    var imageSrc = !string.IsNullOrWhiteSpace(product.RutaImagen)
                        ? product.RutaImagen
                        : $"/images/productos/{product.Sku}.png";
                    <article class="catalog-product" data-product-card data-product-id="@product.Id" data-sku="@product.Sku" data-name="@product.Nombre" data-category="@product.Categoria" data-search="@searchText" data-cost="@product.Precio.ToString(CultureInfo.InvariantCulture)" data-price="@estimatedPrice.ToString(CultureInfo.InvariantCulture)" data-stock="@product.StockDisponible">
                        <div class="catalog-product-mark" title="Ver imagen de @product.Nombre" data-preview-img="@imageSrc" data-preview-name="@product.Nombre" data-preview-sku="@product.Sku" role="button" tabindex="0" aria-label="Ver imagen ampliada de @product.Nombre">
                            <img src="@imageSrc" alt="Foto referencial de @product.Nombre" class="catalog-product-thumb" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                            <div class="catalog-product-fallback d-none" aria-hidden="true">
                                <i class="bi bi-shield-check"></i>
                                <span>EPP</span>
                            </div>
                        </div>
                        <div class="catalog-product-info">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span class="catalog-sku">@product.Sku</span>
                                <span class="catalog-category-label">@product.Categoria</span>
                            </div>
                            <h2 class="catalog-product-name">@product.Nombre</h2>
                            <div class="catalog-product-meta">
                                <span><i class="bi bi-box me-1"></i>@(product.StockDisponible > 0 ? $"Stock: {product.StockDisponible}" : "Disponibilidad a confirmar")</span>
                                @if (!string.IsNullOrWhiteSpace(product.RutaFichaTecnicaPdf))
                                {
                                    <a asp-controller="Catalogo" asp-action="VerFicha" asp-route-id="@product.Id" target="_blank" rel="noopener noreferrer"><i class="bi bi-file-earmark-pdf me-1"></i>Ficha técnica</a>
                                }
                            </div>
                        </div>
                        <div class="catalog-unit-price">
                            <span>Precio estimado / unidad</span>
                            <strong>S/ @estimatedPrice.ToString("N2", new CultureInfo("es-PE"))</strong>
                            <small>Incluye margen inicial de 30%</small>
                        </div>
                        <div class="catalog-add-controls">
                            <label class="visually-hidden" for="quantity-@product.Id">Cantidad de @product.Nombre</label>
                            <input id="quantity-@product.Id" data-quantity type="number" min="1" max="2147483647" step="1" value="1" inputmode="numeric" />
                            <button type="button" class="btn-prosegin-primary catalog-add-button" data-add-product aria-label="Agregar @product.Nombre al carrito"><i class="bi bi-plus-lg"></i><span>Agregar</span></button>
                            <button type="button" class="btn-prosegin-secondary text-decoration-none" data-bs-toggle="modal" data-bs-target="#editProductModal" onclick="populateEditModal(this)" data-id="@product.Id" data-sku="@product.Sku" data-name="@product.Nombre" data-category="@product.Categoria" data-stock="@product.StockDisponible" data-cost="@product.Precio.ToString(CultureInfo.InvariantCulture)"><i class="bi bi-pencil-square me-1"></i>Editar</button>
                        </div>
                    </article>
                }
                <div class="catalog-no-match d-none" id="catalogNoMatch">
                    <i class="bi bi-search"></i><span>No hay productos que coincidan con la búsqueda.</span>
                </div>
            </section>

            <aside class="catalog-cart" aria-label="Resumen de productos seleccionados">
                <div class="catalog-cart-heading">
                    <div><span class="catalog-cart-kicker">Tu selección</span><h2 class="h5 mb-0">Resumen de productos</h2></div>
                    <span class="catalog-cart-count" id="cartItemCount">0</span>
                </div>
                <div id="catalogQuantityError" class="text-danger small px-3" role="alert" hidden></div>
                <div class="catalog-cart-items" id="cartItems">
                    <div class="catalog-cart-empty" id="cartEmpty"><i class="bi bi-cart3"></i><span>El carrito está vacío</span><small>Agrega productos para comenzar la cotización.</small></div>
                </div>
                <div class="catalog-cart-totals">
                    <div><span>Subtotal estimado</span><strong id="cartSubtotal">S/ 0.00</strong></div>
                    <div><span>IGV (18%)</span><strong id="cartTax">S/ 0.00</strong></div>
                    <div class="catalog-cart-total"><span>Total estimado</span><strong id="cartTotal">S/ 0.00</strong></div>
                </div>
                <button type="button" class="btn-prosegin-primary w-100" id="continueToClient" disabled><i class="bi bi-person-check me-2"></i>Continuar con cliente</button>
                <button type="button" class="catalog-clear-button" id="clearCart" disabled>Vaciar selección</button>
                <p class="catalog-cart-note">El precio final se confirma en la cotización.</p>
            </aside>
        </div>
    }
</div>

<!-- Modal Editar Producto -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-bottom-0 pb-2 pt-4 px-4">
                <h5 class="modal-title fw-bold" id="editProductModalLabel">Editar Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                <form id="editProductForm" method="post" asp-action="EditarProducto" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editProductId" name="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">CÓDIGO SKU</label>
                        <input type="text" class="form-control bg-light" id="editProductSku" name="Sku" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">NOMBRE DEL PRODUCTO</label>
                        <input type="text" class="form-control" id="editProductName" name="Nombre" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">CATEGORÍA</label>
                        <input type="text" class="form-control" id="editProductCategory" name="Categoria" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">COSTO BASE (S/)</label>
                        <input type="number" step="0.01" class="form-control" id="editProductCost" name="Precio" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">NUEVA FICHA TÉCNICA (OPCIONAL)</label>
                        <input type="file" class="form-control" id="editProductFile" name="FichaTecnica" accept=".pdf" />
                        <small class="text-muted d-block mt-1">Sube un archivo PDF solo si deseas reemplazar la ficha actual.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="button" class="btn btn-light border px-4" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-dark px-4" style="background-color: #0B1727; border-color: #0B1727;">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Vista Previa de Imagen EPP -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header border-bottom-0 pb-1 pt-3 px-4">
                <div>
                    <span class="badge bg-light text-secondary border font-monospace" id="modalProductSku"></span>
                    <h2 class="modal-title fs-6 fw-bold mt-1 text-dark mb-0" id="imagePreviewTitle"></h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="p-3 bg-light rounded-4 d-inline-block shadow-sm w-100" style="max-width: 360px;">
                    <img id="modalPreviewImg" src="" alt="Imagen referencial del producto" class="img-fluid" style="max-height: 320px; object-fit: contain; border-radius: 8px;" />
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-3 justify-content-between">
                <small class="text-muted"><i class="bi bi-shield-check text-warning me-1"></i>Imagen de referencia homologada</small>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const storageKey = "prosegin.catalog.cart.v1";
            const pendingKey = "prosegin.quote.pending.v1";
            const quantityError = document.getElementById("catalogQuantityError");
            const validQuantity = value => /^\d+$/.test(String(value).trim())
                && Number(value) > 0 && Number(value) <= 2147483647;
            const cards = Array.from(document.querySelectorAll("[data-product-card]"));
            const cartItems = document.getElementById("cartItems");
            if (!cartItems) return;

            const cart = new Map();
            const formatter = new Intl.NumberFormat("es-PE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const formatCurrency = amount => `S/ ${formatter.format(amount)}`;
            const parseCart = () => {
                try {
                    const savedItems = JSON.parse(sessionStorage.getItem(storageKey) || "[]");
                    savedItems.forEach(item => {
                        const card = cards.find(candidate => Number(candidate.dataset.productId) === Number(item.id));
                        if (card && validQuantity(item.quantity)) cart.set(Number(item.id), { card, quantity: Number(item.quantity) });
                    });
                } catch {
                    sessionStorage.removeItem(storageKey);
                }
            };
            const saveCart = () => sessionStorage.setItem(storageKey, JSON.stringify(Array.from(cart, ([id, item]) => ({ id, quantity: item.quantity }))));

            const renderCart = () => {
                const empty = document.getElementById("cartEmpty");
                cartItems.querySelectorAll("[data-cart-line]").forEach(line => line.remove());
                let subtotalCents = 0;

                cart.forEach(({ card, quantity }, id) => {
                    const line = document.createElement("div");
                    line.className = "catalog-cart-line";
                    line.dataset.cartLine = "";
                    const name = document.createElement("strong");
                    name.textContent = card.dataset.name;
                    const detail = document.createElement("span");
                    detail.textContent = `${card.dataset.sku} · ${quantity} × ${formatCurrency(Number(card.dataset.price))}`;
                    const remove = document.createElement("button");
                    remove.type = "button";
                    remove.className = "catalog-remove-item";
                    remove.setAttribute("aria-label", `Quitar ${card.dataset.name}`);
                    remove.innerHTML = '<i class="bi bi-x-lg"></i>';
                    remove.addEventListener("click", () => { cart.delete(id); saveCart(); renderCart(); });
                    line.append(name, detail, remove);
                    cartItems.append(line);
                    subtotalCents += Math.round(Number(card.dataset.price) * 100) * quantity;
                });

                // Actualizar estado visual de fila seleccionada en cada producto
                cards.forEach(card => {
                    const isSelected = cart.has(Number(card.dataset.productId));
                    card.classList.toggle("is-selected", isSelected);
                });

                empty.classList.toggle("d-none", cart.size > 0);
                const taxCents = Math.round(subtotalCents * 18 / 100);
                document.getElementById("cartItemCount").textContent = String(cart.size);
                document.getElementById("cartSubtotal").textContent = formatCurrency(subtotalCents / 100);
                document.getElementById("cartTax").textContent = formatCurrency(taxCents / 100);
                document.getElementById("cartTotal").textContent = formatCurrency((subtotalCents + taxCents) / 100);
                document.getElementById("continueToClient").disabled = cart.size === 0;
                document.getElementById("clearCart").disabled = cart.size === 0;
            };

            cards.forEach(card => card.querySelector("[data-add-product]").addEventListener("click", () => {
                const id = Number(card.dataset.productId);
                const quantityInput = card.querySelector("[data-quantity]");
                const current = cart.get(id);
                const quantity = Number(quantityInput.value);
                if (!validQuantity(quantityInput.value) || !validQuantity((current?.quantity || 0) + quantity)) {
                    quantityError.textContent = "La cantidad debe ser un número entero mayor a cero y no exceder 2147483647.";
                    quantityError.hidden = false;
                    quantityInput.focus();
                    return;
                }
                quantityError.hidden = true;
                cart.set(id, { card, quantity: (current?.quantity || 0) + quantity });
                quantityInput.value = "1";
                saveCart();
                renderCart();
            }));

            document.getElementById("clearCart").addEventListener("click", () => {
                cart.clear(); cards.forEach(card => { card.querySelector("[data-quantity]").value = "1"; });
                quantityError.hidden = true; saveCart(); renderCart();
            });
            document.getElementById("continueToClient").addEventListener("click", () => {
                if (cart.size === 0) return;
                sessionStorage.setItem(pendingKey, JSON.stringify(Array.from(cart, ([id, item]) => ({ id, quantity: item.quantity }))));
                cart.clear(); sessionStorage.removeItem(storageKey); renderCart();
                window.location.href = "@Url.Action("Index", "Clientes")";
            });
            window.addEventListener("pageshow", event => {
                if (!event.persisted) return;
                cart.clear(); parseCart(); renderCart();
            });

            const search = document.getElementById("catalogSearch");
            const categoryButtons = Array.from(document.querySelectorAll(".catalog-category-list [data-category-filter]"));
            let selectedCategory = "";
            const applyFilters = () => {
                const term = search.value.trim().toLocaleLowerCase("es-PE");
                const targetCat = selectedCategory.trim().toLocaleLowerCase("es-PE");
                let visible = 0;
                cards.forEach(card => {
                    const cardSearch = (card.dataset.search || "").toLocaleLowerCase("es-PE");
                    const cardCat = (card.dataset.category || "").trim().toLocaleLowerCase("es-PE");
                    const matchesSearch = !term || cardSearch.includes(term);
                    const matchesCategory = !targetCat || cardCat === targetCat;
                    const matches = matchesSearch && matchesCategory;
                    card.classList.toggle("d-none", !matches);
                    if (matches) visible++;
                });
                document.getElementById("catalogNoMatch").classList.toggle("d-none", visible > 0);
                document.getElementById("catalogProductCount").textContent = String(visible);
                document.getElementById("catalogProductLabel").textContent = visible === 1 ? "producto disponible" : "productos disponibles";
            };
            search.addEventListener("input", applyFilters);
            categoryButtons.forEach(button => button.addEventListener("click", () => {
                selectedCategory = (button.dataset.categoryFilter || "").trim();
                categoryButtons.forEach(candidate => candidate.classList.toggle("active", candidate === button));
                applyFilters();
            }));

            // Modal de previsualización de imagen ampliada
            const previewModalEl = document.getElementById("imagePreviewModal");
            if (previewModalEl && typeof bootstrap !== "undefined") {
                const previewModal = new bootstrap.Modal(previewModalEl);
                const modalImg = document.getElementById("modalPreviewImg");
                const modalTitle = document.getElementById("imagePreviewTitle");
                const modalSku = document.getElementById("modalProductSku");

                document.querySelectorAll("[data-preview-img]").forEach(elem => {
                    elem.addEventListener("click", () => {
                        const src = elem.dataset.previewImg;
                        const name = elem.dataset.previewName;
                        const sku = elem.dataset.previewSku;
                        if (src) {
                            modalImg.src = src;
                            modalTitle.textContent = name || "";
                            modalSku.textContent = sku || "";
                            previewModal.show();
                        }
                    });
                    elem.addEventListener("keydown", (e) => {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            elem.click();
                        }
                    });
                });
            }

            // Desaparecer mensaje de éxito automáticamente después de 5 segundos
            const successAlert = document.getElementById("successAlert");
            if (successAlert) {
                setTimeout(() => {
                    if (typeof bootstrap !== "undefined" && bootstrap.Alert) {
                        const bsAlert = bootstrap.Alert.getOrCreateInstance(successAlert);
                        bsAlert.close();
                    } else {
                        successAlert.style.transition = "opacity 0.5s ease";
                        successAlert.style.opacity = "0";
                        setTimeout(() => successAlert.remove(), 500);
                    }
                }, 5000);
            }

            parseCart();
            renderCart();
            applyFilters();
        })();

        function populateEditModal(btn) {
            document.getElementById('editProductId').value = btn.dataset.id;
            document.getElementById('editProductSku').value = btn.dataset.sku;
            document.getElementById('editProductName').value = btn.dataset.name;
            document.getElementById('editProductCategory').value = btn.dataset.category;
            document.getElementById('editProductCost').value = btn.dataset.cost;
        }
    </script>
}
