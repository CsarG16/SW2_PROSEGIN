@{
    ViewData["Title"] = "Catálogo de EPP";
}

<div class="container-fluid px-0">
    <div class="row mb-4">
        <div class="col-12">
            <div class="prosegin-card p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3" style="background: rgba(245, 158, 11, 0.12); color: var(--prosegin-orange);">
                            <i class="bi bi-grid-3x3-gap-fill fs-2"></i>
                        </div>
                        <div>
                            <span class="badge-prosegin badge-prosegin-warning mb-1">
                                <i class="bi bi-box-seam"></i> Gestión de inventario
                            </span>
                            <h3 class="fw-bold mb-0 text-dark">Catálogo de EPP</h3>
                            <p class="text-muted small mb-0">Administra los equipos de protección personal disponibles.</p>
                        </div>
                    </div>
                    <a asp-controller="Catalogo" asp-action="RegistroProductos" class="btn-prosegin-primary">
                        <i class="bi bi-plus-circle-fill"></i> Registro de productos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="prosegin-card">
        <div class="prosegin-card-header">
            <h2 class="prosegin-card-title"><i class="bi bi-boxes"></i> Productos registrados</h2>
            <span class="badge-prosegin badge-prosegin-neutral">Catálogo EPP</span>
        </div>
        <div class="prosegin-card-body text-center py-5">
            <i class="bi bi-inbox text-muted display-5"></i>
            <h4 class="mt-3 mb-2 text-dark">Aún no hay productos registrados</h4>
            <p class="text-muted mb-0">Usa “Registro de productos” para agregar el primer equipo al catálogo.</p>
        </div>
    </div>
</div>