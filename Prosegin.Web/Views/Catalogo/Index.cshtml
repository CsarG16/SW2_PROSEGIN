@model Prosegin.Web.ViewModels.Catalogo.CatalogoIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Catálogo de EPP";
    var hasResults = Model.Productos != null && Model.Productos.Any();
    var noResultsMessage = !string.IsNullOrWhiteSpace(Model.MensajeSinResultados) ? Model.MensajeSinResultados : null;
}

<div class="container-fluid px-0">
    <!-- Encabezado del Módulo -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="prosegin-card p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3" style="background: rgba(245, 158, 11, 0.12); color: var(--prosegin-orange);">
                            <i class="bi bi-grid-3x3-gap-fill fs-2"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0 text-dark">Catálogo de EPP</h3>
                            <p class="text-muted small mb-0">Equipos de protección personal registrados con ficha técnica oficial.</p>
                        </div>
                    </div>
                    <a asp-controller="Catalogo" asp-action="RegistroProductos" class="btn-prosegin-primary">
                        <i class="bi bi-plus-circle-fill"></i> Registrar Nuevo Producto
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
                <strong class="d-block">¡Operación Exitosa!</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Barra de Filtros y Búsqueda -->
    <div class="prosegin-card mb-4">
        <div class="prosegin-card-body p-3">
            <form method="get" asp-action="Index" asp-controller="Catalogo" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label-prosegin" for="codigoProducto">Código SKU o nombre del producto</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input id="codigoProducto" name="codigoProducto" value="@Model.CodigoProducto" class="form-control form-control-prosegin" placeholder="Ej: EPP-CAS-001 o Casco 3M" />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label-prosegin" for="categoria">Categoría</label>
                    <select id="categoria" name="categoria" class="form-select form-control-prosegin form-select-sm">
                        <option value="">Todas las categorías</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            if (categoria == Model.CategoriaSeleccionada)
                            {
                                <option value="@categoria" selected>@categoria</option>
                            }
                            else
                            {
                                <option value="@categoria">@categoria</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn-prosegin-primary flex-fill">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.CodigoProducto) || !string.IsNullOrWhiteSpace(Model.CategoriaSeleccionada))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center" title="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(noResultsMessage))
    {
        <div class="alert alert-warning border-warning rounded-3 shadow-sm mb-4 d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
            <span>@noResultsMessage</span>
        </div>
    }

    <!-- Tarjeta con Tabla de Productos -->
    <div class="prosegin-card">
        <div class="prosegin-card-header d-flex justify-content-between align-items-center">
            <h2 class="prosegin-card-title"><i class="bi bi-boxes"></i> Productos en Catálogo</h2>
            <span class="badge-prosegin badge-prosegin-neutral">
                @(Model.Productos?.Count ?? 0) @((Model.Productos?.Count ?? 0) == 1 ? "producto" : "productos")
            </span>
        </div>

        <div class="prosegin-card-body p-0">
            @if (!hasResults)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted display-5"></i>
                    <h4 class="mt-3 mb-2 text-dark">Aún no hay productos que coincidan</h4>
                    <p class="text-muted mb-3">Usa el botón de arriba para registrar un nuevo equipo de protección con su ficha técnica.</p>
                    <a asp-controller="Catalogo" asp-action="RegistroProductos" class="btn-prosegin-primary btn-sm">
                        <i class="bi bi-plus-lg"></i> Agregar Producto
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-prosegin mb-0">
                        <thead>
                            <tr>
                                <th style="width: 140px;">SKU</th>
                                <th>Nombre del Equipo</th>
                                <th>Categoría EPP</th>
                                <th class="text-end" style="width: 140px;">Costo Base</th>
                                <th class="text-center" style="width: 180px;">Ficha Técnica (PDF)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prod in Model.Productos ?? Enumerable.Empty<Prosegin.Web.ViewModels.Catalogo.ProductoCatalogoItemViewModel>())
                            {
                                <tr>
                                    <td>
                                        <span class="font-monospace fw-bold text-dark">@prod.Sku</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark d-block">@prod.Nombre</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-tag me-1 text-warning"></i> @prod.Categoria
                                        </span>
                                    </td>
                                    <td class="text-end font-monospace fw-bold text-dark">
                                        S/ @prod.Precio.ToString("N2", new CultureInfo("es-PE"))
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(prod.RutaFichaTecnicaPdf))
                                        {
                                            <a asp-controller="Catalogo" asp-action="VerFicha" asp-route-id="@prod.Id"
                                               target="_blank" rel="noopener noreferrer" 
                                               class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1"
                                               title="Abrir ficha técnica en una pestaña nueva">
                                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                                <span class="small fw-semibold">Ver Ficha</span>
                                                <i class="bi bi-box-arrow-up-right" style="font-size: 0.7rem;"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Sin ficha</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
