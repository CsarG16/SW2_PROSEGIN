@model Prosegin.Web.ViewModels.Catalogo.CatalogoIndexViewModel
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = "Catálogo de EPP";
    var hasResults = Model.Productos.Any();
    var categories = Model.Productos.Select(product => product.Categoria).Where(category => !string.IsNullOrWhiteSpace(category)).Distinct().OrderBy(category => category).ToList();
}

<div class="container-fluid px-0 catalog-shopping" id="catalogShopping">
    <!-- ENCABEZADO: Catálogo de Productos EPP -->
    <div class="prosegin-card mb-4 p-3 p-md-4">
        <div class="prosegin-page-header--accent" style="margin-bottom: 0;">
            <div class="header-content">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h1 class="page-title mb-0">Catálogo de Productos EPP</h1>
                    <span class="badge-status badge-status-neutral"><span class="status-dot" style="background-color: var(--dark);"></span> <span id="catalogProductCount">@Model.Productos.Count</span> <span id="catalogProductLabel">disponibles</span></span>
                </div>
                <p class="page-subtitle mb-0">Explora el catálogo homologado, selecciona las unidades requeridas y continúa con la cotización.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Catalogo" asp-action="RegistroProductos" class="btn-prosegin-primary">
                    <i class="material-symbols-outlined">add</i> Registrar Nuevos Productos
                </a>
            </div>
        </div>
    </div>

    <div class="catalog-toolbar">
        <label class="catalog-search" for="catalogSearch">
            <i class="material-symbols-outlined">search</i>
            <input id="catalogSearch" type="search" placeholder="Buscar por código, descripción o categoría..." autocomplete="off" />
        </label>
        <div class="catalog-category-list" role="group" aria-label="Filtrar por categoría">
            <button type="button" class="catalog-category active" data-category-filter="">Todos</button>
            @foreach (var category in categories)
            {
                <button type="button" class="catalog-category" data-category-filter="@category">@category</button>
            }
        </div>
    </div>

    @if (!hasResults)
    {
        <div class="prosegin-card py-5 text-center">
            <i class="material-symbols-outlined display-5 text-muted">inventory_2</i>
            <h2 class="h5 mt-3">No hay productos disponibles</h2>
            <p class="text-muted mb-0">Los productos del catálogo aparecerán aquí cuando estén cargados en el sistema.</p>
        </div>
    }
    else
    {
        <div class="d-block mt-3" id="catalogProducts">
            <section class="catalog-product-list" aria-label="Productos disponibles">
                @foreach (var product in Model.Productos)
                {
                    var searchText = $"{product.Sku} {product.Nombre} {product.Categoria}".ToLowerInvariant();
                    var imageSrc = !string.IsNullOrWhiteSpace(product.RutaImagen)
                        ? product.RutaImagen
                        : $"/images/productos/{product.Sku}.png";
                    <article class="catalog-product" data-product-card data-product-id="@product.Id" data-sku="@product.Sku" data-name="@product.Nombre" data-category="@product.Categoria" data-search="@searchText" data-cost="@product.Precio.ToString(CultureInfo.InvariantCulture)" data-stock="@product.StockDisponible">
                        <div class="catalog-product-mark" title="Ver imagen de @product.Nombre" data-preview-img="@imageSrc" data-preview-name="@product.Nombre" data-preview-sku="@product.Sku" role="button" tabindex="0" aria-label="Ver imagen ampliada de @product.Nombre">
                            <img src="@imageSrc" alt="Foto referencial de @product.Nombre" class="catalog-product-thumb" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                            <div class="catalog-product-fallback d-none" aria-hidden="true">
                                <i class="material-symbols-outlined">verified_user</i>
                                <span>EPP</span>
                            </div>
                        </div>
                        <div class="catalog-product-info">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span class="catalog-sku">@product.Sku</span>
                                <span class="catalog-category-label">@product.Categoria</span>
                            </div>
                            <h2 class="catalog-product-name">@product.Nombre</h2>
                            <div class="catalog-product-meta">
                                <span><i class="material-symbols-outlined me-1" style="font-size: 1rem;">speed</i>Peso: @product.PesoKg.ToString("0.000", new CultureInfo("es-PE")) kg</span>
                                @if (!string.IsNullOrWhiteSpace(product.RutaFichaTecnicaPdf))
                                {
                                    <a asp-controller="Catalogo" asp-action="VerFicha" asp-route-id="@product.Id" target="_blank" rel="noopener noreferrer" class="text-danger text-decoration-none"><i class="material-symbols-outlined me-1 text-danger" style="font-size: 1.05rem;">picture_as_pdf</i>Ficha técnica</a>
                                }
                            </div>
                        </div>
                        <div class="catalog-unit-price text-end">
                            <span class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.04em;">Costo Base</span>
                            <strong class="text-dark d-block fw-bold" style="font-size: 1.25rem;">S/ @product.Precio.ToString("N2", new CultureInfo("es-PE"))</strong>
                        </div>
                        <div class="catalog-add-controls justify-content-end">
                            <button type="button" class="btn-prosegin-dark btn-sm" data-bs-toggle="modal" data-bs-target="#editProductModal" onclick="populateEditModal(this)" data-id="@product.Id" data-sku="@product.Sku" data-name="@product.Nombre" data-category="@product.Categoria" data-stock="@product.StockDisponible" data-cost="@product.Precio.ToString(CultureInfo.InvariantCulture)" data-peso="@product.PesoKg.ToString("0.000", CultureInfo.InvariantCulture)" data-weight="@product.PesoKg.ToString("0.000", CultureInfo.InvariantCulture)" data-ficha-url="@product.RutaFichaTecnicaPdf" data-ficha-name="@product.NombreArchivoPdf" data-tarifas="@JsonSerializer.Serialize(product.TarifasProveedor)">
                                <i class="material-symbols-outlined" style="font-size: 1rem;">edit</i><span>Editar</span>
                            </button>
                        </div>
                    </article>
                }
                <div class="catalog-no-match d-none" id="catalogNoMatch">
                    <i class="material-symbols-outlined">search</i><span>No hay productos que coincidan con la búsqueda.</span>
                </div>
            </section>
        </div>
    }
</div>

<!-- Modal Editar Producto (Estilo Prosegin Core) -->
<div class="modal fade" id="editProductModal" tabindex="-1" aria-labelledby="editProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 880px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <form id="editProductForm" method="post" asp-action="EditarProducto" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editProductId" name="Id" />

                <!-- Modal Header -->
                <div class="modal-header border-bottom py-3 px-4 bg-light bg-opacity-75">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center rounded-3 text-white shadow-sm" style="width: 42px; height: 42px; background-color: var(--dark);">
                            <i class="material-symbols-outlined fs-5">edit_note</i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-dark mb-0 fs-6" id="editProductModalLabel">Editar Producto del Catálogo</h5>
                            <small class="text-muted" style="font-size: 0.78rem;">Actualiza las especificaciones maestras, costo base y tarifas de proveedores autorizados</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4 bg-white">
                    <!-- Sección 1: Datos Generales y Costos -->
                    <div class="p-3 rounded-3 mb-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="badge bg-white text-dark border px-2 py-1 small fw-semibold">
                                <i class="material-symbols-outlined align-middle me-1" style="font-size: 1rem; color: var(--accent);">inventory_2</i>
                                Información General y Parámetros
                            </span>
                        </div>

                        <!-- Fila 1: SKU, Categoría, Costo Base, Peso -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Código SKU</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="material-symbols-outlined" style="font-size: 1rem;">lock</i></span>
                                    <input type="text" class="form-control bg-white font-monospace fw-bold border-start-0 ps-0" id="editProductSku" name="Sku" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Categoría</label>
                                <input type="text" class="form-control form-control-sm" id="editProductCategory" name="Categoria" placeholder="Ej: Protección craneal" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Costo Base Mayorista</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light text-secondary fw-bold border-end-0">S/</span>
                                    <input type="number" step="0.01" min="0.01" class="form-control border-start-0 ps-1 fw-bold text-dark" id="editProductCost" name="Precio" placeholder="0.00" required />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold small text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Peso Aprox.</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" step="0.001" min="0.001" max="9999.99" class="form-control border-end-0 fw-bold text-dark" id="editProductWeight" name="PesoKg" placeholder="0.500" required />
                                    <span class="input-group-text bg-light text-secondary fw-semibold border-start-0">kg</span>
                                </div>
                            </div>
                        </div>

                        <!-- Fila 2: Nombre Completo y Ficha Técnica -->
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label fw-bold small text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Nombre / Descripción del Producto</label>
                                <input type="text" class="form-control form-control-sm" id="editProductName" name="Nombre" placeholder="Descripción completa del producto EPP" required />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold small text-secondary text-uppercase mb-1" style="font-size: 0.75rem;">Ficha Técnica PDF (Opcional)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white border-end-0 text-danger"><i class="material-symbols-outlined" style="font-size: 1.1rem;">picture_as_pdf</i></span>
                                    <input type="file" class="form-control form-control-sm border-start-0" id="editProductFile" name="FichaTecnica" accept=".pdf" />
                                </div>
                                <span class="text-muted d-block mt-1" style="font-size: 0.72rem;">Dejar vacío si no deseas reemplazar el PDF actual.</span>
                            </div>
                        </div>
                        <div id="editFichaViewer" class="ficha-viewer d-none mt-3">
                            <div class="ficha-viewer-toolbar">
                                    <span class="ficha-viewer-name" id="editFichaName">Ficha técnica</span>
                                    <div class="d-flex align-items-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="editPaginaAnterior">‹</button>
                                        <span class="ficha-viewer-page" id="editPaginaTexto">Página 1</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="editPaginaSiguiente">›</button>
                                        <span class="ficha-viewer-separator"></span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="editZoomMenos">−</button>
                                        <span class="ficha-viewer-page" id="editZoomTexto">100%</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="editZoomMas">+</button>
                                    </div>
                            </div>
                            <div class="ficha-viewer-page-wrap">
                                <canvas id="editFichaCanvas" aria-label="Contenido de la ficha técnica"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Sección 2: Tarifas de Proveedores Homologados -->
                    <div class="border rounded-3 p-3 bg-white">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark border px-2 py-1 small fw-semibold">
                                    <i class="material-symbols-outlined align-middle me-1" style="font-size: 1rem; color: var(--accent);">storefront</i>
                                    Tarifas de Proveedores Homologados
                                </span>
                            </div>
                            <span class="text-muted small" style="font-size: 0.75rem;">
                                <i class="material-symbols-outlined text-warning align-middle me-1" style="font-size: 0.95rem;">info</i>
                                Seleccione el radio button del proveedor principal para compras JIT
                            </span>
                        </div>

                        <div class="table-responsive border rounded-2">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                                    <tr class="text-secondary small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.03em;">
                                        <th style="min-width: 250px;" class="ps-3 py-2">Proveedor</th>
                                        <th style="width: 180px;" class="py-2">Tarifa Compra (S/.)</th>
                                        <th style="width: 160px;" class="py-2">Plazo Entrega</th>
                                        <th style="width: 110px;" class="text-center py-2">Principal</th>
                                    </tr>
                                </thead>
                                <tbody id="editProviderTariffs">
                                    <tr>
                                        <td colspan="4" class="small text-muted p-4 text-center">Selecciona un producto para cargar sus proveedores autorizados.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top py-3 px-4 bg-light bg-opacity-50 d-flex justify-content-end gap-2">
                    <button type="button" class="btn-prosegin-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn-prosegin-primary">
                        <i class="material-symbols-outlined">check</i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Vista Previa de Imagen EPP -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header border-bottom-0 pb-1 pt-3 px-4">
                <div>
                    <span class="badge bg-light text-secondary border font-monospace" id="modalProductSku"></span>
                    <h2 class="modal-title fs-6 fw-bold mt-1 text-dark mb-0" id="imagePreviewTitle"></h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="p-3 bg-light rounded-4 d-inline-block shadow-sm w-100" style="max-width: 360px;">
                    <img id="modalPreviewImg" src="" alt="Imagen referencial del producto" class="img-fluid" style="max-height: 320px; object-fit: contain; border-radius: 8px;" />
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0 px-4 pb-3 justify-content-between">
                <small class="text-muted"><i class="material-symbols-outlined text-success me-1" style="font-size: 1rem;">verified_user</i>Imagen de referencia homologada</small>
                <button type="button" class="btn-prosegin-secondary btn-sm px-3" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos Prosegin Core para Catálogo */
    .catalog-product-mark:hover {
        border-color: var(--dark) !important;
        box-shadow: 0 4px 10px rgba(0, 13, 49, 0.14) !important;
    }
    .catalog-category:hover:not(.active) {
        background-color: #f1f5f9 !important;
        border-color: #cbd5e1 !important;
        color: var(--text-dark) !important;
    }
    .catalog-category.active {
        background-color: var(--dark) !important;
        border-color: var(--dark) !important;
        color: #ffffff !important;
        box-shadow: 0 2px 6px rgba(0, 13, 49, 0.25) !important;
    }
    .btn-dark:hover {
        background-color: var(--dark-hover) !important;
        border-color: var(--dark-hover) !important;
        color: #ffffff !important;
    }
    .form-control:focus {
        border-color: var(--dark) !important;
        box-shadow: 0 0 0 0.2rem rgba(0, 13, 49, 0.12) !important;
    }
</style>

@section Scripts {
    <script>
        (() => {
            const cards = Array.from(document.querySelectorAll("[data-product-card]"));

            const search = document.getElementById("catalogSearch");
            const categoryButtons = Array.from(document.querySelectorAll(".catalog-category-list [data-category-filter]"));
            let selectedCategory = "";
            const applyFilters = () => {
                const term = search.value.trim().toLocaleLowerCase("es-PE");
                const targetCat = selectedCategory.trim().toLocaleLowerCase("es-PE");
                let visible = 0;
                cards.forEach(card => {
                    const cardSearch = (card.dataset.search || "").toLocaleLowerCase("es-PE");
                    const cardCat = (card.dataset.category || "").trim().toLocaleLowerCase("es-PE");
                    const matchesSearch = !term || cardSearch.includes(term);
                    const matchesCategory = !targetCat || cardCat === targetCat;
                    const matches = matchesSearch && matchesCategory;
                    card.classList.toggle("d-none", !matches);
                    if (matches) visible++;
                });
                document.getElementById("catalogNoMatch").classList.toggle("d-none", visible > 0);
                document.getElementById("catalogProductCount").textContent = String(visible);
                document.getElementById("catalogProductLabel").textContent = visible === 1 ? "producto disponible" : "productos disponibles";
            };
            search.addEventListener("input", applyFilters);
            categoryButtons.forEach(button => button.addEventListener("click", () => {
                selectedCategory = (button.dataset.categoryFilter || "").trim();
                categoryButtons.forEach(candidate => candidate.classList.toggle("active", candidate === button));
                applyFilters();
            }));

            // Modal de previsualización de imagen ampliada
            const previewModalEl = document.getElementById("imagePreviewModal");
            if (previewModalEl && typeof bootstrap !== "undefined") {
                const previewModal = new bootstrap.Modal(previewModalEl);
                const modalImg = document.getElementById("modalPreviewImg");
                const modalTitle = document.getElementById("imagePreviewTitle");
                const modalSku = document.getElementById("modalProductSku");

                document.querySelectorAll("[data-preview-img]").forEach(elem => {
                    elem.addEventListener("click", () => {
                        const src = elem.dataset.previewImg;
                        const name = elem.dataset.previewName;
                        const sku = elem.dataset.previewSku;
                        if (src) {
                            modalImg.src = src;
                            modalTitle.textContent = name || "";
                            modalSku.textContent = sku || "";
                            previewModal.show();
                        }
                    });
                    elem.addEventListener("keydown", (e) => {
                        if (e.key === "Enter" || e.key === " ") {
                            e.preventDefault();
                            elem.click();
                        }
                    });
                });
            }

            // Desaparecer mensaje de éxito automáticamente después de 5 segundos
            const successAlert = document.getElementById("successAlert");
            if (successAlert) {
                setTimeout(() => {
                    if (typeof bootstrap !== "undefined" && bootstrap.Alert) {
                        const bsAlert = bootstrap.Alert.getOrCreateInstance(successAlert);
                        bsAlert.close();
                    } else {
                        successAlert.style.transition = "opacity 0.5s ease";
                        successAlert.style.opacity = "0";
                        setTimeout(() => successAlert.remove(), 500);
                    }
                }, 5000);
            }

            applyFilters();
        })();

        let editPdfViewer = null;

        async function configurarVisorFicha(contenedor, canvas, nombre, url, nombreArchivo, paginaTexto, zoomTexto) {
            if (!contenedor || !canvas) return;
            contenedor.classList.toggle('d-none', !url);
            if (!url) {
                editPdfViewer?.destroy();
                editPdfViewer = null;
                window.ProseginToast?.info('El producto no tiene una ficha técnica registrada');
                return;
            }
            nombre.textContent = nombreArchivo || 'Ficha técnica guardada';
            editPdfViewer?.destroy();
            editPdfViewer = await window.ProseginPdfViewer.mount({
                canvas,
                source: url,
                onChange: (pagina, total, zoom) => {
                    paginaTexto.textContent = `Página ${pagina} de ${total}`;
                    zoomTexto.textContent = `${zoom}%`;
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const editFile = document.getElementById('editProductFile');
            const editViewer = document.getElementById('editFichaViewer');
            const editCanvas = document.getElementById('editFichaCanvas');
            const editName = document.getElementById('editFichaName');
            const editPaginaTexto = document.getElementById('editPaginaTexto');
            const editZoomTexto = document.getElementById('editZoomTexto');
            let editObjectUrl = null;

            async function cargarEdicion(source, nombre) {
                await configurarVisorFicha(editViewer, editCanvas, editName, source, nombre, editPaginaTexto, editZoomTexto);
            }

            if (editFile) {
                editFile.addEventListener('change', async () => {
                    const file = editFile.files && editFile.files[0];
                    if (!file) return;
                    if (!/\.pdf$/i.test(file.name)) {
                        editFile.value = '';
                        window.ProseginToast?.error('Solo se admiten archivos en formato PDF');
                        return;
                    }
                    if (file.size > 5 * 1024 * 1024) {
                        editFile.value = '';
                        window.ProseginToast?.error('El archivo no debe superar los 5 MB');
                        return;
                    }
                    if (editObjectUrl) URL.revokeObjectURL(editObjectUrl);
                    editObjectUrl = URL.createObjectURL(file);
                    await cargarEdicion(editObjectUrl, file.name);
                });
            }

            document.getElementById('editPaginaAnterior').addEventListener('click', () => {
                editPdfViewer?.previous().then(changed => {
                    if (!changed) window.ProseginToast?.info('Ya se encuentra en la primera página del documento');
                });
            });
            document.getElementById('editPaginaSiguiente').addEventListener('click', () => {
                editPdfViewer?.next().then(changed => {
                    if (!changed) window.ProseginToast?.info('Ya se encuentra en la última página del documento');
                });
            });
            document.getElementById('editZoomMenos').addEventListener('click', () => editPdfViewer?.zoomOut());
            document.getElementById('editZoomMas').addEventListener('click', () => editPdfViewer?.zoomIn());
        });

        function populateEditModal(btn) {
            document.getElementById('editProductId').value = btn.dataset.id;
            document.getElementById('editProductSku').value = btn.dataset.sku;
            document.getElementById('editProductName').value = btn.dataset.name;
            document.getElementById('editProductCategory').value = btn.dataset.category;
            document.getElementById('editProductCost').value = btn.dataset.cost;
            document.getElementById('editProductWeight').value = Number(btn.dataset.weight || btn.dataset.peso || 0).toFixed(3);
            configurarVisorFicha(
                document.getElementById('editFichaViewer'),
                document.getElementById('editFichaCanvas'),
                document.getElementById('editFichaName'),
                btn.dataset.fichaUrl,
                btn.dataset.fichaName,
                document.getElementById('editPaginaTexto'),
                document.getElementById('editZoomTexto'));

            const container = document.getElementById('editProviderTariffs');
            container.replaceChildren();
            const tarifas = JSON.parse(btn.dataset.tarifas || '[]');
            if (tarifas.length === 0) {
                const emptyRow = document.createElement('tr');
                const emptyCell = document.createElement('td');
                emptyCell.colSpan = 4;
                emptyCell.className = 'text-center text-muted small py-4';
                emptyCell.textContent = 'Este producto no cuenta con proveedores autorizados registrados.';
                emptyRow.append(emptyCell);
                container.append(emptyRow);
                return;
            }

            tarifas.forEach((tarifa, index) => {
                const row = document.createElement('tr');

                // Proveedor con nombre y mini icono
                const supplier = document.createElement('td');
                supplier.className = 'ps-3 py-2';
                const supplierWrapper = document.createElement('div');
                supplierWrapper.className = 'd-flex align-items-center gap-2';
                const suppIcon = document.createElement('i');
                suppIcon.className = 'material-symbols-outlined text-muted';
                suppIcon.style.fontSize = '1.1rem';
                suppIcon.textContent = 'business';
                const suppName = document.createElement('span');
                suppName.className = 'fw-semibold text-dark';
                suppName.textContent = tarifa.Proveedor;
                supplierWrapper.append(suppIcon, suppName);
                supplier.append(supplierWrapper);

                // Tarifa de compra con input group S/.
                const priceCell = document.createElement('td');
                priceCell.className = 'py-2';
                const priceGroup = document.createElement('div');
                priceGroup.className = 'input-group input-group-sm';
                const pricePrefix = document.createElement('span');
                pricePrefix.className = 'input-group-text bg-light text-muted border-end-0 fw-semibold';
                pricePrefix.textContent = 'S/';
                const price = document.createElement('input');
                price.type = 'number';
                price.min = '0.01';
                price.step = '0.01';
                price.required = true;
                price.name = `tarifasProveedores[${index}].CostoCompra`;
                price.value = Number(tarifa.CostoCompra).toFixed(2);
                price.className = 'form-control form-control-sm border-start-0 ps-1 fw-bold';
                priceGroup.append(pricePrefix, price);
                priceCell.append(priceGroup);

                // Plazo de entrega con input group hrs
                const leadCell = document.createElement('td');
                leadCell.className = 'py-2';
                const leadGroup = document.createElement('div');
                leadGroup.className = 'input-group input-group-sm';
                const lead = document.createElement('input');
                lead.type = 'number';
                lead.min = '1';
                lead.max = '720';
                lead.required = true;
                lead.name = `tarifasProveedores[${index}].PlazoEntregaHoras`;
                lead.value = tarifa.PlazoEntregaHoras;
                lead.className = 'form-control form-control-sm border-end-0 fw-semibold';
                const leadSuffix = document.createElement('span');
                leadSuffix.className = 'input-group-text bg-light text-muted border-start-0 small';
                leadSuffix.textContent = 'hrs';
                leadGroup.append(lead, leadSuffix);
                leadCell.append(leadGroup);

                // Radio button proveedor principal
                const principalCell = document.createElement('td');
                principalCell.className = 'text-center py-2';
                const principal = document.createElement('input');
                principal.type = 'radio';
                principal.name = 'proveedorPrincipalId';
                principal.value = tarifa.ProveedorId;
                principal.checked = tarifa.EsPrincipal;
                principal.required = true;
                principal.className = 'form-check-input';
                principal.style.cursor = 'pointer';
                principal.setAttribute('aria-label', `Marcar ${tarifa.Proveedor} como principal`);
                principalCell.append(principal);

                const providerId = document.createElement('input');
                providerId.type = 'hidden';
                providerId.name = `tarifasProveedores[${index}].ProveedorId`;
                providerId.value = tarifa.ProveedorId;
                supplier.append(providerId);

                row.append(supplier, priceCell, leadCell, principalCell);
                container.append(row);
            });
        }
    </script>
}
