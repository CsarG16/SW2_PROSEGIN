@model IEnumerable<Prosegin.Data.Entities.Producto>

@{
    ViewData["Title"] = "Catálogo de EPP";
}

<div class="container-fluid px-0">
    <!-- Encabezado del Módulo -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="prosegin-card p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3" style="background: rgba(245, 158, 11, 0.12); color: var(--prosegin-orange);">
                            <i class="bi bi-grid-3x3-gap-fill fs-2"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0 text-dark">Catálogo de EPP</h3>
                            <p class="text-muted small mb-0">Equipos de protección personal registrados con ficha técnica oficial.</p>
                        </div>
                    </div>
                    <a asp-controller="Catalogo" asp-action="RegistroProductos" class="btn-prosegin-primary">
                        <i class="bi bi-plus-circle-fill"></i> Registrar Nuevo Producto
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
                <strong class="d-block">¡Operación Exitosa!</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tarjeta con Tabla de Productos -->
    <div class="prosegin-card">
        <div class="prosegin-card-header d-flex justify-content-between align-items-center">
            <h2 class="prosegin-card-title"><i class="bi bi-boxes"></i> Productos en Catálogo</h2>
            <span class="badge-prosegin badge-prosegin-neutral">
                @(Model != null ? Model.Count() : 0) @(Model != null && Model.Count() == 1 ? "producto" : "productos")
            </span>
        </div>

        <div class="prosegin-card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted display-5"></i>
                    <h4 class="mt-3 mb-2 text-dark">Aún no hay productos registrados</h4>
                    <p class="text-muted mb-3">Usa el botón de arriba para registrar el primer equipo de protección con su ficha técnica.</p>
                    <a asp-controller="Catalogo" asp-action="RegistroProductos" class="btn-prosegin-primary btn-sm">
                        <i class="bi bi-plus-lg"></i> Agregar Primer Producto
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-prosegin mb-0">
                        <thead>
                            <tr>
                                <th style="width: 130px;">SKU</th>
                                <th>Nombre del Equipo</th>
                                <th>Categoría EPP</th>
                                <th class="text-end" style="width: 140px;">Costo Base</th>
                                <th class="text-center" style="width: 180px;">Ficha Técnica (PDF)</th>
                                <th style="width: 130px;">Fecha Registro</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prod in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="font-monospace fw-bold text-dark">@prod.Sku</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark d-block">@prod.Nombre</span>
                                        @if (!string.IsNullOrWhiteSpace(prod.Descripcion))
                                        {
                                            <span class="text-muted small">@prod.Descripcion</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-tag me-1 text-warning"></i> @prod.Categoria
                                        </span>
                                    </td>
                                    <td class="text-end font-monospace fw-bold text-dark">
                                        S/ @prod.CostoReferencial.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrWhiteSpace(prod.RutaFichaTecnicaPdf))
                                        {
                                            <a href="@prod.RutaFichaTecnicaPdf" target="_blank" rel="noopener noreferrer" 
                                               class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 shadow-sm px-2 py-1"
                                               title="Abrir ficha técnica en una pestaña nueva">
                                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                                <span class="small fw-semibold">Ver Ficha</span>
                                                <i class="bi bi-box-arrow-up-right" style="font-size: 0.7rem;"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Sin ficha</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @prod.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>