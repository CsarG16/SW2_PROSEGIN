@{
    ViewData["Title"] = "Panel Principal";
}

<div class="container-fluid px-0">
    <!-- Encabezado del Panel -->
    <div class="prosegin-card p-4 mb-4">
        <div class="prosegin-page-header--accent" style="margin-bottom: 0;">
            <div class="d-flex align-items-center gap-3">
                <div class="row-icon-avatar" style="width: 48px; height: 48px; background: var(--accent-light); color: var(--accent);">
                    <i class="material-symbols-outlined fs-3">verified_user</i>
                </div>
                <div class="header-content" style="border-left: none; padding-left: 0;">
                    <span class="badge-status badge-status-warning mb-1" style="font-size: 0.68rem;">
                        <span class="status-dot"></span> Plataforma Oficial PROSEGIN Core
                    </span>
                    <h1 class="page-title" style="font-size: 1.25rem;">Sistema de Operaciones EPP</h1>
                    <p class="page-subtitle">Gestión comercial y logística bajo modelo Just-in-Time • Las Malvinas, Lima.</p>
                </div>
            </div>
            <a asp-controller="Clientes" asp-action="Create" class="btn-prosegin-primary">
                <i class="material-symbols-outlined">person_add</i> Registrar Cliente
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-stat-card">
                <div class="kpi-header">
                    <span class="kpi-title">Total en Circuito</span>
                    <div class="kpi-icon-pill" style="background-color: #f1f5f9; color: #475569;">
                        <i class="material-symbols-outlined">inventory_2</i>
                    </div>
                </div>
                <div class="kpi-value">18</div>
                <div class="kpi-footer text-success">
                    <i class="material-symbols-outlined" style="font-size: 1rem;">arrow_outward</i> +4 programados hoy
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-stat-card">
                <div class="kpi-header">
                    <span class="kpi-title">En Picking & Embalaje</span>
                    <div class="kpi-icon-pill" style="background-color: var(--accent-light); color: var(--accent-text);">
                        <i class="material-symbols-outlined">inventory</i>
                    </div>
                </div>
                <div class="kpi-value">4</div>
                <div class="kpi-footer text-muted">
                    <i class="material-symbols-outlined" style="font-size: 1rem;">speed</i> Tasa empaque 94.2%
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-stat-card">
                <div class="kpi-header">
                    <span class="kpi-title">Por Facturar a Crédito</span>
                    <div class="kpi-icon-pill" style="background-color: var(--state-success-bg); color: var(--state-success-text);">
                        <i class="material-symbols-outlined">receipt_long</i>
                    </div>
                </div>
                <div class="kpi-value">S/ 142,850</div>
                <div class="kpi-footer text-success">
                    <i class="material-symbols-outlined" style="font-size: 1rem;">check_circle</i> SUNAT Val. OK
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-stat-card">
                <div class="kpi-header">
                    <span class="kpi-title">Riesgo Retraso SLA</span>
                    <div class="kpi-icon-pill" style="background-color: var(--state-danger-bg); color: var(--state-danger-text);">
                        <i class="material-symbols-outlined">warning</i>
                    </div>
                </div>
                <div class="kpi-value text-danger">1</div>
                <div class="kpi-footer text-danger">
                    <i class="material-symbols-outlined" style="font-size: 1rem;">schedule</i> &gt;36h Alerta Activa
                </div>
            </div>
        </div>
    </div>
</div>
