@{
    ViewData["Title"] = "Panel Principal";
}

<div class="container-fluid px-0">
    <!-- Fila de Bienvenida -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="prosegin-card p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-3 rounded-3" style="background: rgba(245, 158, 11, 0.12); color: var(--prosegin-orange);">
                            <i class="bi bi-shield-shaded fs-2"></i>
                        </div>
                        <div>
                            <span class="badge-prosegin badge-prosegin-warning mb-1">
                                <i class="bi bi-stars"></i> Plataforma Oficial PROSEGIN Core
                            </span>
                            <h3 class="fw-bold mb-0 text-dark">Sistema de Operaciones EPP</h3>
                            <p class="text-muted small mb-0">Gestión comercial y logística bajo modelo Just-in-Time • Las Malvinas, Lima.</p>
                        </div>
                    </div>
                    <div>
                        <a asp-controller="Clientes" asp-action="Create" class="btn-prosegin-primary">
                            <i class="bi bi-person-plus-fill"></i> Registrar Datos Tributarios
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Cards de Ejemplo (Diseño Oficial de la Imagen) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-stat-card">
                <div class="kpi-header">
                    <span class="kpi-title">Total en Circuito</span>
                    <div class="kpi-icon-pill" style="background-color: #f1f5f9; color: #475569;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
                <div class="kpi-value">18</div>
                <div class="kpi-footer text-success">
                    <i class="bi bi-arrow-up-right"></i> +4 programados hoy
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-stat-card">
                <div class="kpi-header">
                    <span class="kpi-title">En Picking & Embalaje</span>
                    <div class="kpi-icon-pill" style="background-color: var(--state-warning-bg); color: var(--state-warning-text);">
                        <i class="bi bi-archive"></i>
                    </div>
                </div>
                <div class="kpi-value">4</div>
                <div class="kpi-footer text-muted">
                    <i class="bi bi-speedometer2"></i> Tasa empaque 94.2%
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-stat-card">
                <div class="kpi-header">
                    <span class="kpi-title">Por Facturar a Crédito</span>
                    <div class="kpi-icon-pill" style="background-color: var(--state-success-bg); color: var(--state-success-text);">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
                <div class="kpi-value">S/ 142,850</div>
                <div class="kpi-footer text-success">
                    <i class="bi bi-check-circle"></i> SUNAT Val. OK
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="kpi-stat-card">
                <div class="kpi-header">
                    <span class="kpi-title">Riesgo Retraso SLA</span>
                    <div class="kpi-icon-pill" style="background-color: var(--state-danger-bg); color: var(--state-danger-text);">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
                <div class="kpi-value text-danger">1</div>
                <div class="kpi-footer text-danger">
                    <i class="bi bi-clock-history"></i> &gt;36h Alerta Activa
                </div>
            </div>
        </div>
    </div>
</div>
