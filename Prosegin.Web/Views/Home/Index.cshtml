@{
    ViewData["Title"] = "Bienvenidos";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="welcome-pure-card text-center p-4 p-md-5">
                
                <!-- Icono de Bienvenida -->
                <div class="welcome-icon-wrapper mb-4">
                    <div class="welcome-icon-circle">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>

                <!-- Título y Saludo -->
                <div class="badge-tag mb-3">
                    <i class="bi bi-stars"></i> Inicio de Proyecto
                </div>
                
                <h1 class="welcome-heading mb-3">
                    ¡Bienvenidos, compañeros de <span>PROSEGIN</span>!
                </h1>

                <p class="welcome-message mb-4">
                    Les damos la bienvenida al espacio oficial del sistema de <strong>PROSEGIN</strong>. Aquí estaremos desarrollando la solución integral para la gestión de nuestros Equipos de Protección Personal (EPP), coordinando el abastecimiento y la atención comercial de la empresa.
                </p>

                <!-- Tarjeta de Estado del Proyecto -->
                <div class="project-info-card text-start p-4 mb-4">
                    <div class="row g-3">
                        <div class="col-sm-4 text-center text-sm-start border-end-sm">
                            <div class="text-secondary small text-uppercase fw-bold">Empresa</div>
                            <div class="text-white fw-bold">PROSEGIN S.A.C.</div>
                        </div>
                        <div class="col-sm-4 text-center text-sm-start border-end-sm">
                            <div class="text-secondary small text-uppercase fw-bold">Sede Operativa</div>
                            <div class="text-white fw-bold">Las Malvinas, Lima</div>
                        </div>
                        <div class="col-sm-4 text-center text-sm-start">
                            <div class="text-secondary small text-uppercase fw-bold">Estado Actual</div>
                            <div class="text-warning fw-bold">
                                <i class="bi bi-code-slash me-1"></i> Arquitectura Lista
                            </div>
                        </div>
                    </div>
                </div>

                <div class="welcome-quote text-muted small">
                    <i class="bi bi-chat-quote-fill me-1 text-warning"></i>
                    La arquitectura base y el repositorio se encuentran preparados para comenzar a construir juntos.
                </div>

            </div>
        </div>
    </div>
</div>
