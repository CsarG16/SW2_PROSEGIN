@model Prosegin.Web.ViewModels.Clientes.ClienteCreateViewModel
@using Prosegin.Data.Entities

@{
    ViewData["Title"] = "Registro de Datos Tributarios";
}

<div class="container-fluid px-0">
    <!-- Encabezado Principal del Registro -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div class="page-header-prosegin">
            <h4>
                <i class="bi bi-file-earmark-text text-warning me-2"></i> Registrar Datos Tributarios
            </h4>
            <p>
                Ingrese la información fiscal del cliente para la correcta emisión de comprobantes de pago (Facturas y Guías de Remisión).
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center shadow-sm alert-animated" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
                <strong class="d-block">¡Registro Exitoso!</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-3 mb-4 d-flex align-items-center shadow-sm alert-animated" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
            <div>
                <strong class="d-block text-dark">Alerta Tributaria</strong>
                <span class="text-dark small">@TempData["WarningMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="formDatosTributarios" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="EstadoSunat" id="hiddenEstadoSunat" value="ACTIVO" />
        <input type="hidden" asp-for="CondicionSunat" id="hiddenCondicionSunat" value="HABIDO" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

        <!-- Alerta Dinámica de Riesgo Tributario (No Habido / Baja) -->
        <div id="alertaRiesgoTributario" class="alert alert-danger d-none mb-4 p-3 border-danger rounded-3 shadow-sm d-flex align-items-start gap-3">
            <i class="bi bi-shield-slash-fill fs-3 text-danger flex-shrink-0"></i>
            <div>
                <div class="fw-bold text-danger text-uppercase" id="alertaRiesgoTitulo">Riesgo Tributario Crítico</div>
                <div class="small text-danger" id="alertaRiesgoMensaje"></div>
            </div>
        </div>

        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: FORMULARIO PRINCIPAL -->
            <div class="col-lg-8">
                
                <!-- SECCIÓN 1: DATOS PRINCIPALES -->
                <div class="prosegin-card mb-4">
                    <div class="prosegin-card-header--section">
                        <span class="section-step-number">1</span>
                        <span class="section-step-title">
                            <i class="bi bi-building me-1"></i> Datos Principales
                        </span>
                    </div>

                    <div class="prosegin-card-body prosegin-card-body--form">
                        <!-- Campo RUC -->
                        <div class="mb-3">
                            <label asp-for="Ruc" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                RUC <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted fw-bold">
                                    <i class="bi bi-hash"></i>
                                </span>
                                <input asp-for="Ruc" id="txtRuc" class="form-control form-control-prosegin font-monospace fw-bold fs-6 border-start-0" 
                                       placeholder="Ej: 20100047218" maxlength="11" autocomplete="off"
                                       inputmode="numeric" />
                                <button type="button" class="btn btn-dark d-flex align-items-center gap-2 px-3 fw-bold" id="btnConsultarSunat">
                                    <i class="bi bi-search" id="iconConsultar"></i>
                                    <span id="textBtnConsultar">Consultar SUNAT</span>
                                </button>
                            </div>
                            
                            <!-- Mensaje de estado dinámico -->
                            <div id="rucStatusBox" class="mt-1 small">
                                <span id="rucStatusText" class="text-muted" style="font-size: 0.75rem;">
                                    Ingrese 11 dígitos numéricos
                                </span>
                            </div>
                            <span asp-validation-for="Ruc" class="text-danger small d-block"></span>
                        </div>

                        <!-- Razón Social -->
                        <div class="mb-3">
                            <label asp-for="RazonSocial" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                Razón Social <span class="text-danger">*</span>
                            </label>
                            <input asp-for="RazonSocial" id="txtRazonSocial" class="form-control form-control-prosegin form-control-sm text-uppercase" 
                                   placeholder="Ej: DISTRIBUIDORA INDUSTRIAL DEL PERÚ S.A.C." autocomplete="off" />
                            <span asp-validation-for="RazonSocial" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Nombre Comercial y Estado -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-prosegin small text-uppercase fw-bold mb-1">Nombre Comercial</label>
                                <input type="text" id="txtNombreComercial" class="form-control form-control-prosegin form-control-sm" 
                                       placeholder="Ej: DISPRO PERÚ" autocomplete="off" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                    <i class="bi bi-shield-check text-muted me-1"></i> Estado Tributario en SUNAT
                                </label>
                                <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light border border-light-subtle" style="min-height: 42px;">
                                    <!-- Estado -->
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Estado:</span>
                                        <span id="badgeEstadoSunat" class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-dash-circle" id="iconEstadoSunat"></i>
                                            <span id="textEstadoSunat">Pendiente</span>
                                        </span>
                                    </div>

                                    <div class="vr my-1 text-muted opacity-25"></div>

                                    <!-- Condición -->
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Condición:</span>
                                        <span id="badgeCondicionSunat" class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-dash-circle" id="iconCondicionSunat"></i>
                                            <span id="textCondicionSunat">Pendiente</span>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN 2: DOMICILIO FISCAL -->
                <div class="prosegin-card mb-4">
                    <div class="prosegin-card-header--section">
                        <span class="section-step-number">2</span>
                        <span class="section-step-title">
                            <i class="bi bi-geo-alt me-1"></i> Domicilio Fiscal
                        </span>
                    </div>

                    <div class="prosegin-card-body prosegin-card-body--form">
                        <!-- Dirección Fiscal Completa -->
                        <div class="mb-3">
                            <label asp-for="DireccionFiscal" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                Dirección Fiscal <span class="text-danger">*</span>
                            </label>
                            <input asp-for="DireccionFiscal" id="txtDireccionFiscal" class="form-control form-control-prosegin form-control-sm" 
                                   placeholder="Ej: Av. Argentina 1850, Cercado de Lima" autocomplete="off" />
                            <span asp-validation-for="DireccionFiscal" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Ubigeo Desglosado -->
                        <div class="row g-2 mb-3">
                            <div class="col-sm-3">
                                <label asp-for="Departamento" class="form-label-prosegin small text-uppercase" style="font-size: 0.75rem;">Departamento</label>
                                <input asp-for="Departamento" type="text" id="txtDepartamento" class="form-control form-control-prosegin form-control-sm text-dark" placeholder="Ej: Lima" />
                            </div>
                            <div class="col-sm-3">
                                <label asp-for="Provincia" class="form-label-prosegin small text-uppercase" style="font-size: 0.75rem;">Provincia</label>
                                <input asp-for="Provincia" type="text" id="txtProvincia" class="form-control form-control-prosegin form-control-sm text-dark" placeholder="Ej: Lima" />
                            </div>
                            <div class="col-sm-3">
                                <label asp-for="Distrito" class="form-label-prosegin small text-uppercase" style="font-size: 0.75rem;">Distrito</label>
                                <input asp-for="Distrito" type="text" id="txtDistrito" class="form-control form-control-prosegin form-control-sm text-dark" placeholder="Ej: San Isidro" />
                            </div>
                            <div class="col-sm-3">
                                <label asp-for="Ubigeo" class="form-label-prosegin small text-uppercase" style="font-size: 0.75rem;">Ubigeo (6 dígitos)</label>
                                <input asp-for="Ubigeo" type="text" id="txtUbigeo" class="form-control form-control-prosegin form-control-sm font-monospace fw-bold text-dark" placeholder="Ej: 150101" maxlength="6" />
                            </div>
                        </div>

                        <!-- Referencia de Domicilio Fiscal -->
                        <div>
                            <label asp-for="Referencia" class="form-label-prosegin small text-uppercase fw-bold mb-1">Referencia</label>
                            <input asp-for="Referencia" type="text" id="txtReferencia" class="form-control form-control-prosegin form-control-sm" 
                                   placeholder="Ej: A media cuadra de Av. Colonial, portón plomo" autocomplete="off" />
                            <span asp-validation-for="Referencia" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN 3: PREFERENCIAS DE EMISIÓN Y CONTACTO -->
                <div class="prosegin-card mb-4">
                    <div class="prosegin-card-header--section">
                        <span class="section-step-number">3</span>
                        <span class="section-step-title">
                            <i class="bi bi-receipt me-1"></i> Contacto y Emisión
                        </span>
                    </div>

                    <div class="prosegin-card-body prosegin-card-body--form">
                        <!-- Tipo de comprobante predeterminado -->
                        <div class="mb-3">
                            <label class="form-label-prosegin small text-uppercase fw-bold mb-1">Comprobante Predeterminado</label>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="selection-card-radio h-100" for="compFactura">
                                        <input class="form-check-input mt-0" type="radio" name="tipoComprobante" id="compFactura" checked>
                                        <span class="fw-bold small text-dark">
                                            Factura Electrónica (Tipo 01)
                                        </span>
                                    </label>
                                </div>
                                <div class="col-md-6">
                                    <label class="selection-card-radio h-100" for="compBoleta" id="boxBoleta">
                                        <input class="form-check-input mt-0" type="radio" name="tipoComprobante" id="compBoleta">
                                        <span class="fw-bold small text-dark">
                                            Boleta de Venta (Tipo 03)
                                        </span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Canales de Contacto Fiscal -->
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CorreoElectronico" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                    Correo Electrónico
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="CorreoElectronico" id="txtCorreo" class="form-control form-control-prosegin border-start-0" 
                                           placeholder="Ej: facturacion@@distribuidoraperu.com" autocomplete="off" />
                                </div>
                                <span asp-validation-for="CorreoElectronico" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                                    Teléfono
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0 text-muted">
                                        <i class="bi bi-telephone"></i>
                                    </span>
                                    <input asp-for="Telefono" id="txtTelefono" class="form-control form-control-prosegin border-start-0" 
                                           placeholder="Ej: 987 654 321" autocomplete="off" />
                                </div>
                                <span asp-validation-for="Telefono" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- COLUMNA DERECHA: RESUMEN DEL CLIENTE -->
            <div class="col-lg-4">
                
                <div class="prosegin-card mb-4 sticky-top preview-card-sidebar" style="top: 85px;">
                    <div class="prosegin-card-header bg-white py-2 px-3 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">
                            <i class="bi bi-person-badge me-1"></i> Resumen del Cliente
                        </span>
                    </div>

                    <div class="prosegin-card-body p-3">
                        <div class="mb-3 text-center">
                            <span class="text-muted small text-uppercase fw-bold d-block mb-1" style="font-size: 0.68rem; letter-spacing: 0.06em;">Número de RUC</span>
                            <div class="preview-ruc" id="previewRuc">
                                -----------
                            </div>
                            <div class="preview-razon mt-1" id="previewRazonSocial">
                                Razón social del cliente
                            </div>
                        </div>

                        <hr class="divider-subtle" />

                        <!-- Ficha de Condición Dinámica -->
                        <div class="d-flex flex-column gap-2 py-2 small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-shield-check me-1"></i> Condición:</span>
                                <span class="badge bg-light text-muted border" id="previewCondicion">Pendiente</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-activity me-1"></i> Estado:</span>
                                <span class="badge bg-light text-muted border" id="previewEstado">Pendiente</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="bi bi-receipt me-1"></i> Comprobante:</span>
                                <span class="badge bg-light text-muted border" id="previewEmision">---</span>
                            </div>
                        </div>

                        <hr class="divider-subtle" />

                        <!-- Checklist de Validaciones SUNAT -->
                        <div class="validation-checklist pt-1">
                            <div class="validation-check-item" id="chkDigitos">
                                <i class="bi bi-circle text-muted" id="iconChkDigitos"></i>
                                <span id="lblChkDigitos">RUC de 11 dígitos</span>
                            </div>
                            <div class="validation-check-item" id="chkSunat">
                                <i class="bi bi-circle text-muted" id="iconChkSunat"></i>
                                <span id="lblChkSunat">Consulta en SUNAT</span>
                            </div>
                            <div class="validation-check-item" id="chkDireccion">
                                <i class="bi bi-circle text-muted" id="iconChkDireccion"></i>
                                <span id="lblChkDireccion">Dirección registrada</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- BARRA DE ACCIÓN INFERIOR: BOTONES DE GUARDADO -->
        <input type="hidden" name="accion" id="hiddenAccion" value="guardar" />

        <div class="form-action-bar mt-3 mb-4">
            <div class="form-status-pill" id="formStatusIndicator">
                <span class="status-dot" id="statusDot"></span>
                <span id="statusLabel">Formulario Pendiente</span>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <a asp-controller="Clientes" asp-action="Index" class="btn-prosegin-secondary py-2 px-3" title="Cancelar y descartar el registro">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </a>
                <button type="submit" id="btnGuardarCliente" class="btn-prosegin-secondary-orange py-2 px-3 fw-bold" disabled onclick="document.getElementById('hiddenAccion').value='guardar';" title="Guarda el cliente en el sistema">
                    <i class="bi bi-check2-circle me-1"></i> Guardar Cliente
                </button>
                <button type="submit" id="btnGuardarYDirecciones" class="btn-prosegin-primary py-2 px-4 fw-bold" disabled onclick="document.getElementById('hiddenAccion').value='direcciones';" title="Guarda el cliente y habilita automáticamente su dirección fiscal para ver y gestionar sus sedes">
                    <i class="bi bi-geo-alt-fill me-1"></i> Guardar y ver direcciones de entrega
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formDatosTributarios');
            const txtRuc = document.getElementById('txtRuc');
            const txtRazonSocial = document.getElementById('txtRazonSocial');
            const txtDireccion = document.getElementById('txtDireccionFiscal');
            const txtDepartamento = document.getElementById('txtDepartamento');
            const txtProvincia = document.getElementById('txtProvincia');
            const txtDistrito = document.getElementById('txtDistrito');
            const txtUbigeo = document.getElementById('txtUbigeo');
            const txtCorreo = document.getElementById('txtCorreo');
            const txtTelefono = document.getElementById('txtTelefono');

            const btnConsultar = document.getElementById('btnConsultarSunat');
            const iconConsultar = document.getElementById('iconConsultar');
            const textBtnConsultar = document.getElementById('textBtnConsultar');
            const btnGuardarCliente = document.getElementById('btnGuardarCliente');
            const btnGuardarYDirecciones = document.getElementById('btnGuardarYDirecciones');
            const hiddenAccion = document.getElementById('hiddenAccion');
            let accionSeleccionada = 'guardar';

            if (btnGuardarCliente) {
                btnGuardarCliente.addEventListener('click', function () {
                    accionSeleccionada = 'guardar';
                    if (hiddenAccion) hiddenAccion.value = 'guardar';
                });
            }

            if (btnGuardarYDirecciones) {
                btnGuardarYDirecciones.addEventListener('click', function () {
                    accionSeleccionada = 'direcciones';
                    if (hiddenAccion) hiddenAccion.value = 'direcciones';
                });
            }
            const hiddenEstadoSunat = document.getElementById('hiddenEstadoSunat');
            const hiddenCondicionSunat = document.getElementById('hiddenCondicionSunat');

            // Alerta de riesgo tributario
            const alertaRiesgo = document.getElementById('alertaRiesgoTributario');
            const alertaRiesgoTitulo = document.getElementById('alertaRiesgoTitulo');
            const alertaRiesgoMensaje = document.getElementById('alertaRiesgoMensaje');

            // Badges en formulario
            const badgeEstadoSunat = document.getElementById('badgeEstadoSunat');
            const badgeCondicionSunat = document.getElementById('badgeCondicionSunat');
            const iconEstadoSunat = document.getElementById('iconEstadoSunat');
            const textEstadoSunat = document.getElementById('textEstadoSunat');
            const iconCondicionSunat = document.getElementById('iconCondicionSunat');
            const textCondicionSunat = document.getElementById('textCondicionSunat');
            const rucStatusText = document.getElementById('rucStatusText');

            // Elementos de la tarjeta interactiva derecha
            const previewRuc = document.getElementById('previewRuc');
            const previewRazonSocial = document.getElementById('previewRazonSocial');
            const previewCondicion = document.getElementById('previewCondicion');
            const previewEstado = document.getElementById('previewEstado');
            const previewEmision = document.getElementById('previewEmision');

            const iconChkDigitos = document.getElementById('iconChkDigitos');
            const lblChkDigitos = document.getElementById('lblChkDigitos');
            const iconChkSunat = document.getElementById('iconChkSunat');
            const lblChkSunat = document.getElementById('lblChkSunat');
            const iconChkDireccion = document.getElementById('iconChkDireccion');
            const lblChkDireccion = document.getElementById('lblChkDireccion');

            const formStatusIndicator = document.getElementById('formStatusIndicator');
            const statusDot = document.getElementById('statusDot');
            const statusLabel = document.getElementById('statusLabel');

            let sunatConsultado = false;

            // Función reactiva centralizada para estado y condición SUNAT
            function actualizarEstadoTributarioVisual(estado, condicion, consultando = false) {
                if (consultando) {
                    badgeEstadoSunat.className = 'badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1';
                    iconEstadoSunat.className = 'spinner-border spinner-border-sm';
                    textEstadoSunat.textContent = 'Consultando...';

                    badgeCondicionSunat.className = 'badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1';
                    iconCondicionSunat.className = 'spinner-border spinner-border-sm';
                    textCondicionSunat.textContent = 'Consultando...';

                    previewEstado.textContent = 'Consultando...';
                    previewEstado.className = 'badge bg-primary-subtle text-primary border border-primary';
                    previewCondicion.textContent = 'Consultando...';
                    previewCondicion.className = 'badge bg-primary-subtle text-primary border border-primary';
                    return;
                }

                if (!estado || estado === 'Pendiente') {
                    badgeEstadoSunat.className = 'badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1';
                    iconEstadoSunat.className = 'bi bi-dash-circle';
                    textEstadoSunat.textContent = 'Pendiente';

                    badgeCondicionSunat.className = 'badge rounded-pill bg-secondary-subtle text-secondary border border-secondary-subtle fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1';
                    iconCondicionSunat.className = 'bi bi-dash-circle';
                    textCondicionSunat.textContent = 'Pendiente';

                    previewEstado.textContent = 'Pendiente';
                    previewEstado.className = 'badge bg-light text-muted border';
                    previewCondicion.textContent = 'Pendiente';
                    previewCondicion.className = 'badge bg-light text-muted border';
                    return;
                }

                const esActivo = estado.toUpperCase() === 'ACTIVO';
                const esHabido = condicion.toUpperCase() === 'HABIDO';

                // Estado en SUNAT
                if (esActivo) {
                    badgeEstadoSunat.className = 'badge rounded-pill bg-success-subtle text-success border border-success fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1';
                    iconEstadoSunat.className = 'bi bi-check-circle-fill';
                    textEstadoSunat.textContent = estado.toUpperCase();

                    previewEstado.textContent = estado.toUpperCase();
                    previewEstado.className = 'badge bg-success-subtle text-success border border-success';
                } else {
                    badgeEstadoSunat.className = 'badge rounded-pill bg-danger-subtle text-danger border border-danger fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1';
                    iconEstadoSunat.className = 'bi bi-exclamation-octagon-fill';
                    textEstadoSunat.textContent = estado.toUpperCase();

                    previewEstado.textContent = estado.toUpperCase();
                    previewEstado.className = 'badge bg-danger-subtle text-danger border border-danger';
                }

                // Condición en SUNAT
                if (esHabido) {
                    badgeCondicionSunat.className = 'badge rounded-pill bg-success-subtle text-success border border-success fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1';
                    iconCondicionSunat.className = 'bi bi-shield-check';
                    textCondicionSunat.textContent = condicion.toUpperCase();

                    previewCondicion.textContent = condicion.toUpperCase();
                    previewCondicion.className = 'badge bg-success-subtle text-success border border-success';
                } else {
                    badgeCondicionSunat.className = 'badge rounded-pill bg-danger-subtle text-danger border border-danger fw-semibold px-2 py-1 d-inline-flex align-items-center gap-1';
                    iconCondicionSunat.className = 'bi bi-shield-x';
                    textCondicionSunat.textContent = condicion.toUpperCase();

                    previewCondicion.textContent = condicion.toUpperCase();
                    previewCondicion.className = 'badge bg-danger-subtle text-danger border border-danger';
                }
            }

            // Algoritmo Oficial de Verificación de RUC - Módulo 11 SUNAT
            function validarModulo11Sunat(ruc) {
                if (!ruc || ruc.length !== 11 || !/^\d+$/.test(ruc)) return false;

                const prefijo = ruc.substring(0, 2);
                if (!['10', '15', '17', '20'].includes(prefijo)) return false;

                const factores = [5, 4, 3, 2, 7, 6, 5, 4, 3, 2];
                let suma = 0;

                for (let i = 0; i < 10; i++) {
                    suma += parseInt(ruc.charAt(i), 10) * factores[i];
                }

                const residuo = suma % 11;
                let digitoCalculado = 11 - residuo;

                if (digitoCalculado === 10) digitoCalculado = 0;
                else if (digitoCalculado === 11) digitoCalculado = 1;

                return digitoCalculado === parseInt(ruc.charAt(10), 10);
            }

            // 1. Filtrar RUC para aceptar exclusivamente números y permitir Enter para consultar
            txtRuc.addEventListener('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
                evaluarRucEnTiempoReal();
            });

            txtRuc.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    btnConsultar.click();
                }
            });

            // 2. Evaluar RUC en tiempo real con Módulo 11
            function evaluarRucEnTiempoReal() {
                const val = txtRuc.value.trim();

                if (val.length === 0) {
                    previewRuc.textContent = '-----------';
                    previewRuc.classList.remove('filled');
                    previewRazonSocial.textContent = 'Razón social del cliente';
                    previewRazonSocial.classList.remove('filled');
                    
                    txtRuc.classList.remove('is-valid', 'is-invalid');
                    rucStatusText.className = 'text-muted';
                    rucStatusText.innerHTML = 'Ingrese 11 dígitos numéricos';

                    setCheck(iconChkDigitos, lblChkDigitos, false, 'RUC de 11 dígitos');
                    setCheck(iconChkSunat, lblChkSunat, false, 'Consulta en SUNAT');
                    setCheck(iconChkDireccion, lblChkDireccion, false, 'Dirección registrada');
                    alertaRiesgo.classList.add('d-none');
                    sunatConsultado = false;
                    actualizarEstadoTributarioVisual('Pendiente', 'Pendiente');
                    actualizarEstadoFormulario();
                    return;
                }

                previewRuc.textContent = val;
                previewRuc.classList.add('filled');

                if (val.length < 11) {
                    txtRuc.classList.remove('is-valid');
                    txtRuc.classList.add('is-invalid');
                    rucStatusText.className = 'text-danger fw-bold';
                    rucStatusText.innerHTML = `Incompleto: ${val.length} de 11 dígitos`;
                    
                    setCheck(iconChkDigitos, lblChkDigitos, false, `Faltan ${11 - val.length} dígitos`);
                    setCheck(iconChkSunat, lblChkSunat, false, 'Consulta en SUNAT');
                    alertaRiesgo.classList.add('d-none');
                    sunatConsultado = false;
                    actualizarEstadoTributarioVisual('Pendiente', 'Pendiente');
                } else if (val.length === 11) {
                    // Validación matemática Módulo 11
                    const esValido = validarModulo11Sunat(val);

                    if (!esValido) {
                        txtRuc.classList.remove('is-valid');
                        txtRuc.classList.add('is-invalid');
                        rucStatusText.className = 'text-danger fw-bold';
                        rucStatusText.innerHTML = '<i class="bi bi-x-circle-fill"></i> Número de RUC inválido';
                        setCheck(iconChkDigitos, lblChkDigitos, false, 'Número de RUC inválido');
                        setCheck(iconChkSunat, lblChkSunat, false, 'Consulta en SUNAT');
                        sunatConsultado = false;
                        actualizarEstadoTributarioVisual('Pendiente', 'Pendiente');
                    } else {
                        txtRuc.classList.remove('is-invalid');
                        txtRuc.classList.add('is-valid');
                        rucStatusText.className = 'text-success fw-bold';
                        rucStatusText.innerHTML = '<i class="bi bi-check-circle-fill"></i> RUC válido (Módulo 11) - Listo para consultar';
                        setCheck(iconChkDigitos, lblChkDigitos, true, 'RUC válido (Módulo 11)');
                    }
                }

                actualizarEstadoFormulario();
            }

            function setCheck(iconEl, lblEl, isValid, text) {
                if (isValid) {
                    iconEl.className = 'bi bi-check-circle-fill text-success';
                    lblEl.className = 'text-success fw-bold';
                    lblEl.textContent = text;
                } else {
                    iconEl.className = 'bi bi-circle text-muted';
                    lblEl.className = 'text-muted';
                    lblEl.textContent = text;
                }
            }

            // 3. Consulta a SUNAT mediante Backend Endpoint
            async function consultarSunatApi(rucNumero) {
                if (!rucNumero || rucNumero.length !== 11) {
                    txtRuc.classList.add('is-invalid');
                    txtRuc.focus();
                    return;
                }

                if (!validarModulo11Sunat(rucNumero)) {
                    txtRuc.classList.add('is-invalid');
                    rucStatusText.className = 'text-danger fw-bold';
                    rucStatusText.innerHTML = '<i class="bi bi-x-circle-fill"></i> Número de RUC inválido';
                    txtRuc.focus();
                    return;
                }

                btnConsultar.disabled = true;
                iconConsultar.className = 'spinner-border spinner-border-sm';
                textBtnConsultar.textContent = 'Consultando...';
                rucStatusText.className = 'text-primary fw-bold';
                rucStatusText.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Consultando con SUNAT...';
                actualizarEstadoTributarioVisual(null, null, true);

                try {
                    const response = await fetch(`/Clientes/ConsultarSunat?ruc=${encodeURIComponent(rucNumero)}`);
                    const data = await response.json();

                    if (!data.success && data.yaRegistrado) {
                        // HU 1.1: Interrumpir la operación y mostrar advertencia emergente
                        alertaRiesgo.classList.add('d-none');
                        txtRuc.classList.add('is-invalid');
                        txtRuc.classList.remove('is-valid');
                        rucStatusText.className = 'text-danger fw-bold';
                        rucStatusText.innerHTML = '<i class="bi bi-exclamation-triangle-fill"></i> RUC ya registrado en el padrón de clientes';
                        setCheck(iconChkSunat, lblChkSunat, false, 'Ya registrado en padrón');
                        actualizarEstadoTributarioVisual('Pendiente', 'Pendiente');
                        sunatConsultado = false;

                        ProseginAlert.warning(
                            data.message || "El RUC ingresado ya se encuentra registrado en el padrón de clientes.",
                            "Advertencia"
                        );
                        return;
                    }

                    if (data.success) {
                        txtRazonSocial.value = data.razonSocial || '';
                        txtDireccion.value = data.direccionFiscal || '';
                        txtDepartamento.value = data.departamento || 'Lima';
                        txtProvincia.value = data.provincia || 'Lima';
                        txtDistrito.value = data.distrito || '';
                        txtUbigeo.value = data.ubigeo || '150101';

                        // Actualizar campos ocultos para persistencia
                        hiddenEstadoSunat.value = data.estado || 'ACTIVO';
                        hiddenCondicionSunat.value = data.condicion || 'HABIDO';

                        txtRazonSocial.classList.remove('is-invalid');
                        txtDireccion.classList.remove('is-invalid');

                        // Evaluar Alerta de Riesgo Tributario (No Habido / Baja)
                        const esHabido = data.esHabido !== false && data.condicion === 'HABIDO';
                        const esActivo = data.esActivo !== false && data.estado === 'ACTIVO';

                        if (!esHabido || !esActivo) {
                            alertaRiesgoTitulo.textContent = 'Atención: Restricción Tributaria SUNAT';
                            alertaRiesgoMensaje.innerHTML = `El contribuyente figura como <strong>[CONDICIÓN: ${data.condicion}]</strong> y <strong>[ESTADO: ${data.estado}]</strong>. Según normativa de SUNAT, las compras o facturas emitidas a clientes no habidos o en baja no otorgan derecho a crédito fiscal del IGV.`;
                            alertaRiesgo.classList.remove('d-none');
                        } else {
                            alertaRiesgo.classList.add('d-none');
                        }

                        actualizarEstadoTributarioVisual(data.estado || 'ACTIVO', data.condicion || 'HABIDO');

                        previewRazonSocial.textContent = data.razonSocial;
                        previewRazonSocial.classList.add('filled');

                        previewEmision.textContent = data.tipoEmision || 'FACTURA ELECTRÓNICA';
                        previewEmision.className = 'badge bg-primary-subtle text-primary border border-primary';

                        setCheck(iconChkDigitos, lblChkDigitos, true, 'RUC válido (Módulo 11)');
                        setCheck(iconChkSunat, lblChkSunat, true, `SUNAT: ${data.condicion} y ${data.estado}`);
                        setCheck(iconChkDireccion, lblChkDireccion, true, 'Dirección y Ubigeo sincronizados');

                        rucStatusText.className = 'text-success fw-bold';
                        rucStatusText.innerHTML = `<i class="bi bi-check-circle-fill"></i> RUC validado en SUNAT (${data.condicion})`;
                        sunatConsultado = true;
                    } else {
                        alertaRiesgo.classList.add('d-none');
                        rucStatusText.className = 'text-danger fw-bold';
                        rucStatusText.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> ${data.message || 'No se encontró el RUC en SUNAT.'}`;
                        setCheck(iconChkSunat, lblChkSunat, false, 'No encontrado en SUNAT');
                        actualizarEstadoTributarioVisual('Pendiente', 'Pendiente');
                        sunatConsultado = false;
                    }
                } catch (error) {
                    alertaRiesgo.classList.add('d-none');
                    rucStatusText.className = 'text-danger fw-bold';
                    rucStatusText.innerHTML = '<i class="bi bi-x-circle-fill"></i> Error al conectar con el servicio de SUNAT.';
                    actualizarEstadoTributarioVisual('Pendiente', 'Pendiente');
                } finally {
                    btnConsultar.disabled = false;
                    iconConsultar.className = 'bi bi-search';
                    textBtnConsultar.textContent = 'Consultar SUNAT';
                    actualizarEstadoFormulario();
                }
            }

            // Click manual en "Consultar SUNAT"
            btnConsultar.addEventListener('click', function () {
                const rucVal = txtRuc.value.trim();
                if (!rucVal || rucVal.length !== 11) {
                    txtRuc.classList.add('is-invalid');
                    txtRuc.classList.remove('is-valid');
                    rucStatusText.className = 'text-danger fw-bold';
                    rucStatusText.innerHTML = '<i class="bi bi-x-circle-fill"></i> Número de RUC inválido';
                    txtRuc.focus();
                    return;
                }

                if (!validarModulo11Sunat(rucVal)) {
                    txtRuc.classList.add('is-invalid');
                    txtRuc.classList.remove('is-valid');
                    rucStatusText.className = 'text-danger fw-bold';
                    rucStatusText.innerHTML = '<i class="bi bi-x-circle-fill"></i> Número de RUC inválido';
                    txtRuc.focus();
                    return;
                }

                consultarSunatApi(rucVal);
            });

            // Sincronizar Razón Social manual y eventos reactivos
            function onRazonSocialChanged() {
                const val = txtRazonSocial.value.trim();
                if (val.length > 0) {
                    previewRazonSocial.textContent = val.toUpperCase();
                    previewRazonSocial.classList.add('filled');
                    txtRazonSocial.classList.remove('is-invalid');
                } else {
                    previewRazonSocial.textContent = 'Razón social del cliente';
                    previewRazonSocial.classList.remove('filled');
                }
                actualizarEstadoFormulario();
            }

            ['input', 'change', 'keyup'].forEach(evt => {
                txtRazonSocial.addEventListener(evt, onRazonSocialChanged);
            });

            // Sincronizar Dirección Fiscal y eventos reactivos
            function onDireccionChanged() {
                if (txtDireccion.value.trim().length > 0) {
                    txtDireccion.classList.remove('is-invalid');
                    setCheck(iconChkDireccion, lblChkDireccion, true, 'Dirección registrada');
                } else {
                    setCheck(iconChkDireccion, lblChkDireccion, false, 'Dirección registrada');
                }
                actualizarEstadoFormulario();
            }

            ['input', 'change', 'keyup'].forEach(evt => {
                txtDireccion.addEventListener(evt, onDireccionChanged);
            });

            function actualizarEstadoFormulario() {
                const rucVal = txtRuc.value.trim();
                const rucValido = rucVal.length === 11 && validarModulo11Sunat(rucVal);
                const razonValida = txtRazonSocial.value.trim().length > 0;
                const dirValida = txtDireccion.value.trim().length > 0;

                const esFormularioValido = rucValido && razonValida && dirValida;

                if (esFormularioValido) {
                    statusDot.className = 'status-dot';
                    formStatusIndicator.classList.add('ready');
                    statusLabel.textContent = 'Formulario Listo para Guardar';

                    if (btnGuardarCliente) btnGuardarCliente.disabled = false;
                    if (btnGuardarYDirecciones) btnGuardarYDirecciones.disabled = false;
                } else {
                    statusDot.className = 'status-dot';
                    formStatusIndicator.classList.remove('ready');
                    statusLabel.textContent = 'Formulario Pendiente — Complete los campos obligatorios (*)';

                    if (btnGuardarCliente) btnGuardarCliente.disabled = true;
                    if (btnGuardarYDirecciones) btnGuardarYDirecciones.disabled = true;
                }
            }

            // Envío del Formulario con Validación
            form.addEventListener('submit', function (e) {
                let esValido = true;

                const ruc = txtRuc.value.trim();
                if (ruc.length !== 11) {
                    txtRuc.classList.add('is-invalid');
                    txtRuc.focus();
                    rucStatusText.className = 'text-danger fw-bold';
                    rucStatusText.innerHTML = '<i class="bi bi-x-circle-fill"></i> Número de RUC inválido';
                    esValido = false;
                } else if (!validarModulo11Sunat(ruc)) {
                    txtRuc.classList.add('is-invalid');
                    txtRuc.focus();
                    rucStatusText.className = 'text-danger fw-bold';
                    rucStatusText.innerHTML = '<i class="bi bi-x-circle-fill"></i> Número de RUC inválido';
                    esValido = false;
                }

                const razon = txtRazonSocial.value.trim();
                if (!razon) {
                    txtRazonSocial.classList.add('is-invalid');
                    if (esValido) txtRazonSocial.focus();
                    esValido = false;
                }

                const direccion = txtDireccion.value.trim();
                if (!direccion) {
                    txtDireccion.classList.add('is-invalid');
                    if (esValido) txtDireccion.focus();
                    esValido = false;
                }

                if (!esValido) {
                    e.preventDefault();
                    e.stopPropagation();
                    return false;
                }

                // Feedback visual de guardado y prevención de doble submit
                if (accionSeleccionada === 'direcciones') {
                    if (btnGuardarYDirecciones) {
                        btnGuardarYDirecciones.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Guardando y continuando...';
                        btnGuardarYDirecciones.style.pointerEvents = 'none';
                    }
                    if (btnGuardarCliente) btnGuardarCliente.style.pointerEvents = 'none';
                } else {
                    if (btnGuardarCliente) {
                        btnGuardarCliente.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Guardando cliente...';
                        btnGuardarCliente.style.pointerEvents = 'none';
                    }
                    if (btnGuardarYDirecciones) btnGuardarYDirecciones.style.pointerEvents = 'none';
                }
            });

            // Inicialización de estado tributario si ya viene precargado
            const rucInicial = txtRuc.value.trim();
            if (rucInicial.length === 11 && validarModulo11Sunat(rucInicial)) {
                if (txtRazonSocial.value.trim().length > 0) {
                    actualizarEstadoTributarioVisual(hiddenEstadoSunat.value || 'ACTIVO', hiddenCondicionSunat.value || 'HABIDO');
                    setCheck(iconChkDigitos, lblChkDigitos, true, 'RUC válido (Módulo 11)');
                    setCheck(iconChkSunat, lblChkSunat, true, `SUNAT: ${hiddenCondicionSunat.value} y ${hiddenEstadoSunat.value}`);
                    if (txtDireccion.value.trim().length > 0) {
                        setCheck(iconChkDireccion, lblChkDireccion, true, 'Dirección registrada');
                    }
                    sunatConsultado = true;
                } else {
                    evaluarRucEnTiempoReal();
                }
            } else {
                actualizarEstadoTributarioVisual('Pendiente', 'Pendiente');
            }
            actualizarEstadoFormulario();
        });
    </script>
}
