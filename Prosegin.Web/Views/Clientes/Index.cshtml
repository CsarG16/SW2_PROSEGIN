@model Prosegin.Web.ViewModels.Clientes.ClienteBusquedaViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Búsqueda de Clientes";
    var resultados = Model.Resultados;
    var consultaSunat = Model.ConsultaSunat;
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-people text-warning me-2"></i> BÚSQUEDA DE CLIENTES
            </h4>
            <p class="text-muted small mb-0">Consulte empresas por RUC o razón social y revise su estado fiscal y crediticio.</p>
        </div>
        <a asp-action="Create" class="btn-prosegin-primary">
            <i class="bi bi-person-plus me-1"></i> REGISTRAR CLIENTE
        </a>
    </div>

    <div class="prosegin-card mb-4">
        <div class="prosegin-card-body p-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label for="termino" class="form-label-prosegin">RUC o razón social</label>
                    <input id="termino" name="termino" value="@Model.Termino" class="form-control form-control-prosegin" placeholder="RUC de 11 dígitos o mínimo 3 letras" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn-prosegin-primary w-100">
                        <i class="bi bi-search me-1"></i> BUSCAR
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert @(consultaSunat?.Success == false ? "alert-warning" : "alert-info") border rounded-3 mb-4">
            <i class="bi bi-info-circle-fill me-2"></i>@Model.Mensaje
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeActualizacionSunat))
    {
        <div class="alert alert-danger border-danger rounded-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.MensajeActualizacionSunat
        </div>
    }

    @if (consultaSunat?.Success == true)
    {
        <div class="prosegin-card mb-4 border-primary">
            <div class="prosegin-card-header d-flex justify-content-between align-items-center">
                <h5 class="prosegin-card-title mb-0"><i class="bi bi-cloud-check text-primary me-2"></i>CLIENTE ENCONTRADO EN SUNAT</h5>
                <span class="badge bg-primary">No registrado localmente</span>
            </div>
            <div class="prosegin-card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3"><span class="text-muted small d-block">RUC</span><strong class="font-monospace">@consultaSunat.Ruc</strong></div>
                    <div class="col-md-5"><span class="text-muted small d-block">Razón social</span><strong>@consultaSunat.RazonSocial</strong></div>
                    <div class="col-md-2"><span class="text-muted small d-block">Estado</span><span class="badge @(consultaSunat.EsActivo ? "bg-success" : "bg-danger")">@consultaSunat.Estado</span></div>
                    <div class="col-md-2"><span class="text-muted small d-block">Condición</span><span class="badge @(consultaSunat.EsHabido ? "bg-success" : "bg-danger")">@consultaSunat.Condicion</span></div>
                </div>
                <div class="mt-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <span class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@consultaSunat.DireccionFiscal</span>
                    <a asp-action="Create" asp-route-ruc="@consultaSunat.Ruc" asp-route-razonSocial="@consultaSunat.RazonSocial" asp-route-direccionFiscal="@consultaSunat.DireccionFiscal" asp-route-estadoSunat="@consultaSunat.Estado" asp-route-condicionSunat="@consultaSunat.Condicion" asp-route-representanteLegal="@consultaSunat.RepresentanteLegal" class="btn btn-outline-primary">
                        <i class="bi bi-person-plus me-1"></i> REGISTRAR NUEVO CLIENTE
                    </a>
                </div>
            </div>
        </div>
    }

    @if (resultados.Any())
    {
        <div class="prosegin-card">
            <div class="prosegin-card-header">
                <h5 class="prosegin-card-title mb-0"><i class="bi bi-list-ul text-warning me-2"></i>COINCIDENCIAS EN PROSEGIN (@resultados.Count)</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>RUC</th>
                            <th>Razón social</th>
                            <th>Estado SUNAT</th>
                            <th>Condición</th>
                            <th>Crédito</th>
                            <th>Estado crediticio</th>
                            <th class="text-center">Cotización</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in resultados)
                        {
                            <tr class="@(cliente.ClienteBloqueado ? "table-danger" : "")">
                                <td class="font-monospace fw-bold">@cliente.Ruc</td>
                                <td>
                                    <div class="fw-semibold">@cliente.RazonSocial</div>
                                    <div class="small text-muted">@cliente.DireccionFiscal</div>
                                </td>
                                <td><span class="badge @(cliente.EstadoSunat.Equals("ACTIVO", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-danger")">@cliente.EstadoSunat</span></td>
                                <td><span class="badge @(cliente.CondicionSunat.Equals("HABIDO", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-danger")">@cliente.CondicionSunat</span></td>
                                <td>
                                    <div class="small">Límite: @cliente.LimiteCredito.ToString("C", new CultureInfo("es-PE"))</div>
                                    @if (cliente.SaldoVencido > 0)
                                    {
                                        <div class="small text-danger">Vencido: @cliente.SaldoVencido.ToString("C", new CultureInfo("es-PE"))</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-controller="Cotizaciones" asp-action="Create" asp-route-clienteId="@cliente.Id" class="btn btn-sm btn-outline-primary" title="Seleccionar cliente para cotización">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </a>
                                </td>
                                <td>
                                    @if (cliente.ClienteBloqueado)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>CLIENTE BLOQUEADO</span>
                                        <div class="small text-danger mt-1">@cliente.MensajeBloqueo</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>HABILITADO</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
