@model Prosegin.Web.ViewModels.Clientes.ClienteBusquedaViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Directorio y Búsqueda de Clientes";
    var resultados = Model.Resultados;
    var consultaSunat = Model.ConsultaSunat;
    var esBusqueda = !string.IsNullOrWhiteSpace(Model.Termino);
}

<div class="container-fluid px-0">
    <!-- Encabezado de la Sección -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-dark mb-1" style="letter-spacing: -0.01em;">
                <i class="bi bi-people-fill text-warning me-2"></i> DIRECTORIO Y BÚSQUEDA DE CLIENTES
            </h4>
            <p class="text-muted small mb-0">
                Consulte empresas registradas, valide su condición en SUNAT y controle el riesgo crediticio antes de cotizar.
            </p>
        </div>
        <a asp-action="Create" class="btn-prosegin-primary">
            <i class="bi bi-person-plus me-1"></i> REGISTRAR NUEVO CLIENTE
        </a>
    </div>

    <!-- Buscador Reactivo -->
    <div class="prosegin-card mb-4">
        <div class="prosegin-card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-2 g-md-3 align-items-end">
                <div class="col-md-9 col-lg-9">
                    <label for="termino" class="form-label-prosegin small text-uppercase fw-bold mb-1">
                        Búsqueda por RUC o Razón Social
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input id="termino" name="termino" value="@Model.Termino" class="form-control form-control-prosegin border-start-0" 
                               placeholder="Ingrese RUC de 11 dígitos o al menos 3 letras de la razón social" autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-3 col-lg-3 d-flex gap-2">
                    <button type="submit" class="btn-prosegin-primary w-100 fw-bold">
                        <i class="bi bi-search me-1"></i> BUSCAR
                    </button>
                    @if (esBusqueda)
                    {
                        <a asp-action="Index" class="btn-prosegin-secondary px-3" title="Limpiar filtro y ver todos">
                            <i class="bi bi-x-circle"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Mensajes y Alertas -->
    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert @(consultaSunat?.Success == false ? "alert-warning" : "alert-info") border rounded-3 mb-4 d-flex align-items-center">
            <i class="bi bi-info-circle-fill fs-5 me-2"></i>
            <div>@Model.Mensaje</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeActualizacionSunat))
    {
        <div class="alert alert-danger border-danger rounded-3 mb-4 d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@Model.MensajeActualizacionSunat</div>
        </div>
    }

    <!-- Tarjeta de Cliente Hallado en SUNAT (No Registrado Localmente) -->
    @if (consultaSunat?.Success == true)
    {
        <div class="prosegin-card mb-4 border-primary shadow-sm">
            <div class="prosegin-card-header d-flex justify-content-between align-items-center bg-primary-subtle py-2 px-3">
                <span class="fw-bold text-primary small text-uppercase">
                    <i class="bi bi-cloud-check-fill me-1"></i> CLIENTE ENCONTRADO EN SUNAT (SIN REGISTRAR EN PROSEGIN)
                </span>
                <span class="badge bg-primary text-white">Disponible para Alta</span>
            </div>
            <div class="prosegin-card-body p-3 p-md-4">
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <span class="text-muted small d-block">RUC</span>
                        <strong class="font-monospace fs-6 text-dark">@consultaSunat.Ruc</strong>
                    </div>
                    <div class="col-sm-6 col-md-5">
                        <span class="text-muted small d-block">Razón Social</span>
                        <strong class="text-dark">@consultaSunat.RazonSocial</strong>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <span class="text-muted small d-block">Estado</span>
                        <span class="badge @(consultaSunat.EsActivo ? "bg-success" : "bg-danger")">@consultaSunat.Estado</span>
                    </div>
                    <div class="col-sm-6 col-md-2">
                        <span class="text-muted small d-block">Condición</span>
                        <span class="badge @(consultaSunat.EsHabido ? "bg-success" : "bg-danger")">@consultaSunat.Condicion</span>
                    </div>
                </div>
                <div class="mt-3 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <span class="small text-muted">
                        <i class="bi bi-geo-alt me-1 text-danger"></i> @consultaSunat.DireccionFiscal
                    </span>
                    <a asp-action="Create" asp-route-ruc="@consultaSunat.Ruc" asp-route-razonSocial="@consultaSunat.RazonSocial" asp-route-direccionFiscal="@consultaSunat.DireccionFiscal" asp-route-estadoSunat="@consultaSunat.Estado" asp-route-condicionSunat="@consultaSunat.Condicion" asp-route-representanteLegal="@consultaSunat.RepresentanteLegal" class="btn-prosegin-primary py-2 px-3 fw-bold">
                        <i class="bi bi-person-plus me-1"></i> REGISTRAR CLIENTE CON DATOS SUNAT
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Tabla de Clientes (Directorio o Coincidencias) -->
    @if (resultados.Any())
    {
        <div class="prosegin-card mb-5">
            <div class="prosegin-card-header py-2 px-3 d-flex justify-content-between align-items-center bg-white border-bottom">
                <span class="fw-bold text-dark small text-uppercase">
                    @if (esBusqueda)
                    {
                        <i class="bi bi-search text-warning me-2"></i> <span>Coincidencias en Prosegin (@resultados.Count)</span>
                    }
                    else
                    {
                        <i class="bi bi-people-fill text-warning me-2"></i> <span>Clientes Registrados en Base de Datos (@resultados.Count)</span>
                    }
                </span>
                <span class="badge bg-light text-secondary border">Directorio Oficial</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-prosegin align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 140px;">RUC</th>
                            <th>Razón Social / Representante</th>
                            <th>Dirección Fiscal / Ubigeo</th>
                            <th style="width: 130px;">Condición / Estado</th>
                            <th style="width: 140px;">Línea de Crédito</th>
                            <th style="width: 140px;">Riesgo Crediticio</th>
                            <th class="text-center" style="width: 110px;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in resultados)
                        {
                            <tr class="@(cliente.ClienteBloqueado ? "table-danger-subtle" : "")">
                                <td>
                                    <span class="font-monospace fw-bold text-dark d-block">@cliente.Ruc</span>
                                    <span class="text-muted" style="font-size: 0.72rem;">Reg: @cliente.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@cliente.RazonSocial</div>
                                    @if (!string.IsNullOrWhiteSpace(cliente.RepresentanteLegal))
                                    {
                                        <div class="text-muted small" style="font-size: 0.75rem;">
                                            <i class="bi bi-person me-1"></i>Rep: @cliente.RepresentanteLegal
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="small text-muted text-truncate" style="max-width: 280px;" title="@cliente.DireccionFiscal">
                                        <i class="bi bi-geo-alt me-1 text-secondary"></i>@cliente.DireccionFiscal
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(cliente.Ubigeo) || !string.IsNullOrWhiteSpace(cliente.Distrito))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace mt-1" style="font-size: 0.7rem;">
                                            @(cliente.Ubigeo ?? "-") @(!string.IsNullOrWhiteSpace(cliente.Distrito) ? $"• {cliente.Distrito}" : "")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="badge @(cliente.CondicionSunat.Equals("HABIDO", StringComparison.OrdinalIgnoreCase) ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")" style="font-size: 0.68rem;">
                                            @cliente.CondicionSunat
                                        </span>
                                        <span class="badge @(cliente.EstadoSunat.Equals("ACTIVO", StringComparison.OrdinalIgnoreCase) ? "bg-primary-subtle text-primary border border-primary" : "bg-warning-subtle text-dark border border-warning")" style="font-size: 0.68rem;">
                                            @cliente.EstadoSunat
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">
                                        @cliente.LimiteCredito.ToString("C", new CultureInfo("es-PE"))
                                    </div>
                                    @if (cliente.SaldoVencido > 0)
                                    {
                                        <div class="small text-danger fw-bold" style="font-size: 0.72rem;">
                                            Vencido: @cliente.SaldoVencido.ToString("C", new CultureInfo("es-PE"))
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (cliente.ClienteBloqueado)
                                    {
                                        <span class="badge bg-danger text-white mb-1" style="font-size: 0.7rem;">
                                            <i class="bi bi-lock-fill me-1"></i>BLOQUEADO
                                        </span>
                                        <div class="text-danger small" style="font-size: 0.7rem; line-height: 1.1;">
                                            @cliente.MensajeBloqueo
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success" style="font-size: 0.7rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>HABILITADO
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (cliente.ClienteBloqueado)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" disabled title="@cliente.MensajeBloqueo">
                                            <i class="bi bi-slash-circle me-1"></i>Cotizar
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-controller="Cotizaciones" asp-action="Create" asp-route-clienteId="@cliente.Id" class="btn btn-sm btn-outline-primary fw-semibold" title="Generar cotización para este cliente">
                                            <i class="bi bi-file-earmark-plus me-1"></i>Cotizar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (!consultaSunat?.Success == true)
    {
        <div class="prosegin-card p-5 text-center my-4">
            <i class="bi bi-person-x text-muted display-4 mb-3 d-block"></i>
            <h5 class="fw-bold text-dark">No se encontraron clientes</h5>
            <p class="text-muted small mb-4">
                @(esBusqueda ? "No hay registros que coincidan con el término ingresado." : "Aún no hay clientes registrados en la base de datos de Prosegin.")
            </p>
            <a asp-action="Create" class="btn-prosegin-primary d-inline-flex align-items-center">
                <i class="bi bi-person-plus me-2"></i> Registrar Nuevo Cliente
            </a>
        </div>
    }
</div>

