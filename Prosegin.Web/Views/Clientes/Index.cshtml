@model Prosegin.Web.ViewModels.Clientes.ClienteBusquedaViewModel
@using System.Globalization
@using Prosegin.Data.Validation

@{
    ViewData["Title"] = "Directorio de Clientes";
    var resultados = Model.Resultados;
    var consultaSunat = Model.ConsultaSunat;
    var esBusqueda = !string.IsNullOrWhiteSpace(Model.Termino);
}

<div class="container-fluid px-0">

    <!-- 1. ENCABEZADO: Directorio de Clientes + Botón Registrar -->
    <div class="prosegin-card mb-3 p-3 p-md-4">
        <div class="prosegin-page-header--accent" style="margin-bottom: 0;">
            <div class="header-content">
                <h1 class="page-title">Directorio de Clientes</h1>
                <p class="page-subtitle">Gestión comercial y verificación SUNAT de empresas clientes</p>
            </div>
            <a asp-action="Create" class="btn-prosegin-primary">
                + REGISTRAR NUEVO CLIENTE
            </a>
        </div>
    </div>

    <!-- 2. BÚSQUEDA POR RUC O RAZÓN SOCIAL -->
    <div class="prosegin-card mb-4 p-3 p-md-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="prosegin-section-label mb-0">BÚSQUEDA POR RUC O RAZÓN SOCIAL</span>
            <span class="page-subtitle mb-0">
                <i class="bi bi-info-circle me-1"></i> Búsqueda por RUC de 11 dígitos o razón social
            </span>
        </div>

        <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center gap-2">
            <div class="flex-grow-1" style="min-width: 250px;">
                <div class="prosegin-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="termino" name="termino" value="@Model.Termino"
                           placeholder="Ingrese RUC o razón social..." autocomplete="off" />
                </div>
            </div>

            <button type="submit" class="btn-prosegin-primary" style="height: 46px;">
                <i class="bi bi-search"></i> BUSCAR
            </button>

            @if (esBusqueda && !resultados.Any())
            {
                <span class="badge-status badge-status-neutral">Sin resultados</span>
                <a asp-action="Index" class="btn-prosegin-secondary px-3" style="height: 46px; line-height: 30px;" title="Ver todos">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
            else if (esBusqueda)
            {
                <a asp-action="Index" class="btn-prosegin-secondary px-3" style="height: 46px; line-height: 30px;" title="Limpiar filtro">
                    Limpiar
                </a>
            }
        </form>
    </div>

    <!-- 3. MENSAJES Y ALERTAS -->
    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="prosegin-alert prosegin-alert-warning">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span class="fw-medium">@Model.Mensaje</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeActualizacionSunat))
    {
        <div class="prosegin-alert prosegin-alert-danger">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <span>@Model.MensajeActualizacionSunat</span>
        </div>
    }

    <!-- 4. EMPRESA ENCONTRADA EN SUNAT (No registrada localmente) -->
    @if (consultaSunat?.Success == true && !resultados.Any())
    {
        <div class="prosegin-card mb-4 p-4">
            <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                <span class="fw-bold text-dark small text-uppercase">
                    <i class="bi bi-cloud-check text-primary me-2"></i> Empresa Encontrada en Padrón SUNAT (Sin registrar localmente)
                </span>
                <span class="badge-status badge-status-success">
                    <span class="status-dot"></span> Disponible para Alta
                </span>
            </div>
            <div class="row g-3">
                <div class="col-sm-6 col-md-3">
                    <span class="prosegin-section-label d-block">RUC</span>
                    <strong class="font-monospace fs-6 text-dark">@consultaSunat.Ruc</strong>
                </div>
                <div class="col-sm-6 col-md-5">
                    <span class="prosegin-section-label d-block">Razón Social</span>
                    <strong class="text-dark">@consultaSunat.RazonSocial</strong>
                </div>
                <div class="col-sm-6 col-md-2">
                    <span class="prosegin-section-label d-block">Estado</span>
                    <span class="badge-status @(consultaSunat.EsActivo ? "badge-status-success" : "badge-status-danger")">
                        <span class="status-dot"></span> @consultaSunat.Estado
                    </span>
                </div>
                <div class="col-sm-6 col-md-2">
                    <span class="prosegin-section-label d-block">Condición</span>
                    <span class="badge-status @(consultaSunat.EsHabido ? "badge-status-success" : "badge-status-danger")">
                        <span class="status-dot"></span> @consultaSunat.Condicion
                    </span>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-3">
                <span class="small text-muted">
                    <i class="bi bi-geo-alt me-1 text-danger"></i> @consultaSunat.DireccionFiscal
                </span>
                <a asp-action="Create" asp-route-ruc="@consultaSunat.Ruc" asp-route-razonSocial="@consultaSunat.RazonSocial" asp-route-direccionFiscal="@consultaSunat.DireccionFiscal" asp-route-estadoSunat="@consultaSunat.Estado" asp-route-condicionSunat="@consultaSunat.Condicion"
                   class="btn-prosegin-primary">
                    <i class="bi bi-person-plus"></i> REGISTRAR CLIENTE CON DATOS SUNAT
                </a>
            </div>
        </div>
    }

    <!-- 5. TABLA DE CLIENTES ENCONTRADOS -->
    @if (resultados.Any())
    {
        <div class="prosegin-card mb-5 overflow-hidden">
            <!-- Encabezado de Resultados -->
            <div class="prosegin-results-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="results-title">Clientes Encontrados</span>
                    <span class="count-pill">@resultados.Count registros</span>
                </div>
                <span class="results-note">Datos validados con Padrón SUNAT</span>
            </div>

            <!-- Tabla -->
            <div class="table-responsive">
                <table class="prosegin-table mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">EMPRESA / RAZÓN SOCIAL</th>
                            <th style="width: 140px;">RUC</th>
                            <th>DIRECCIÓN FISCAL</th>
                            <th class="text-center" style="width: 180px;">ESTADO SUNAT</th>
                            <th class="text-end pe-4" style="width: 220px;">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in resultados)
                        {
                            <tr>
                                <!-- Empresa / Razón Social -->
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="row-icon-avatar">
                                            <i class="bi bi-building"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark" style="font-size: 0.85rem;">
                                                @cliente.RazonSocial
                                            </div>
                                            <div class="text-muted" style="font-size: 0.78rem;">
                                                @(cliente.TipoCliente ?? "Cliente Corporativo")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <!-- RUC -->
                                <td>
                                    <span style="font-size: 0.85rem; font-weight: 500;">@cliente.Ruc</span>
                                </td>

                                <!-- Dirección Fiscal -->
                                <td>
                                    <div class="d-flex align-items-center gap-2" style="max-width: 320px;">
                                        <i class="bi bi-geo-alt" style="color: var(--text-subtle); flex-shrink: 0;"></i>
                                        <span class="text-truncate" style="font-size: 0.84rem;" title="@cliente.DireccionFiscal">
                                            @cliente.DireccionFiscal
                                        </span>
                                    </div>
                                </td>

                                <!-- Estado SUNAT -->
                                <td class="text-center">
                                    @{
                                        var esActivo = cliente.EstadoSunat.Equals("ACTIVO", StringComparison.OrdinalIgnoreCase);
                                        var esHabido = cliente.CondicionSunat.Equals("HABIDO", StringComparison.OrdinalIgnoreCase);
                                        var statusClass = (esActivo && esHabido) ? "badge-status-success" : "badge-status-danger";
                                    }
                                    <span class="badge-status @statusClass">
                                        <span class="status-dot"></span>
                                        @cliente.EstadoSunat · @cliente.CondicionSunat
                                    </span>
                                </td>

                                <!-- Acciones -->
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <!-- Botón Sedes -->
                                        <a asp-controller="Clientes" asp-action="Direcciones" asp-route-clienteId="@cliente.Id"
                                           class="btn-prosegin-action-secondary"
                                           title="Direcciones de Entrega">
                                            <i class="bi bi-building"></i> Sedes (@cliente.CantidadSedes)
                                        </a>

                                        <!-- Botón Cotizar -->
                                        @if (ClienteBusquedaRules.PuedeAbrirCotizacion(cliente.EstadoSunat, cliente.CondicionSunat) && !cliente.ClienteBloqueado)
                                        {
                                            <a asp-controller="Cotizaciones" asp-action="Create" asp-route-clienteId="@cliente.Id"
                                               class="btn-prosegin-action"
                                               title="Generar Cotización">
                                                <i class="bi bi-file-earmark-text"></i> Cotizar
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn-prosegin-action" disabled
                                                    title="@(cliente.ClienteBloqueado ? cliente.MensajeBloqueo : "Cliente no figura ACTIVO y HABIDO")">
                                                <i class="bi bi-file-earmark-text"></i> Cotizar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pie de Tabla -->
            <div class="prosegin-table-footer">
                <span>Mostrando @resultados.Count de @resultados.Count empresas coincidentes</span>
                <div class="d-flex align-items-center gap-3">
                    <span style="color: var(--text-subtle); cursor: default;">Anterior</span>
                    <span class="d-inline-flex align-items-center justify-content-center rounded-2 border bg-white fw-bold"
                          style="width: 28px; height: 28px; font-size: 0.8rem;">1</span>
                    <span style="color: var(--text-subtle); cursor: default;">Siguiente</span>
                </div>
            </div>
        </div>
    }
    else if (!consultaSunat?.Success == true)
    {
        <!-- Estado Vacío -->
        <div class="prosegin-card">
            <div class="prosegin-empty-state">
                <i class="bi bi-building-x empty-icon d-block"></i>
                <div class="empty-title">No se encontraron clientes registrados con los datos ingresados</div>
                <div class="empty-desc">
                    @(esBusqueda ? "Verifique el número de RUC o el nombre ingresado, o añada una nueva empresa al directorio." : "Aún no hay clientes registrados en el directorio de Prosegin.")
                </div>
                <a asp-action="Create" class="btn-prosegin-primary">
                    <i class="bi bi-person-plus"></i> Registrar cliente
                </a>
            </div>
        </div>
    }
</div>
