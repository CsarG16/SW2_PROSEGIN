                                <option value="Obra / Faena">Obra / Faena</option>
                                <option value="Sede Central / Oficina">Sede Central / Oficina</option>
                                <option value="Almacén / Depósito">Almacén / Depósito</option>
                                <option value="Centro de Distribución">Centro de Distribución</option>
