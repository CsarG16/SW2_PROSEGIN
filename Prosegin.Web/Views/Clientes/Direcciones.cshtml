                'Villa María del Triunfo': { ubigeo: '150143', dep: 'Lima', prov: 'Lima' }
            };

            function normalizarTexto(txt) {
                if (!txt) return '';
                return txt.toString()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .trim()
                    .toLowerCase();
            }

            function seleccionarOpcion(selectEl, valorDeseado, fallbackValor = '') {
                if (!selectEl) return;
                const valorLimpio = (valorDeseado || fallbackValor || '').toString().trim();
                const buscado = normalizarTexto(valorLimpio);
                if (!buscado) {
                    if (selectEl.options.length > 0) selectEl.selectedIndex = 0;
                    return;
                }

                let encontrado = false;
                for (let i = 0; i < selectEl.options.length; i++) {
                    const opt = selectEl.options[i];
                    if (normalizarTexto(opt.value) === buscado || normalizarTexto(opt.text) === buscado) {
                        selectEl.selectedIndex = i;
                        encontrado = true;
                        break;
                    }
                }

                // Si no se encuentra en las opciones estáticas, crear la opción dinámicamente para que no quede vacía
                if (!encontrado && valorLimpio) {
                    const nuevaOpcion = new Option(valorLimpio, valorLimpio, true, true);
                    selectEl.add(nuevaOpcion);
                    selectEl.value = valorLimpio;
                }
            }

            function actualizarPorDistrito(nombreDistrito) {
                const norm = normalizarTexto(nombreDistrito);
                for (const [distKey, data] of Object.entries(mapUbigeos)) {
                    if (normalizarTexto(distKey) === norm) {
                        if (data.ubigeo) {
                            inputUbigeo.value = data.ubigeo;
                            inputUbigeo.classList.remove('is-invalid');
                        }
                        if (data.dep) seleccionarOpcion(inputDepartamento, data.dep);
                        if (data.prov) seleccionarOpcion(inputProvincia, data.prov);
                        return;
                    }
                }
            }

            inputDistrito.addEventListener('change', function () {
                actualizarPorDistrito(this.value);
            });

            // Limpiar errores visuales al tipear
            const camposRequeridos = [inputTipoSede, inputNombreAlias, inputDireccion, inputDepartamento, inputProvincia, inputDistrito, inputUbigeo];
            camposRequeridos.forEach(campo => {
                ['input', 'change'].forEach(evt => {
                    campo.addEventListener(evt, function () {
                        if (this.value.trim().length > 0) {
                            this.classList.remove('is-invalid');
                        }
                    });
                });
            });

            function limpiarFormularioModal() {
                inputSedeId.value = '0';
                inputTipoSede.value = '';
                inputNombreAlias.value = '';
                inputDireccion.value = '';
                inputReferencia.value = '';

                // Agarrar automáticamente los datos registrados del cliente
                seleccionarOpcion(inputDepartamento, clienteData.departamento, 'Lima');
                seleccionarOpcion(inputProvincia, clienteData.provincia, 'Lima');
                seleccionarOpcion(inputDistrito, clienteData.distrito, 'Lurín');
                inputUbigeo.value = clienteData.ubigeo || (mapUbigeos[inputDistrito.value] ? mapUbigeos[inputDistrito.value].ubigeo : '150119');

                inputContacto.value = '';
                inputTelefono.value = '';
                inputHorario.value = '';
                inputRestricciones.value = '';
                checkPredeterminada.checked = false;

                camposRequeridos.forEach(campo => campo.classList.remove('is-invalid'));
                alertaCampos.classList.add('d-none');
            }

            // ==============================================================
            // CRITERIO 1: ABRIR MODAL AL CLIQUEAR "+ NUEVA DIRECCIÓN"
            // ==============================================================
            btnAbrirModal.addEventListener('click', function () {
                limpiarFormularioModal();
                modalHeaderTitulo.textContent = 'Registrar Sede de Entrega';
                bsModal.show();
            });

            // ==============================================================
            // CRITERIO 4: CANCELAR O (X) DESCARTE DE DATOS Y CIERRE
            // ==============================================================
            function descartarYCerrar() {
                limpiarFormularioModal();
                bsModal.hide();
            }

            btnCancelar.addEventListener('click', descartarYCerrar);
            btnCerrarX.addEventListener('click', descartarYCerrar);

            // ==============================================================
            // CRITERIO 2 Y 3: GUARDAR DIRECCIÓN CON VALIDACIONES
            // ==============================================================
            btnGuardar.addEventListener('click', async function () {
                let hayErrores = false;

                camposRequeridos.forEach(campo => {
                    if (!campo.value || campo.value.trim().length === 0) {
                        campo.classList.add('is-invalid');
                        hayErrores = true;
                    } else {
                        campo.classList.remove('is-invalid');
                    }
                });

                if (hayErrores) {
                    alertaCampos.classList.remove('d-none');
                    mensajeAlertaCampos.textContent = 'Debe completar todos los datos obligatorios marcados con asterisco (*).';
                    
                    const primerInvalido = camposRequeridos.find(c => c.classList.contains('is-invalid'));
                    if (primerInvalido) primerInvalido.focus();

                    ProseginAlert.warning(
                        'Debe completar todos los campos obligatorios marcados con asterisco (*).',
                        'Campos Obligatorios Faltantes'
                    );
                    return;
                }

                alertaCampos.classList.add('d-none');
                btnGuardar.disabled = true;
                const textoOriginal = btnGuardar.innerHTML;
                btnGuardar.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Guardando...';

                const payload = {
                    Id: parseInt(inputSedeId.value, 10) || 0,
                    ClienteId: clienteId,
                    TipoSede: inputTipoSede.value.trim(),
                    NombreAlias: inputNombreAlias.value.trim(),
                    Direccion: inputDireccion.value.trim(),
                    Referencia: inputReferencia.value.trim(),
                    Departamento: inputDepartamento.value.trim(),
                    Provincia: inputProvincia.value.trim(),
                    Distrito: inputDistrito.value.trim(),
                    Ubigeo: inputUbigeo.value.trim(),
                    ContactoRecepcion: inputContacto.value.trim(),
                    TelefonoMovil: inputTelefono.value.trim(),
                    HorarioRecepcion: inputHorario.value.trim(),
                    RestriccionesAcceso: inputRestricciones.value.trim(),
                    EsPredeterminada: checkPredeterminada.checked,
                    Activo: true
                };

                try {
                    const response = await fetch('/Clientes/GuardarDireccion', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(payload)
                    });

                    const res = await response.json();

                    if (!res.success) {
                        alertaCampos.classList.remove('d-none');
                        mensajeAlertaCampos.textContent = res.message || 'Error al guardar la sede.';
                        ProseginAlert.error(res.message || 'No se pudo guardar la sede de entrega.');
                        return;
                    }

                    // Éxito: cerrar modal
                    bsModal.hide();
                    limpiarFormularioModal();

                    ProseginAlert.success(res.message, 'Operación Exitosa');

                    // Actualizar el contador de sedes activas
                    if (contadorSedes && res.totalActivas !== undefined) {
                        contadorSedes.textContent = res.totalActivas;
                    }

                    // Recargar la vista suavemente para reflejar la sincronización de base de datos
                    setTimeout(() => {
                        window.location.reload();
                    }, 500);

                } catch (error) {
                    alertaCampos.classList.remove('d-none');
                    mensajeAlertaCampos.textContent = 'Error de conexión con el servidor.';
                    ProseginAlert.error('Ocurrió un error al procesar la solicitud.');
                } finally {
                    btnGuardar.disabled = false;
                    btnGuardar.innerHTML = textoOriginal;
                }
            });

            // ==============================================================
            // CRITERIO 5: BÚSQUEDA DINÁMICA POR SEDE O DISTRITO
            // ==============================================================
            txtBuscar.addEventListener('input', function () {
                const query = this.value.trim().toLowerCase();
                const cards = document.querySelectorAll('.sede-card');
                let visibles = 0;

                cards.forEach(card => {
                    const nombre = (card.getAttribute('data-nombre') || '').toLowerCase();
                    const distrito = (card.getAttribute('data-distrito') || '').toLowerCase();
                    const direccion = (card.getAttribute('data-direccion') || '').toLowerCase();

                    if (nombre.includes(query) || distrito.includes(query) || direccion.includes(query)) {
                        card.style.display = '';
                        visibles++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                let msgNoResultados = document.getElementById('msgNoResultados');
                if (visibles === 0 && cards.length > 0) {
                    if (!msgNoResultados) {
                        msgNoResultados = document.createElement('div');
                        msgNoResultados.id = 'msgNoResultados';
                        msgNoResultados.className = 'alert alert-light text-center py-4 rounded-4 border text-muted small';
                        msgNoResultados.innerHTML = `<i class="bi bi-search mb-2 fs-4 d-block"></i> No se encontraron direcciones para "<strong>${query}</strong>".`;
                        contenedorDirecciones.appendChild(msgNoResultados);
                    } else {
                        msgNoResultados.style.display = '';
                        msgNoResultados.innerHTML = `<i class="bi bi-search mb-2 fs-4 d-block"></i> No se encontraron direcciones para "<strong>${query}</strong>".`;
                    }
                } else if (msgNoResultados) {
                    msgNoResultados.style.display = 'none';
                }
            });

            // ==============================================================
            // CRITERIO 6: EDITAR SEDE (PRECARGA EN MODAL)
            // ==============================================================
            document.addEventListener('click', async function (e) {
                const btnEditar = e.target.closest('.btn-editar-sede');
                if (!btnEditar) return;

                const sedeId = btnEditar.getAttribute('data-id');
                if (!sedeId) return;

                limpiarFormularioModal();
                modalHeaderTitulo.textContent = 'Editar Sede de Entrega';

                try {
                    const response = await fetch(`/Clientes/ObtenerDireccion?id=${encodeURIComponent(sedeId)}`);
                    const res = await response.json();

                    if (!res.success || !res.direccion) {
                        ProseginAlert.error(res.message || 'No se pudo obtener la información de la sede.');
                        return;
                    }

                    const d = res.direccion;
                    inputSedeId.value = d.id;
                    inputTipoSede.value = d.tipoSede || '';
                    inputNombreAlias.value = d.nombreAlias || '';
                    inputDireccion.value = d.direccion || '';
                    inputReferencia.value = d.referencia || '';
                    seleccionarOpcion(inputDepartamento, d.departamento, clienteData.departamento);
                    seleccionarOpcion(inputProvincia, d.provincia, clienteData.provincia);
                    seleccionarOpcion(inputDistrito, d.distrito, clienteData.distrito);
                    inputUbigeo.value = d.ubigeo || (mapUbigeos[inputDistrito.value] ? mapUbigeos[inputDistrito.value].ubigeo : clienteData.ubigeo);
                    inputContacto.value = d.contactoRecepcion || '';
                    inputTelefono.value = d.telefonoMovil || '';
                    inputHorario.value = d.horarioRecepcion || '';
                    inputRestricciones.value = d.restriccionesAcceso || '';
                    checkPredeterminada.checked = d.esPredeterminada === true;

                    bsModal.show();
                } catch (error) {
                    ProseginAlert.error('Error al cargar los datos para edición.');
                }
            });

            // ==============================================================
            // CRITERIO 7: DESACTIVAR SEDE (CON VALIDACIÓN DE PREDETERMINADA)
            // ==============================================================
            document.addEventListener('click', async function (e) {
                const btnDesactivar = e.target.closest('.btn-desactivar-sede');
                if (!btnDesactivar) return;

                const sedeId = parseInt(btnDesactivar.getAttribute('data-id'), 10);
                if (!sedeId) return;

                const card = document.getElementById(`sedeCard-${sedeId}`);
                const esPredeterminada = card && card.getAttribute('data-predeterminada') === 'true';

                if (esPredeterminada) {
                    ProseginAlert.warning(
                        'No es posible desactivar la sede predeterminada. Debe designar primero otra sede como predeterminada.',
                        'Acción Restringida'
                    );
                    return;
                }

                // Confirmación visual
                const confirmacion = confirm('¿Está seguro de desactivar esta sede de entrega? Ya no figurará disponible para el cálculo de flete ni emisión de Guías de Remisión.');
                if (!confirmacion) return;

                try {
                    const response = await fetch('/Clientes/DesactivarDireccion', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ Id: sedeId })
                    });

                    const res = await response.json();

                    if (!res.success) {
                        ProseginAlert.warning(res.message || 'No se pudo desactivar la sede.', 'Atención');
                        return;
                    }

                    // Remover tarjeta suavemente y descontar contador
                    if (card) {
                        card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                        card.style.opacity = '0';
                        card.style.transform = 'translateY(-10px)';
                        setTimeout(() => {
                            card.remove();
                            // Renumerar tarjetas visibles
                            const titulos = document.querySelectorAll('.sede-titulo-numero');
                            titulos.forEach((t, idx) => {
                                const texto = t.textContent.replace(/^\d+\.\s*/, '');
                                t.textContent = `${idx + 1}. ${texto}`;
                            });

                            if (contadorSedes && res.totalActivas !== undefined) {
                                contadorSedes.textContent = res.totalActivas;
                            }
                        }, 300);
                    }

                    ProseginAlert.success(res.message, 'Sede Desactivada');

                } catch (error) {
                    ProseginAlert.error('Ocurrió un error al intentar desactivar la sede.');
                }
            });

        });
    </script>
