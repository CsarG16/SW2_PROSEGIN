@model Prosegin.Web.ViewModels.Clientes.ClienteDireccionesViewModel
@{
    ViewData["Title"] = $"Direcciones de Entrega - {Model.Cliente.RazonSocial}";
}

@Html.AntiForgeryToken()

<div class="container-fluid px-0">
    
    <!-- TARJETA 1: ENCABEZADO Y RESUMEN DEL CLIENTE (EXACTO A GUI SIN LOGO PROSEGIN) -->
    <div class="prosegin-card p-4 mb-3 border-0 shadow-sm rounded-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <h4 class="fw-bold mb-0 text-dark" style="letter-spacing: -0.02em;">@Model.Cliente.RazonSocial</h4>
                    <span class="text-muted fw-semibold"> RUC: @Model.Cliente.Ruc</span>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                    <span>
                        <i class="bi bi-building me-1"></i> @Model.Cliente.DireccionFiscal@(string.IsNullOrWhiteSpace(Model.Cliente.Distrito) ? "" : $", {Model.Cliente.Distrito}")@(string.IsNullOrWhiteSpace(Model.Cliente.Departamento) ? "" : $", {Model.Cliente.Departamento}")
                    </span>
                </div>
            </div>

            <!-- Botón Acción: Volver al Directorio de Clientes y + Nueva Dirección -->
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 small fw-semibold text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Clientes
                </a>
                <button type="button" class="btn btn-dark rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm text-white" id="btnAbrirModalNuevaSede">
                    <i class="bi bi-plus-lg"></i> Nueva Dirección de Entrega
                </button>
            </div>
        </div>
    </div>

    <!-- TARJETA 2: BANNER GRE (GUÍAS DE REMISIÓN ELECTRÓNICAS) -->
    <div class="prosegin-card p-3 mb-4 border-0 shadow-sm rounded-4 bg-white d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="p-2 rounded-3 bg-light text-secondary d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <i class="bi bi-truck fs-4"></i>
            </div>
            <div>
                <div class="fw-bold text-dark" style="font-size: 0.95rem;">Direcciones validadas para Guías de Remisión Electrónicas (GRE)</div>
                <div class="text-muted small">Todos los destinos registrados cuentan con código de Ubigeo oficial para emisión directa de GRE remitente y transportista.</div>
            </div>
        </div>
        <div>
            <span class="badge rounded-pill bg-light text-dark border px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2">
                <i class="bi bi-geo-alt"></i> <span id="contadorSedesActivas">@Model.DireccionesActivas.Count</span> sedes activas
            </span>
        </div>
    </div>

    <!-- SECCIÓN: LISTADO DE DIRECCIONES DE DESPACHO REGISTRADAS -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
        <div>
            <h5 class="fw-bold mb-1 text-dark">Direcciones de Despacho Registradas</h5>
            <p class="text-muted small mb-0">Puntos de entrega habilitados para este cliente y sus respectivas órdenes de compra.</p>
        </div>
        <div style="min-width: 280px; max-width: 360px;">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="txtBuscarDireccion" class="form-control border-start-0 ps-0 form-control-prosegin" placeholder="Buscar por sede o distrito..." autocomplete="off">
            </div>
        </div>
    </div>

    <!-- CONTENEDOR DE TARJETAS DE SEDES -->
    <div id="contenedorDirecciones" class="d-flex flex-column gap-3 mb-4">
        @if (Model.DireccionesActivas.Count == 0)
        {
            <div id="emptyStateDirecciones" class="prosegin-card p-5 text-center rounded-4 border-0 shadow-sm bg-white">
                <i class="bi bi-geo-alt text-muted fs-1 mb-2 d-block"></i>
                <h6 class="fw-bold text-dark">Aún no hay direcciones de despacho registradas</h6>
                <p class="text-muted small mb-3">Registre la primera sede autorizada para despachos de EPP y Guías de Remisión.</p>
                <button type="button" class="btn btn-dark rounded-pill px-4 py-2 fw-bold" onclick="document.getElementById('btnAbrirModalNuevaSede').click();">
                    <i class="bi bi-plus-lg me-1"></i> Registrar Primera Dirección
                </button>
            </div>
        }
        else
        {
            var index = 1;
            foreach (var sede in Model.DireccionesActivas)
            {
                <div class="sede-card prosegin-card p-3 rounded-4 border-0 shadow-sm bg-white position-relative @(sede.EsPredeterminada ? "sede-predeterminada-card" : "")" 
                     id="sedeCard-@sede.Id"
                     data-id="@sede.Id"
                     data-nombre="@sede.NombreAlias"
                     data-distrito="@sede.Distrito"
                     data-direccion="@sede.Direccion"
                     data-predeterminada="@sede.EsPredeterminada.ToString().ToLower()">
                    
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fw-bold text-dark fs-6 sede-titulo-numero">@index. @sede.NombreAlias</span>
                            @if (sede.EsPredeterminada)
                            {
                                <span class="badge bg-dark text-white rounded-pill px-2 py-1 small fw-semibold badge-tag-predeterminada">Predeterminada</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(sede.TipoSede))
                            {
                                <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 small fw-semibold badge-tag-tipo">@sede.TipoSede</span>
                            }
                        </div>

                        <!-- Botones de Acción: Editar y Desactivar -->
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" class="btn btn-link text-decoration-none text-dark small fw-semibold p-0 btn-editar-sede" data-id="@sede.Id">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </button>
                            <button type="button" class="btn btn-link text-decoration-none text-danger small fw-semibold p-0 btn-desactivar-sede" data-id="@sede.Id">
                                <i class="bi bi-slash-circle me-1"></i> Desactivar
                            </button>
                        </div>
                    </div>

                    <!-- Fila 1: Dirección y Ubigeo -->
                    <div class="text-secondary small mb-2">
                        <i class="bi bi-geo-alt me-1 text-muted"></i>
                        <span>@sede.Direccion</span>
                        @if (!string.IsNullOrWhiteSpace(sede.Ubigeo))
                        {
                            <span class="ms-1">· Ubigeo: <strong>@sede.Ubigeo</strong></span>
                        }
                    </div>

                    <!-- Fila 2: Contacto, Horario y Restricciones -->
                    <div class="d-flex flex-wrap align-items-center gap-4 text-muted small">
                        @if (!string.IsNullOrWhiteSpace(sede.ContactoRecepcion) || !string.IsNullOrWhiteSpace(sede.TelefonoMovil))
                        {
                            <span>
                                <i class="bi bi-person me-1"></i>
                                @(string.IsNullOrWhiteSpace(sede.ContactoRecepcion) ? "" : sede.ContactoRecepcion)
                                @if (!string.IsNullOrWhiteSpace(sede.TelefonoMovil))
                                {
                                    <span>· <strong>@sede.TelefonoMovil</strong></span>
                                }
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(sede.HorarioRecepcion))
                        {
                            <span>
                                <i class="bi bi-clock me-1"></i> @sede.HorarioRecepcion
                            </span>
                        }

                        @if (!string.IsNullOrWhiteSpace(sede.RestriccionesAcceso))
                        {
                            <span>
                                <i class="bi bi-exclamation-triangle me-1"></i> @sede.RestriccionesAcceso
                            </span>
                        }
                    </div>

                </div>
                index++;
            }
        }
    </div>

</div>

<!-- ============================================================== -->
<!-- MODAL: REGISTRAR / EDITAR SEDE DE ENTREGA (EXACTO A IMAGEN 1) -->
