@using System.Globalization
@model Prosegin.Web.ViewModels.Finanzas.DetalleCuentaPorCobrarViewModel
@{
    ViewData["Title"] = $"Detalle de Factura {Model.NumeroFactura}";
    var culturaPe = CultureInfo.GetCultureInfo("es-PE");
    var badgeClass = Model.Estado switch
    {
        "Pagada" => "badge-status-success",
        "Vencida" => "badge-status-danger",
        _ => "badge-status-warning"
    };
    var estaPagada = Model.SaldoPendiente <= 0
        || string.Equals(Model.Estado, "Pagada", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/finanzas.css" asp-append-version="true" />
}

<div class="container-fluid px-0 finanzas-page">
    <div class="prosegin-card p-3 p-md-4 mb-3">
        <div class="prosegin-page-header--accent" style="margin-bottom: 0;">
            <div class="header-content">
                <h1 class="page-title">Detalle de factura @Model.NumeroFactura</h1>
                <p class="page-subtitle">
                    @Model.Cliente @(string.IsNullOrWhiteSpace(Model.RucCliente) ? "" : $"· RUC {Model.RucCliente}")
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="CuentasPorCobrar" class="btn-prosegin-secondary">
                    <span class="material-symbols-outlined">arrow_back</span> Cuentas por Cobrar
                </a>
                @if (!estaPagada)
                {
                    <a asp-action="RegistroPago" asp-route-facturaId="@Model.Id" class="btn-prosegin-primary">
                        <span class="material-symbols-outlined">payments</span> Registrar pago
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="prosegin-card p-3 p-md-4 mb-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <span class="prosegin-section-label mb-0">Información del comprobante</span>
            <span class="badge-status @badgeClass">
                <span class="status-dot"></span> @Model.Estado
            </span>
        </div>

        <div class="finanzas-meta-grid">
            <div>
                <span class="finanzas-meta-label">Cliente</span>
                <span class="finanzas-meta-value">@Model.Cliente</span>
            </div>
            <div>
                <span class="finanzas-meta-label">RUC</span>
                <span class="finanzas-meta-value">@(string.IsNullOrWhiteSpace(Model.RucCliente) ? "—" : Model.RucCliente)</span>
            </div>
            <div>
                <span class="finanzas-meta-label">Fecha de emisión</span>
                <span class="finanzas-meta-value">@Model.FechaEmision.ToString("dd/MM/yyyy")</span>
            </div>
            <div>
                <span class="finanzas-meta-label">Fecha de vencimiento</span>
                <span class="finanzas-meta-value">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</span>
            </div>
            <div>
                <span class="finanzas-meta-label">Plazo</span>
                <span class="finanzas-meta-value">@(Model.PlazoDias == 0 ? "Contado" : $"{Model.PlazoDias} días")</span>
            </div>
            <div>
                <span class="finanzas-meta-label">Monto total</span>
                <span class="finanzas-meta-value">@Model.MontoTotal.ToString("C", culturaPe)</span>
            </div>
            <div>
                <span class="finanzas-meta-label">Saldo pendiente</span>
                <span class="finanzas-meta-value text-dark fw-bold">@Model.SaldoPendiente.ToString("C", culturaPe)</span>
            </div>
        </div>
    </div>

    <div class="prosegin-card overflow-hidden">
        <div class="prosegin-results-header">
            <div class="d-flex align-items-center gap-2">
                <span class="results-title">Detalle de productos facturados</span>
                <span class="count-pill">@Model.Detalles.Count ítems</span>
            </div>
        </div>

        @if (!Model.Detalles.Any())
        {
            <div class="prosegin-empty-state">
                <span class="material-symbols-outlined empty-icon d-block">inventory_2</span>
                <div class="empty-title">Sin líneas registradas</div>
                <div class="empty-desc">Este comprobante no cuenta con ítems de detalle asociados.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="prosegin-table mb-0">
                    <thead>
                        <tr>
                            <th>DESCRIPCIÓN</th>
                            <th class="text-end">CANTIDAD</th>
                            <th class="text-end">PRECIO UNITARIO</th>
                            <th class="text-end">TOTAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Detalles)
                        {
                            <tr>
                                <td class="fw-medium text-dark">@item.Descripcion</td>
                                <td class="text-end">@item.Cantidad.ToString("N2", culturaPe)</td>
                                <td class="text-end text-nowrap">@item.PrecioUnitario.ToString("C", culturaPe)</td>
                                <td class="text-end fw-bold text-dark text-nowrap">@item.Total.ToString("C", culturaPe)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
