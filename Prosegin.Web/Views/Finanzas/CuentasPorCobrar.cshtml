@using System.Globalization
@model Prosegin.Web.ViewModels.Finanzas.CuentasPorCobrarViewModel
@{
    ViewData["Title"] = "Cuentas por Cobrar";
    var culturaPe = CultureInfo.GetCultureInfo("es-PE");
    var esErrorValidacion = !string.IsNullOrWhiteSpace(Model.Mensaje)
        && Model.Mensaje.Contains("mayor", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/finanzas.css" asp-append-version="true" />
}

<div class="container-fluid px-0 finanzas-page">
    <div class="prosegin-card p-3 p-md-4 mb-3">
        <div class="prosegin-page-header--accent" style="margin-bottom: 0;">
            <div class="header-content">
                <h1 class="page-title">Cuentas por cobrar</h1>
                <p class="page-subtitle">Visualización y control de cartera, pagos pendientes y facturas vencidas.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="FacturasPorVencer" class="btn-prosegin-secondary">
                    <span class="material-symbols-outlined">event_upcoming</span> Facturas por Vencer
                </a>
                <a asp-action="RegistroPago" class="btn-prosegin-primary">
                    <span class="material-symbols-outlined">payments</span> Registro de Pago
                </a>
            </div>
        </div>
    </div>

    <div class="prosegin-card p-3 p-md-4 mb-3">
        <div class="prosegin-section-label mb-3">Filtros de búsqueda</div>
        <form asp-action="CuentasPorCobrar" method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-4">
                <label class="form-label-prosegin" for="filtroCliente">Cliente</label>
                <select id="filtroCliente" name="clienteId" class="form-select form-select-prosegin">
                    <option value="">Todos los clientes</option>
                    @foreach (var cliente in Model.Clientes)
                    {
                        <option value="@cliente.Id" selected="@(Model.ClienteId == cliente.Id)">@cliente.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-2">
                <label class="form-label-prosegin" for="filtroEstado">Estado de pago</label>
                <select id="filtroEstado" name="estado" class="form-select form-select-prosegin">
                    <option value="TODAS" selected="@(Model.Estado == "TODAS")">Todos</option>
                    <option value="AL_DIA" selected="@(Model.Estado == "AL_DIA")">Al día / por vencer</option>
                    <option value="VENCIDA" selected="@(Model.Estado == "VENCIDA")">Vencida</option>
                    <option value="PAGADA" selected="@(Model.Estado == "PAGADA")">Pagada</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-3">
                <label class="form-label-prosegin" for="fechaEmisionDesde">Emisión desde</label>
                <input id="fechaEmisionDesde" type="date" name="fechaEmisionDesde"
                       value="@Model.FechaEmisionDesde?.ToString("yyyy-MM-dd")"
                       class="form-control form-control-prosegin" />
            </div>
            <div class="col-6 col-md-3 col-lg-3">
                <label class="form-label-prosegin" for="fechaEmisionHasta">Emisión hasta</label>
                <input id="fechaEmisionHasta" type="date" name="fechaEmisionHasta"
                       value="@Model.FechaEmisionHasta?.ToString("yyyy-MM-dd")"
                       class="form-control form-control-prosegin" />
            </div>
            <div class="col-6 col-md-3 col-lg-3">
                <label class="form-label-prosegin" for="fechaVencimientoDesde">Vencimiento desde</label>
                <input id="fechaVencimientoDesde" type="date" name="fechaVencimientoDesde"
                       value="@Model.FechaVencimientoDesde?.ToString("yyyy-MM-dd")"
                       class="form-control form-control-prosegin" />
            </div>
            <div class="col-6 col-md-3 col-lg-3">
                <label class="form-label-prosegin" for="fechaVencimientoHasta">Vencimiento hasta</label>
                <input id="fechaVencimientoHasta" type="date" name="fechaVencimientoHasta"
                       value="@Model.FechaVencimientoHasta?.ToString("yyyy-MM-dd")"
                       class="form-control form-control-prosegin" />
            </div>
            <div class="col-12 col-md-6 col-lg-6 d-flex flex-wrap justify-content-lg-end gap-2">
                <button type="submit" class="btn-prosegin-primary">
                    <span class="material-symbols-outlined">search</span> Filtrar
                </button>
                <a asp-action="CuentasPorCobrar" class="btn-prosegin-secondary">
                    <span class="material-symbols-outlined">restart_alt</span> Limpiar
                </a>
            </div>
        </form>
    </div>

    @if (esErrorValidacion)
    {
        <div class="prosegin-alert prosegin-alert-warning mb-3" role="alert">
            <span class="material-symbols-outlined">warning</span>
            <span>@Model.Mensaje</span>
        </div>
    }
    else if (Model.Facturas.Count == 0)
    {
        <div class="prosegin-card">
            <div class="prosegin-empty-state">
                <span class="material-symbols-outlined empty-icon d-block">receipt_long</span>
                <div class="empty-title">Sin comprobantes disponibles</div>
                <div class="empty-desc">@(Model.Mensaje ?? "No se encontraron facturas con los criterios seleccionados.")</div>
            </div>
        </div>
    }
    else
    {
        <div class="prosegin-card overflow-hidden">
            <div class="prosegin-results-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="results-title">Cartera de Cuentas por Cobrar</span>
                    <span class="count-pill">@Model.TotalRegistros registros</span>
                </div>
                <span class="results-note">Use el ícono de ojo para desplegar el detalle del comprobante</span>
            </div>

            <div class="table-responsive">
                <table class="prosegin-table mb-0">
                    <thead>
                        <tr>
                            <th>FACTURA</th>
                            <th>CLIENTE</th>
                            <th>VENCIMIENTO</th>
                            <th>TOTAL</th>
                            <th>SALDO PENDIENTE</th>
                            <th>ESTADO</th>
                            <th class="text-end">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in Model.Facturas)
                        {
                            var badgeClass = factura.Estado switch
                            {
                                "Pagada" => "badge-status-success",
                                "Vencida" => "badge-status-danger",
                                _ => "badge-status-warning"
                            };
                            var estaPagada = factura.SaldoPendiente <= 0
                                || string.Equals(factura.Estado, "Pagada", StringComparison.OrdinalIgnoreCase);

                            <tr class="finanzas-parent-row" data-factura-row="@factura.Id">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="row-icon-avatar">
                                            <span class="material-symbols-outlined">receipt_long</span>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@factura.NumeroFactura</div>
                                            <div class="text-muted" style="font-size: 0.76rem;">
                                                @(factura.PlazoDias == 0 ? "Contado" : $"Crédito {factura.PlazoDias} días")
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@factura.Cliente</div>
                                    @if (!string.IsNullOrWhiteSpace(factura.RucCliente))
                                    {
                                        <div class="text-muted" style="font-size: 0.76rem;">RUC @factura.RucCliente</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@factura.FechaVencimiento.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.76rem;">Emisión: @factura.FechaEmision.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="text-nowrap fw-medium text-dark">
                                    @factura.MontoTotal.ToString("C", culturaPe)
                                </td>
                                <td class="text-nowrap fw-bold @(factura.SaldoPendiente > 0 ? "text-dark" : "text-muted")">
                                    @factura.SaldoPendiente.ToString("C", culturaPe)
                                </td>
                                <td>
                                    <span class="badge-status @badgeClass">
                                        <span class="status-dot"></span> @factura.Estado
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center justify-content-end gap-2 flex-nowrap">
                                        <button type="button"
                                                class="btn-prosegin-action-secondary finanzas-action-icon toggle-detalle-factura"
                                                data-target="detalle-@factura.Id"
                                                aria-expanded="false"
                                                aria-controls="detalle-@factura.Id"
                                                title="Visualizar detalle">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </button>

                                        <a asp-action="DescargarFactura"
                                           asp-route-id="@factura.Id"
                                           asp-route-origen="CuentasPorCobrar"
                                           asp-route-clienteCuentasId="@Model.ClienteId"
                                           asp-route-estadoCuentas="@Model.Estado"
                                           asp-route-emisionDesde="@Model.FechaEmisionDesde?.ToString("yyyy-MM-dd")"
                                           asp-route-emisionHasta="@Model.FechaEmisionHasta?.ToString("yyyy-MM-dd")"
                                           asp-route-vencimientoDesde="@Model.FechaVencimientoDesde?.ToString("yyyy-MM-dd")"
                                           asp-route-vencimientoHasta="@Model.FechaVencimientoHasta?.ToString("yyyy-MM-dd")"
                                           asp-route-pagina="@Model.Pagina"
                                           class="btn-prosegin-action-secondary finanzas-action-icon"
                                           title="@(factura.PdfDisponible ? "Descargar comprobante PDF" : "Comprobante PDF no disponible")"
                                           aria-label="Descargar factura @factura.NumeroFactura">
                                            <span class="material-symbols-outlined">download</span>
                                        </a>

                                        @if (estaPagada)
                                        {
                                            <button type="button"
                                                    class="btn-prosegin-action-secondary"
                                                    disabled
                                                    title="Factura cancelada en su totalidad">
                                                <span class="material-symbols-outlined">check_circle</span> Registrar pago
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-action="RegistroPago"
                                               asp-route-facturaId="@factura.Id"
                                               class="btn-prosegin-action">
                                                <span class="material-symbols-outlined">payments</span> Registrar pago
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>

                            <tr class="finanzas-detail-row is-collapsed" id="detalle-@factura.Id">
                                <td colspan="7">
                                    <div class="finanzas-detail-panel">
                                        <div class="finanzas-detail-inner">
                                            <div class="finanzas-detail-content">
                                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="fw-bold text-dark">Detalle de factura @factura.NumeroFactura</span>
                                                        <span class="badge-status @badgeClass">
                                                            <span class="status-dot"></span> @factura.Estado
                                                        </span>
                                                    </div>
                                                    <a asp-action="DetalleFactura" asp-route-id="@factura.Id" class="btn-prosegin-action-secondary">
                                                        <span class="material-symbols-outlined">open_in_new</span> Ver ficha completa
                                                    </a>
                                                </div>

                                                <div class="finanzas-meta-grid mb-3">
                                                    <div>
                                                        <span class="finanzas-meta-label">Cliente</span>
                                                        <span class="finanzas-meta-value">@factura.Cliente</span>
                                                    </div>
                                                    <div>
                                                        <span class="finanzas-meta-label">RUC</span>
                                                        <span class="finanzas-meta-value">@(string.IsNullOrWhiteSpace(factura.RucCliente) ? "—" : factura.RucCliente)</span>
                                                    </div>
                                                    <div>
                                                        <span class="finanzas-meta-label">Fecha de emisión</span>
                                                        <span class="finanzas-meta-value">@factura.FechaEmision.ToString("dd/MM/yyyy")</span>
                                                    </div>
                                                    <div>
                                                        <span class="finanzas-meta-label">Fecha de vencimiento</span>
                                                        <span class="finanzas-meta-value">@factura.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                                                    </div>
                                                    <div>
                                                        <span class="finanzas-meta-label">Importe total</span>
                                                        <span class="finanzas-meta-value">@factura.MontoTotal.ToString("C", culturaPe)</span>
                                                    </div>
                                                    <div>
                                                        <span class="finanzas-meta-label">Abonado</span>
                                                        <span class="finanzas-meta-value">@factura.MontoAbonado.ToString("C", culturaPe)</span>
                                                    </div>
                                                    <div>
                                                        <span class="finanzas-meta-label">Saldo pendiente</span>
                                                        <span class="finanzas-meta-value">@factura.SaldoPendiente.ToString("C", culturaPe)</span>
                                                    </div>
                                                </div>

                                                @if (factura.Detalles.Any())
                                                {
                                                    <div class="table-responsive">
                                                        <table class="finanzas-inner-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Descripción</th>
                                                                    <th class="text-end">Cantidad</th>
                                                                    <th class="text-end">P. Unitario</th>
                                                                    <th class="text-end">Total</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var item in factura.Detalles)
                                                                {
                                                                    <tr>
                                                                        <td>@item.Descripcion</td>
                                                                        <td class="text-end">@item.Cantidad.ToString("N2", culturaPe)</td>
                                                                        <td class="text-end text-nowrap">@item.PrecioUnitario.ToString("C", culturaPe)</td>
                                                                        <td class="text-end fw-semibold text-nowrap">@item.Total.ToString("C", culturaPe)</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted" style="font-size: 0.82rem;">
                                                        Sin ítems de detalle registrados para este comprobante.
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="prosegin-table-footer">
                <span>Mostrando @Model.Facturas.Count de @Model.TotalRegistros facturas</span>

                @if (Model.TotalPaginas > 1)
                {
                    <nav aria-label="Paginación de cuentas por cobrar">
                        <ul class="finanzas-pagination">
                            @for (var i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="CuentasPorCobrar"
                                       asp-route-clienteId="@Model.ClienteId"
                                       asp-route-estado="@Model.Estado"
                                       asp-route-fechaEmisionDesde="@Model.FechaEmisionDesde?.ToString("yyyy-MM-dd")"
                                       asp-route-fechaEmisionHasta="@Model.FechaEmisionHasta?.ToString("yyyy-MM-dd")"
                                       asp-route-fechaVencimientoDesde="@Model.FechaVencimientoDesde?.ToString("yyyy-MM-dd")"
                                       asp-route-fechaVencimientoHasta="@Model.FechaVencimientoHasta?.ToString("yyyy-MM-dd")"
                                       asp-route-pagina="@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.toggle-detalle-factura').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-target');
                    var detailRow = targetId ? document.getElementById(targetId) : null;
                    if (!detailRow) return;

                    var parentRow = detailRow.previousElementSibling;
                    var isExpanded = detailRow.classList.contains('is-expanded');
                    detailRow.classList.toggle('is-expanded', !isExpanded);
                    detailRow.classList.toggle('is-collapsed', isExpanded);
                    if (parentRow && parentRow.classList.contains('finanzas-parent-row')) {
                        parentRow.classList.toggle('is-expanded', !isExpanded);
                    }
                    btn.setAttribute('aria-expanded', String(!isExpanded));

                    var icon = btn.querySelector('.material-symbols-outlined');
                    if (icon) {
                        icon.textContent = !isExpanded ? 'visibility_off' : 'visibility';
                    }
                });
            });
        })();
    </script>
}
