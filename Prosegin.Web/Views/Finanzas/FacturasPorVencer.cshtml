@model Prosegin.Web.ViewModels.Finanzas.FacturasPorVencerViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Facturas por vencer";
    var culture = CultureInfo.GetCultureInfo("es-PE");
}

@section Styles {
    <link rel="stylesheet" href="~/css/finanzas.css" asp-append-version="true" />
}

<div class="container-fluid px-0 finance-page">
    <header class="finance-page-header">
        <div class="finance-page-heading">
            <span class="finance-page-icon"><i class="material-symbols-outlined">event_upcoming</i></span>
            <div>
                <div class="finance-page-kicker">Finanzas / Cobranzas</div>
                <h1 class="finance-page-title">Facturas por vencer</h1>
                <p class="finance-page-subtitle">Seguimiento de saldos pendientes y fechas de vencimiento.</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 finance-page-header-actions">
            <a asp-action="CuentasPorCobrar" class="btn-prosegin-secondary">Cuentas por cobrar</a>
            <a asp-action="RegistroPago" class="btn-prosegin-primary">Registro de Pago</a>
            <span class="finance-brand-pill"><i class="material-symbols-outlined">payments</i>PROSEGIN</span>
        </div>
    </header>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="finance-summary-card">
                <div class="finance-summary-label">Por vencer (≤ 7 días)</div>
                <div class="finance-summary-value">@Model.PorVencerSieteDias</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="finance-summary-card">
                <div class="finance-summary-label">Por vencer (8 – 15 días)</div>
                <div class="finance-summary-value">@Model.PorVencerQuinceDias</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="finance-summary-card">
                <div class="finance-summary-label">Por vencer (16 – 30 días)</div>
                <div class="finance-summary-value">@Model.PorVencerTreintaDias</div>
            </div>
        </div>
    </div>

    <form asp-action="FacturasPorVencer" method="get" class="finance-filter-panel">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6 col-xl-3">
                    <label class="form-label" for="clienteId">Cliente</label>
                    <select class="form-select" id="clienteId" name="clienteId">
                        <option value="">Todos los clientes</option>
                        @foreach (var cliente in Model.Clientes)
                        {
                            <option value="@cliente.Id" selected="@(Model.ClienteId == cliente.Id)">@cliente.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 col-xl-2">
                    <label class="form-label" for="fechaDesde">Vencimiento desde</label>
                    <input class="form-control" type="date" id="fechaDesde" name="fechaDesde" value="@Model.FechaDesde?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-6 col-xl-2">
                    <label class="form-label" for="fechaHasta">Vencimiento hasta</label>
                    <input class="form-control" type="date" id="fechaHasta" name="fechaHasta" value="@Model.FechaHasta?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-6 col-xl-3">
                    <label class="form-label" for="estado">Estado de pago</label>
                    <select class="form-select" id="estado" name="estado">
                        <option value="POR_VENCER" selected="@(Model.Estado == "POR_VENCER")">Por vencer</option>
                        <option value="VENCIDA" selected="@(Model.Estado == "VENCIDA")">Vencida</option>
                        <option value="PAGADA" selected="@(Model.Estado == "PAGADA")">Pagada</option>
                        <option value="TODAS" selected="@(Model.Estado == "TODAS")">Todos los estados</option>
                    </select>
                </div>
                <div class="col-md-6 col-xl-2 d-flex gap-2">
                    <button class="btn-prosegin-primary flex-grow-1" type="submit">Filtrar</button>
                    <a asp-action="FacturasPorVencer" class="btn-prosegin-secondary">Limpiar</a>
                </div>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="finance-empty-state" role="status">@Model.Mensaje</div>
    }

    @if (Model.Facturas.Count > 0)
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="text-muted small">Mostrando @Model.Facturas.Count de @Model.TotalRegistros facturas</span>
        </div>
        <div class="table-responsive finance-data-card">
            <table class="table table-hover align-middle finance-table">
                <thead class="table-light">
                    <tr>
                        <th>Factura</th>
                        <th>Cliente</th>
                        <th>Fecha de vencimiento</th>
                        <th class="text-end">Días</th>
                        <th class="text-end">Monto pendiente</th>
                        <th>Estado de pago</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var factura in Model.Facturas)
                    {
                        <tr>
                            <td class="finance-document-number">@factura.NumeroFactura</td>
                            <td>@factura.Cliente</td>
                            <td>@factura.FechaVencimiento.ToString("dd/MM/yyyy", culture)</td>
                            <td class="text-end">
                                @if (factura.EstadoPago == "Vencida")
                                {
                                    <span class="text-danger">@Math.Abs(factura.DiasHastaVencimiento) días vencida</span>
                                }
                                else if (factura.EstadoPago != "Pagada")
                                {
                                    <span>@factura.DiasHastaVencimiento días</span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="text-end">@factura.SaldoPendiente.ToString("C", culture)</td>
                            <td>
                                <span class="finance-status @(factura.EstadoPago == "Pagada" ? "is-paid" : factura.EstadoPago == "Vencida" ? "is-overdue" : "is-due")">
                                    @factura.EstadoPago
                                </span>
                            </td>
                            <td class="text-end">
                                @if (factura.PdfDisponible)
                                {
                                    <a asp-action="DescargarFactura"
                                       asp-route-id="@factura.Id"
                                       asp-route-clienteId="@Model.ClienteId"
                                       asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                                       asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                                       asp-route-estado="@Model.Estado"
                                       asp-route-pagina="@Model.Pagina"
                                       class="btn-prosegin-secondary-orange btn-sm finance-action-button"
                                       aria-label="Descargar factura @factura.NumeroFactura"
                                       title="Descargar PDF">
                                        <i class="material-symbols-outlined">download</i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="DescargarFactura"
                                       asp-route-id="@factura.Id"
                                       asp-route-clienteId="@Model.ClienteId"
                                       asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                                       asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                                       asp-route-estado="@Model.Estado"
                                       asp-route-pagina="@Model.Pagina"
                                       class="btn-prosegin-secondary btn-sm finance-action-button"
                                       aria-label="Documento no disponible de @factura.NumeroFactura"
                                       title="Descargar PDF">
                                        <i class="material-symbols-outlined">download</i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPaginas > 1)
        {
            <nav class="mt-3" aria-label="Paginación de facturas">
                <ul class="pagination justify-content-end">
                    @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                    {
                        <li class="page-item @(pagina == Model.Pagina ? "active" : "")">
                            <a class="page-link"
                               asp-action="FacturasPorVencer"
                               asp-route-clienteId="@Model.ClienteId"
                               asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                               asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                               asp-route-estado="@Model.Estado"
                               asp-route-pagina="@pagina">@pagina</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
