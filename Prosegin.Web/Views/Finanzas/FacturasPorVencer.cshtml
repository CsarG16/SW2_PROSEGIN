@using System.Globalization
@model Prosegin.Web.ViewModels.Finanzas.FacturasPorVencerViewModel
@{
    ViewData["Title"] = "Facturas por Vencer";
    var culturaPe = CultureInfo.GetCultureInfo("es-PE");
    var esErrorValidacion = !string.IsNullOrWhiteSpace(Model.Mensaje)
        && Model.Mensaje.Contains("mayor", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/finanzas.css" asp-append-version="true" />
}

<div class="container-fluid px-0 finanzas-page">
    <div class="prosegin-card p-3 p-md-4 mb-3">
        <div class="prosegin-page-header--accent" style="margin-bottom: 0;">
            <div class="header-content">
                <h1 class="page-title">Facturas por vencer</h1>
                <p class="page-subtitle">Seguimiento preventivo de vencimientos y gestión oportuna de cobranzas.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="CuentasPorCobrar" class="btn-prosegin-secondary">
                    <span class="material-symbols-outlined">account_balance_wallet</span> Cuentas por Cobrar
                </a>
                <a asp-action="RegistroPago" class="btn-prosegin-primary">
                    <span class="material-symbols-outlined">payments</span> Registro de Pago
                </a>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="prosegin-card finanzas-kpi-card is-urgent">
                <div class="finanzas-kpi-label">≤ 7 días</div>
                <div class="finanzas-kpi-value">@Model.PorVencerSieteDias</div>
                <div class="finanzas-kpi-note">Vencimiento inmediato</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="prosegin-card finanzas-kpi-card is-moderate">
                <div class="finanzas-kpi-label">8 – 15 días</div>
                <div class="finanzas-kpi-value">@Model.PorVencerQuinceDias</div>
                <div class="finanzas-kpi-note">Recordatorio preventivo</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="prosegin-card finanzas-kpi-card is-upcoming">
                <div class="finanzas-kpi-label">16 – 30 días</div>
                <div class="finanzas-kpi-value">@Model.PorVencerTreintaDias</div>
                <div class="finanzas-kpi-note">Cartera programada</div>
            </div>
        </div>
    </div>

    <div class="prosegin-card p-3 p-md-4 mb-3">
        <div class="prosegin-section-label mb-3">Filtros de vencimiento</div>
        <form asp-action="FacturasPorVencer" method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-3">
                <label class="form-label-prosegin" for="filtroClienteVencer">Cliente</label>
                <select id="filtroClienteVencer" name="clienteId" class="form-select form-select-prosegin">
                    <option value="">Todos los clientes</option>
                    @foreach (var cliente in Model.Clientes)
                    {
                        <option value="@cliente.Id" selected="@(Model.ClienteId == cliente.Id)">@cliente.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-lg-2">
                <label class="form-label-prosegin" for="filtroEstadoVencer">Estado</label>
                <select id="filtroEstadoVencer" name="estado" class="form-select form-select-prosegin">
                    <option value="POR_VENCER" selected="@(Model.Estado == "POR_VENCER")">Por vencer</option>
                    <option value="VENCIDA" selected="@(Model.Estado == "VENCIDA")">Vencida</option>
                    <option value="PAGADA" selected="@(Model.Estado == "PAGADA")">Pagada</option>
                    <option value="TODAS" selected="@(Model.Estado == "TODAS")">Todas</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label-prosegin" for="fechaDesde">Desde</label>
                <input id="fechaDesde" type="date" name="fechaDesde"
                       value="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                       class="form-control form-control-prosegin" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label-prosegin" for="fechaHasta">Hasta</label>
                <input id="fechaHasta" type="date" name="fechaHasta"
                       value="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                       class="form-control form-control-prosegin" />
            </div>
            <div class="col-12 col-md-6 col-lg-3 d-flex flex-wrap justify-content-lg-end gap-2">
                <button type="submit" class="btn-prosegin-primary">
                    <span class="material-symbols-outlined">search</span> Filtrar
                </button>
                <a asp-action="FacturasPorVencer" class="btn-prosegin-secondary">
                    <span class="material-symbols-outlined">restart_alt</span> Limpiar
                </a>
            </div>
        </form>
    </div>

    @if (esErrorValidacion)
    {
        <div class="prosegin-alert prosegin-alert-warning mb-3" role="alert">
            <span class="material-symbols-outlined">warning</span>
            <span>@Model.Mensaje</span>
        </div>
    }
    else if (Model.Facturas.Count == 0)
    {
        <div class="prosegin-card">
            <div class="prosegin-empty-state">
                <span class="material-symbols-outlined empty-icon d-block">event_available</span>
                <div class="empty-title">Sin facturas para mostrar</div>
                <div class="empty-desc">@(Model.Mensaje ?? "No hay facturas próximas a vencer.")</div>
            </div>
        </div>
    }
    else
    {
        <div class="prosegin-card overflow-hidden">
            <div class="prosegin-results-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="results-title">Listado de Vencimientos</span>
                    <span class="count-pill">@Model.TotalRegistros registros</span>
                </div>
                <span class="results-note">Ordenado por fecha de vencimiento más próxima</span>
            </div>

            <div class="table-responsive">
                <table class="prosegin-table mb-0">
                    <thead>
                        <tr>
                            <th>FACTURA</th>
                            <th>CLIENTE</th>
                            <th>VENCIMIENTO</th>
                            <th>PLAZO RESTANTE</th>
                            <th>SALDO PENDIENTE</th>
                            <th>ESTADO</th>
                            <th class="text-end">ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var factura in Model.Facturas)
                        {
                            var esPagada = string.Equals(factura.EstadoPago, "Pagada", StringComparison.OrdinalIgnoreCase);
                            var esVencida = string.Equals(factura.EstadoPago, "Vencida", StringComparison.OrdinalIgnoreCase);
                            var badgeClass = esPagada
                                ? "badge-status-success"
                                : esVencida ? "badge-status-danger" : "badge-status-warning";
                            var textoDias = esPagada
                                ? "Cancelada"
                                : factura.DiasHastaVencimiento < 0
                                    ? $"Vencida ({Math.Abs(factura.DiasHastaVencimiento)} días)"
                                    : factura.DiasHastaVencimiento == 0
                                        ? "Vence hoy"
                                        : $"En {factura.DiasHastaVencimiento} días";

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="row-icon-avatar">
                                            <span class="material-symbols-outlined">receipt_long</span>
                                        </div>
                                        <span class="fw-bold text-dark">@factura.NumeroFactura</span>
                                    </div>
                                </td>
                                <td class="fw-semibold text-dark">@factura.Cliente</td>
                                <td class="text-nowrap">@factura.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap @(esVencida ? "text-danger fw-semibold" : "text-muted")">@textoDias</td>
                                <td class="text-nowrap fw-bold text-dark">@factura.SaldoPendiente.ToString("C", culturaPe)</td>
                                <td>
                                    <span class="badge-status @badgeClass">
                                        <span class="status-dot"></span> @factura.EstadoPago
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="DescargarFactura"
                                       asp-route-id="@factura.Id"
                                       asp-route-clienteId="@Model.ClienteId"
                                       asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                                       asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                                       asp-route-estado="@Model.Estado"
                                       asp-route-pagina="@Model.Pagina"
                                       class="btn-prosegin-action-secondary finanzas-action-icon"
                                       title="@(factura.PdfDisponible ? "Descargar comprobante PDF" : "Comprobante PDF no disponible")"
                                       aria-label="Descargar factura @factura.NumeroFactura">
                                        <span class="material-symbols-outlined">download</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="prosegin-table-footer">
                <span>Mostrando @Model.Facturas.Count de @Model.TotalRegistros facturas</span>

                @if (Model.TotalPaginas > 1)
                {
                    <nav aria-label="Paginación de facturas por vencer">
                        <ul class="finanzas-pagination">
                            @for (var i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="FacturasPorVencer"
                                       asp-route-clienteId="@Model.ClienteId"
                                       asp-route-fechaDesde="@Model.FechaDesde?.ToString("yyyy-MM-dd")"
                                       asp-route-fechaHasta="@Model.FechaHasta?.ToString("yyyy-MM-dd")"
                                       asp-route-estado="@Model.Estado"
                                       asp-route-pagina="@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>
