<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROSEGIN</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prosegin.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar simple y elegante PROSEGIN -->
    <header>
        <nav class="navbar navbar-dark prosegin-navbar">
            <div class="container d-flex justify-content-between align-items-center">
                <a class="navbar-brand d-flex align-items-center gap-3 m-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-box">
                        <i class="bi bi-shield-shaded"></i>
                    </div>
                    <div>
                        <span class="brand-title">PROSEGIN</span>
                        <span class="brand-subtitle">EQUIPOS DE PROTECCIÓN PERSONAL</span>
                    </div>
                </a>

                <div class="status-indicator d-flex align-items-center gap-2">
                    <span class="pulse-dot"></span>
                    <span class="status-text">Entorno Listo</span>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="d-flex align-items-center justify-content-center py-5">
        @RenderBody()
    </main>

    <!-- Footer Corporativo Mínimo -->
    <footer class="prosegin-footer py-3 text-center">
        <div class="container">
            <span class="text-muted small">
                © 2026 <strong>PROSEGIN S.A.C.</strong> • C.C. Boulevard Ferretero, Las Malvinas (Lima, Perú)
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
