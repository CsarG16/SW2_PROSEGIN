<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROSEGIN</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Icons (local) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    
    <!-- Custom Site Styles (Design System) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prosegin.Web.styles.css" asp-append-version="true" />
</head>
<body>
<div class="prosegin-app-container">
    <!-- Backdrop móvil -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Sidebar Navegación Lateral -->
    <aside class="prosegin-sidebar" id="proseginSidebar">
        <!-- Logo / Marca -->
        <div class="sidebar-brand">
            <a asp-controller="Home" asp-action="Index" class="brand-link">
                <img src="~/logo_horizontal.png" alt="PROSEGIN - Prevención Integral" class="sidebar-brand-logo" />
            </a>
            <button type="button" class="sidebar-toggle-btn" id="btnSidebarClose" aria-label="Colapsar menú" title="Colapsar menú">
                <i class="bi bi-chevron-double-left"></i>
            </button>
        </div>

        <!-- Menú de Operaciones -->
        <div class="sidebar-menu-wrapper">
            <div class="menu-section-header">
                <span class="menu-section-title">OPERACIONES EPP</span>
                <span class="menu-section-dot"></span>
            </div>
            <ul class="sidebar-nav">
                <!-- Módulo 1: Catálogo y Precios -->
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalogo" && (ViewContext.RouteData.Values["action"]?.ToString() == "Index" || string.IsNullOrEmpty(ViewContext.RouteData.Values["action"]?.ToString())) ? "active" : "")" asp-controller="Catalogo" asp-action="Index">
                        <i class="bi bi-grid"></i>
                        <span>Catálogo de EPP</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalogo" && ViewContext.RouteData.Values["action"]?.ToString() == "RegistroProductos" ? "active" : "")" asp-controller="Catalogo" asp-action="RegistroProductos">
                        <i class="bi bi-tag"></i>
                        <span>Edición de Precios</span>
                    </a>
                </li>

                <!-- Separador sutil de módulo -->
                <li class="sidebar-nav-divider"></li>

                <!-- Módulo 2: Gestión de Clientes -->
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" && (ViewContext.RouteData.Values["action"]?.ToString() == "Index" || ViewContext.RouteData.Values["action"]?.ToString() == "Direcciones") ? "active" : "")" asp-controller="Clientes" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Búsqueda de Clientes</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-controller="Clientes" asp-action="Create">
                        <i class="bi bi-person-plus"></i>
                        <span>Registrar Cliente</span>
                    </a>
                </li>

                <!-- Separador sutil de módulo -->
                <li class="sidebar-nav-divider"></li>

                <!-- Módulo 3: Ventas y Pedidos -->
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cotizaciones" ? "active" : "")" asp-controller="Cotizaciones" asp-action="Create">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Cotizaciones</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link" href="#" title="En desarrollo">
                        <i class="bi bi-truck"></i>
                        <span>Gestión de Pedidos</span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Footer del Sidebar: Usuario -->
        <div class="sidebar-footer">
            <div class="user-profile-card">
                <div class="user-avatar-sq">
                    <span>CM</span>
                </div>
                <div class="user-profile-text">
                    <div class="user-name">Carlos M.</div>
                    <div class="user-role">Asesor Comercial</div>
                </div>
                <button type="button" class="btn-logout" title="Cerrar Sesión">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </div>
        </div>
    </aside>

    <!-- Área de Contenido Principal -->
    <div class="prosegin-main-wrapper">
        <!-- Topbar limpia -->
        <header class="prosegin-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-sm btn-outline-secondary d-lg-none" id="btnSidebarToggle">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="topbar-breadcrumbs">
                    <a asp-controller="Home" asp-action="Index" class="crumb-root">Operaciones EPP</a>
                    <i class="bi bi-chevron-right crumb-sep"></i>
                    <span class="crumb-current">@ViewData["Title"]</span>
                </div>
            </div>
        </header>

        <!-- Cuerpo de Vista -->
        <main role="main" class="prosegin-content-body">
            @RenderBody()
        </main>
    </div>
</div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/prosegin-alerts.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["ModalWarning"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                ProseginAlert.warning(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ModalWarning"]?.ToString() ?? string.Empty)));
            });
        </script>
    }
    @if (TempData["ModalError"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                ProseginAlert.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ModalError"]?.ToString() ?? string.Empty)));
            });
        </script>
    }
    @if (TempData["ModalSuccess"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                ProseginAlert.success(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ModalSuccess"]?.ToString() ?? string.Empty)));
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
