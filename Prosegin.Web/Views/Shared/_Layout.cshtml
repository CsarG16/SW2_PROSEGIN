<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROSEGIN</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/favicon.png" asp-append-version="true" />
    
    <!-- Google Fonts: Plus Jakarta Sans & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    
    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Custom Site Styles (Design System) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/prosegin-toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prosegin.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        (function () {
            try {
                if (localStorage.getItem('prosegin_sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
                    document.documentElement.classList.add('sidebar-is-collapsed-init');
                }
            } catch (e) {}
        })();
    </script>
</head>
<body>
<div class="prosegin-app-container">
    <!-- Backdrop móvil -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Sidebar Navegación Lateral -->
    <aside class="prosegin-sidebar" id="proseginSidebar">
        <!-- Logo / Marca -->
        <div class="sidebar-brand">
            <a asp-controller="Home" asp-action="Index" class="brand-link" title="PROSEGIN - Inicio">
                <img src="~/logo_horizontal.png" alt="PROSEGIN - Prevención Integral" class="sidebar-brand-logo" />
                <div class="sidebar-brand-mini" title="PROSEGIN - Prevención Integral">
                    <span class="brand-mini-letter">P</span>
                </div>
            </a>
        </div>

        <!-- Menú de Operaciones -->
        <div class="sidebar-menu-wrapper">
            <div class="menu-section-header">
                <span class="menu-section-title">OPERACIONES EPP</span>
                <span class="menu-section-dot"></span>
            </div>
            <ul class="sidebar-nav">
                <!-- Módulo 1: Catálogo y Precios -->
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalogo" && (ViewContext.RouteData.Values["action"]?.ToString() == "Index" || string.IsNullOrEmpty(ViewContext.RouteData.Values["action"]?.ToString())) ? "active" : "")" asp-controller="Catalogo" asp-action="Index">
                        <i class="material-symbols-outlined">grid_view</i>
                        <span class="sidebar-nav-text">Catálogo de EPP</span>
                        <span class="sidebar-floating-tag">Catálogo de EPP</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalogo" && ViewContext.RouteData.Values["action"]?.ToString() == "RegistroProductos" ? "active" : "")" asp-controller="Catalogo" asp-action="RegistroProductos">
                        <i class="material-symbols-outlined">add_circle</i>
                        <span class="sidebar-nav-text">Registrar EPP</span>
                        <span class="sidebar-floating-tag">Registrar EPP</span>
                    </a>
                </li>

                <!-- Separador sutil de módulo -->
                <li class="sidebar-nav-divider"></li>

                <!-- Módulo 2: Gestión de Clientes -->
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" && (ViewContext.RouteData.Values["action"]?.ToString() == "Index" || ViewContext.RouteData.Values["action"]?.ToString() == "Direcciones") ? "active" : "")" asp-controller="Clientes" asp-action="Index">
                        <i class="material-symbols-outlined">group</i>
                        <span class="sidebar-nav-text">Clientes</span>
                        <span class="sidebar-floating-tag">Clientes</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-controller="Clientes" asp-action="Create">
                        <i class="material-symbols-outlined">person_add</i>
                        <span class="sidebar-nav-text">Registrar Cliente</span>
                        <span class="sidebar-floating-tag">Registrar Cliente</span>
                    </a>
                </li>

                <!-- Separador sutil de módulo -->
                <li class="sidebar-nav-divider"></li>

                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedores" ? "active" : "")" asp-controller="Proveedores" asp-action="Index">
                        <i class="material-symbols-outlined">local_shipping</i>
                        <span class="sidebar-nav-text">Proveedores</span>
                        <span class="sidebar-floating-tag">Proveedores</span>
                    </a>
                </li>

                <li class="sidebar-nav-divider"></li>

                <!-- Módulo 3: Cotizaciones -->
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cotizaciones" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Cotizaciones" asp-action="Index">
                        <i class="material-symbols-outlined">description</i>
                        <span class="sidebar-nav-text">Cotizaciones</span>
                        <span class="sidebar-floating-tag">Cotizaciones</span>
                    </a>
                </li>

                <!-- Separador sutil de módulo -->
                <li class="sidebar-nav-divider"></li>

                <!-- Módulo 4: Pedidos y Logística -->
                <li class="sidebar-nav-item">
                    <a class="sidebar-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pedidos" ? "active" : "")" asp-controller="Pedidos" asp-action="Index">
                        <i class="material-symbols-outlined">local_shipping</i>
                        <span class="sidebar-nav-text">Gestión de Pedidos</span>
                        <span class="sidebar-floating-tag">Gestión de Pedidos</span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>

    <!-- Área de Contenido Principal -->
    <div class="prosegin-main-wrapper">
        <!-- Topbar limpia con botón de colapso accesible -->
        <header class="prosegin-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="topbar-toggle-btn" id="btnSidebarToggle" aria-label="Alternar menú lateral" title="Alternar menú lateral">
                    <i class="material-symbols-outlined">menu_open</i>
                </button>
                <div class="topbar-breadcrumbs">
                    <a asp-controller="Home" asp-action="Index" class="crumb-root">Operaciones EPP</a>
                    <i class="material-symbols-outlined crumb-sep">chevron_right</i>
                    <span class="crumb-current">@ViewData["Title"]</span>
                </div>
            </div>
        </header>

        <!-- Cuerpo de Vista -->
        <main role="main" class="prosegin-content-body">
            @RenderBody()
        </main>
    </div>
</div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/prosegin-alerts.js" asp-append-version="true"></script>
    <script src="~/js/prosegin-toast.js" asp-append-version="true"></script>
    <script src="~/js/prosegin-pdf-viewer.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <partial name="_Notifications" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
