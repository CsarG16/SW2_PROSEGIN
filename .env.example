# ============================================================
# PLANTILLA DE CONFIGURACIÓN - PROSEGIN
# ============================================================
# Instrucciones para el equipo:
# 1. Haz una copia de este archivo y nómbralo exactamente '.env' en la raíz.
# 2. Configura tus credenciales locales de MySQL.
# 3. Para probar el envío de correos, configura las credenciales SMTP de tu propia
#    bandeja de Mailtrap en la sección SMTP.
# 4. Nunca publiques contraseñas reales ni credenciales SMTP personales.
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=prosegin_db
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui

# Mailtrap - Credenciales SMTP de pruebas
# Obtén estos valores desde tu bandeja: Email Testing > Inboxes > SMTP Settings.
# No uses el API token del ejemplo de integración API.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp_de_mailtrap
SMTP_PASSWORD=tu_contraseña_smtp_de_mailtrap
SMTP_FROM=ordenes@prosegin.test
SMTP_SSL=true
